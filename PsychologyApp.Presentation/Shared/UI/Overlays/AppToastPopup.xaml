<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
               x:Class="PsychologyApp.Presentation.Shared.UI.Overlays.AppToastPopup"
               BackgroundColor="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="False">

    <Grid
        x:Name="ToastHost"
        RowDefinitions="*,Auto"
        VerticalOptions="Fill"
        HorizontalOptions="Fill">
        <Grid
            x:Name="ToastCardHost"
            Grid.Row="1"
            Margin="20,0,20,56"
            HorizontalOptions="Fill"
            MaximumWidthRequest="400">
            <Border Style="{StaticResource AppPopupShadowLayerStyle}" />
            <Border
                x:Name="ToastCard"
                Style="{StaticResource AppToastPopupCardStyle}"
                HorizontalOptions="Fill">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border
                        x:Name="AccentBar"
                        Grid.Column="0"
                        Style="{StaticResource HeroAccentBarStyle}" />
                    <Grid
                        Grid.Column="1"
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="8"
                        VerticalOptions="Center">
                        <ui:MaterialIconView
                            x:Name="ToastIcon"
                            Grid.Column="0"
                            IconSize="{StaticResource MetaIconFontSize}"
                            VerticalOptions="Center" />
                        <Label
                            x:Name="MessageLabel"
                            Grid.Column="1"
                            Style="{StaticResource AppToastMessageStyle}"
                            VerticalOptions="Center"
                            HorizontalOptions="Fill" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</toolkit:Popup>
