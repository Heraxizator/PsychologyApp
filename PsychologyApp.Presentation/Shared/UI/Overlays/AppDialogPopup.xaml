<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="PsychologyApp.Presentation.Shared.UI.Overlays.AppDialogPopup"
               x:Name="Root"
               BackgroundColor="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="True">

    <Grid
        x:Name="DialogCardHost"
        Margin="32"
        VerticalOptions="Center"
        HorizontalOptions="Center">
        <Border Style="{StaticResource AppDialogShadowLayerStyle}" />
        <Border
            x:Name="DialogCard"
            Style="{StaticResource AppDialogPopupCardStyle}"
            VerticalOptions="Center"
            HorizontalOptions="Center">
            <VerticalStackLayout Spacing="0">
                <VerticalStackLayout
                    Padding="20,20,20,16"
                    Spacing="8">
                    <Label
                        x:Name="TitleLabel"
                        Style="{StaticResource AppDialogTitleStyle}" />
                    <Label
                        x:Name="MessageLabel"
                        Style="{StaticResource AppDialogMessageStyle}" />
                </VerticalStackLayout>

                <BoxView Style="{StaticResource AppDialogDividerStyle}" />

                <Grid
                    x:Name="ButtonRow"
                    ColumnDefinitions="*,Auto,*"
                    MinimumHeightRequest="44">
                    <Border
                        x:Name="CancelTapArea"
                        Grid.Column="0"
                        BackgroundColor="Transparent"
                        Stroke="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelTapped" />
                        </Border.GestureRecognizers>
                        <Label
                            x:Name="CancelLabel"
                            Style="{StaticResource AppDialogActionLabelStyle}"
                            InputTransparent="True" />
                    </Border>

                    <BoxView
                        x:Name="ActionDivider"
                        Grid.Column="1"
                        Style="{StaticResource AppDialogActionDividerStyle}" />

                    <Border
                        x:Name="AcceptTapArea"
                        Grid.Column="2"
                        BackgroundColor="Transparent"
                        Stroke="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAcceptTapped" />
                        </Border.GestureRecognizers>
                        <Label
                            x:Name="AcceptLabel"
                            Style="{StaticResource AppDialogPrimaryActionLabelStyle}"
                            InputTransparent="True" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>

</toolkit:Popup>
