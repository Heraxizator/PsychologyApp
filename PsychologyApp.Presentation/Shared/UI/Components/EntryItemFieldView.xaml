<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:self="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             x:DataType="self:EntryItemFieldView"
             x:Class="PsychologyApp.Presentation.Shared.UI.Components.EntryItemFieldView"
             x:Name="Root">

    <Grid>
        <ui:TechniqueTextFieldView
            IsVisible="{Binding IsTextField, Source={x:Reference Root}}"
            TitleText="{Binding Entry.Title, Source={x:Reference Root}}"
            Text="{Binding Entry.Text, Source={x:Reference Root}, Mode=TwoWay}"
            PlaceholderText="{Binding Entry.Placeholder, Source={x:Reference Root}}"
            Suggestions="{Binding Entry.Suggestions, Source={x:Reference Root}}"
            Role="{Binding Entry.Role, Source={x:Reference Root}}"
            RecentText="{Binding Entry.RecentText, Source={x:Reference Root}}"
            AssistSuggestions="{Binding Entry.AssistSuggestions, Source={x:Reference Root}}" />
        <ui:RatingEntryView
            x:Name="RatingEntry"
            IsVisible="{Binding IsRatingField, Source={x:Reference Root}}"
            TitleText="{Binding Entry.Title, Source={x:Reference Root}}"
            BodyText="{Binding Entry.Text, Source={x:Reference Root}, Mode=TwoWay}"
            Kind="{Binding Entry.Kind, Source={x:Reference Root}}"
            Embedded="{Binding Embedded, Source={x:Reference Root}}" />
    </Grid>

</ContentView>
