<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:Class="PsychologyApp.Presentation.Shared.UI.Components.YesNoSelectorView"
             x:Name="Root">

    <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
        <Label
            Text="{Binding LabelText, Source={x:Reference Root}}"
            Style="{StaticResource BodyStyle}" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource CompactSpacing}">
            <Border
                Grid.Column="0"
                Style="{StaticResource ChoiceOptionBorderStyle}"
                SemanticProperties.Description="{Binding YesText, Source={x:Reference Root}}">
                <Border.Triggers>
                    <DataTrigger
                        TargetType="Border"
                        Binding="{Binding IsYes, Source={x:Reference Root}}"
                        Value="True">
                        <Setter Property="Style" Value="{StaticResource ChoiceOptionSelectedBorderStyle}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding SelectCommand, Source={x:Reference Root}}"
                        CommandParameter="yes" />
                </Border.GestureRecognizers>
                <Border.Behaviors>
                    <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                </Border.Behaviors>
                <Label Text="{Binding YesText, Source={x:Reference Root}}" Style="{StaticResource ChoiceOptionLabelStyle}">
                    <Label.Triggers>
                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding IsYes, Source={x:Reference Root}}"
                            Value="True">
                            <Setter Property="Style" Value="{StaticResource ChoiceOptionSelectedLabelStyle}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>

            <Border
                Grid.Column="1"
                Style="{StaticResource ChoiceOptionBorderStyle}"
                SemanticProperties.Description="{Binding NoText, Source={x:Reference Root}}">
                <Border.Triggers>
                    <DataTrigger
                        TargetType="Border"
                        Binding="{Binding IsNo, Source={x:Reference Root}}"
                        Value="True">
                        <Setter Property="Style" Value="{StaticResource ChoiceOptionSelectedBorderStyle}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding SelectCommand, Source={x:Reference Root}}"
                        CommandParameter="no" />
                </Border.GestureRecognizers>
                <Border.Behaviors>
                    <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                </Border.Behaviors>
                <Label Text="{Binding NoText, Source={x:Reference Root}}" Style="{StaticResource ChoiceOptionLabelStyle}">
                    <Label.Triggers>
                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding IsNo, Source={x:Reference Root}}"
                            Value="True">
                            <Setter Property="Style" Value="{StaticResource ChoiceOptionSelectedLabelStyle}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
        </Grid>
    </VerticalStackLayout>

</ContentView>
