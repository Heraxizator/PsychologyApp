<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:Class="PsychologyApp.Presentation.Shared.UI.Components.AlgorithmBoxView">

    <ContentView.Behaviors>
        <behaviors:ListItemRevealBehavior />
    </ContentView.Behaviors>

    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Border Style="{StaticResource BrandCardStyle}">
                <StackLayout>
                    <Label
                        Text="{TemplateBinding TitleText}"
                        Style="{StaticResource SectionTitleStyle}" />
                    <StackLayout
                        Margin="0,5,0,0"
                        BindableLayout.ItemsSource="{TemplateBinding ItemsSource}"
                        BindableLayout.ItemTemplate="{TemplateBinding ItemTemplate}"
                        IsVisible="{TemplateBinding UseItemTemplate}" />
                    <StackLayout
                        Margin="0,5,0,0"
                        BindableLayout.ItemsSource="{TemplateBinding BodySource}"
                        IsVisible="{TemplateBinding UseStringItems}">
                        <StackLayout.Behaviors>
                            <behaviors:StaggerChildrenBehavior />
                        </StackLayout.Behaviors>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Label
                                    Margin="0,0,0,3"
                                    Text="{Binding .}"
                                    Style="{StaticResource BodyStyle}">
                                    <Label.Behaviors>
                                        <behaviors:ListItemRevealBehavior />
                                    </Label.Behaviors>
                                </Label>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </StackLayout>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>

</ContentView>
