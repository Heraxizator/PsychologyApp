<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:self="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             x:Class="PsychologyApp.Presentation.Shared.UI.Components.TextBoxView">

    <ContentView.Behaviors>
        <behaviors:ListItemRevealBehavior />
    </ContentView.Behaviors>

    <ContentView.ControlTemplate>
        <ControlTemplate x:DataType="self:TextBoxView">
            <Border Style="{StaticResource BrandCardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="{TemplateBinding HeaderText}"
                        Style="{StaticResource SectionTitleStyle}" />
                    <Label
                        Text="{TemplateBinding BodyText}"
                        Style="{StaticResource BodyStyle}" />
                </VerticalStackLayout>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>

</ContentView>
