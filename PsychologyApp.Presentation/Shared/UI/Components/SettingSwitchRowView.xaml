<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Shared.UI.Components.SettingSwitchRowView"
             x:Name="Root">

    <VerticalStackLayout Spacing="0">
        <Grid
            MinimumHeightRequest="52"
            Padding="0,4"
            Opacity="{Binding RowOpacity, Source={x:Reference Root}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label
                Grid.Column="0"
                Text="{Binding LabelText, Source={x:Reference Root}}"
                Style="{StaticResource BodyStyle}"
                VerticalOptions="Center" />
            <Switch
                Grid.Column="1"
                OnColor="{DynamicResource Primary}"
                ThumbColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray100}}"
                IsEnabled="{Binding IsRowEnabled, Source={x:Reference Root}}"
                IsToggled="{Binding IsToggled, Source={x:Reference Root}, Mode=TwoWay}" />
        </Grid>
        <BoxView
            Style="{StaticResource SettingRowDividerStyle}"
            IsVisible="{Binding ShowDivider, Source={x:Reference Root}}" />
    </VerticalStackLayout>

</ContentView>
