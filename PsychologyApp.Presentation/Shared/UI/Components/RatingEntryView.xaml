<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:self="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             x:DataType="self:RatingEntryView"
             x:Class="PsychologyApp.Presentation.Shared.UI.Components.RatingEntryView"
             x:Name="Root"
             HorizontalOptions="Fill">
    <Border x:Name="FrameBorder" Style="{StaticResource InputBorderStyle}">
        <VerticalStackLayout Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label
                    Grid.Column="0"
                    Text="{Binding TitleText, Source={x:Reference Root}}"
                    x:Name="TitleLabel"
                    Style="{StaticResource FieldLabelStyle}"
                    Margin="0"
                    VerticalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger
                            Binding="{Binding TitleText, Source={x:Reference Root}}"
                            TargetType="Label"
                            Value="">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <!-- The answer as a large number in the colour of the scale: readable at a glance, it grows a little under the finger. -->
                <Label
                    x:Name="NumberLabel"
                    Grid.Column="1"
                    Text="{Binding NumberText, Source={x:Reference Root}}"
                    FontSize="34"
                    FontFamily="{StaticResource MediumFontFamily}"
                    TextColor="{Binding AccentColor, Source={x:Reference Root}}"
                    VerticalOptions="Center"
                    MinimumWidthRequest="44"
                    HorizontalTextAlignment="End"
                    SemanticProperties.Description="{Binding ValueDisplay, Source={x:Reference Root}}">
                    <Label.Triggers>
                        <DataTrigger
                            Binding="{Binding HasValue, Source={x:Reference Root}}"
                            TargetType="Label"
                            Value="False">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>
            <Slider
                x:Name="RatingSlider"
                Margin="0,-2,0,0"
                Minimum="{Binding Minimum, Source={x:Reference Root}}"
                Maximum="{Binding Maximum, Source={x:Reference Root}}"
                Value="{Binding SliderValue, Source={x:Reference Root}, Mode=TwoWay}"
                MinimumTrackColor="{Binding AccentColor, Source={x:Reference Root}}"
                ThumbColor="{Binding AccentColor, Source={x:Reference Root}}"
                ValueChanged="OnSliderValueChanged" />
            <!-- The bottom padding keeps the descenders of the captions ("strong") from being cut by the row. -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label
                    Grid.Column="0"
                    Text="{Binding MinimumCaption, Source={x:Reference Root}}"
                    Padding="0,0,0,2"
                    Style="{StaticResource CaptionStyle}" />
                <Label
                    Grid.Column="2"
                    Text="{Binding MaximumCaption, Source={x:Reference Root}}"
                    Padding="0,0,0,2"
                    Style="{StaticResource CaptionStyle}" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
