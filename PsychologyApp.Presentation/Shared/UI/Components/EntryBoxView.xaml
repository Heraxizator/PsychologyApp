<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:core="clr-namespace:PsychologyApp.Presentation.UI.Components;assembly=PsychologyApp.Presentation.Core"
             x:Class="PsychologyApp.Presentation.Shared.UI.Components.EntryBoxView"
             x:Name="Root">
    <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">
        <Label
            Text="{Binding TitleText, Source={x:Reference Root}}"
            Style="{StaticResource SectionTitleStyle}" />

        <VerticalStackLayout
            Spacing="{StaticResource LayoutSpacing}"
            BindableLayout.ItemsSource="{Binding BodySource, Source={x:Reference Root}}">
            <VerticalStackLayout.Behaviors>
                <behaviors:StaggerChildrenBehavior />
            </VerticalStackLayout.Behaviors>
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="core:EntryItem">
                    <ui:EntryItemFieldView Entry="{Binding .}">
                        <ui:EntryItemFieldView.Behaviors>
                            <behaviors:ListItemRevealBehavior />
                        </ui:EntryItemFieldView.Behaviors>
                    </ui:EntryItemFieldView>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
