<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-maccatalyst;net10.0-ios;net10.0-android</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>PsychologyApp.Presentation</RootNamespace>
		<UseMaui>true</UseMaui>
		<UseMaterial3 Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</UseMaterial3>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!-- Compile bindings that set Source ({x:Reference Root}, TemplatedParent) too; they're most of the app's bindings. -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<!-- Generate C# for XAML in every configuration. The .NET 10 default inflates XAML by reflection at runtime in
		     Debug, which made every first page/tab open stall the UI thread for seconds (skipped frames on device). -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<!-- ViewModels are DI-only; nullable init warnings are false positives in partial MAUI types. -->
		<NoWarn>$(NoWarn);XA4304;CA1416;CS0618</NoWarn>

		<!-- Display name -->
		<ApplicationTitle>Psychology App</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.subconscious.psychologyapp</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>2.005</ApplicationDisplayVersion>
		<ApplicationVersion>2005</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
		<PublishTrimmed>False</PublishTrimmed>
	
		<RuntimeIdentifiers Condition="$(TargetFramework.Contains('-android'))">android-arm;android-arm64;android-x64</RuntimeIdentifiers>
	
	</PropertyGroup>

	<!-- A 16 MB nursery (SGen default 4 MB) means ~4x fewer minor collections, each of which also forces a Java GC
	     through the GC bridge: the log showed one about every second while moving between tabs. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
	  <AndroidEnvironment Include="Platforms/Android/environment.txt" />
	</ItemGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(Configuration)' == 'Debug'">
	  <AndroidUseAapt2>True</AndroidUseAapt2>
	  <IsPublishable>False</IsPublishable>
	  <Debugger>Xamarin</Debugger>
	  <DebugSymbols>true</DebugSymbols>
	  <DebugType>portable</DebugType>
	  <AndroidIncludeDebugSymbols>true</AndroidIncludeDebugSymbols>
	  <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	  <PublishTrimmed>False</PublishTrimmed>
	  <AndroidEnableMultiDex>True</AndroidEnableMultiDex>
	  <RunAOTCompilation>False</RunAOTCompilation>
	  <!-- Disable fast deployment: avoids XA0129 push failures to .__override__ on device. -->
	  <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	  <!-- Debug: arm64 for physical devices + x64 for Windows emulator; avoids all 4 ABIs (XAWAS7024). -->
	  <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
	  <!-- The SDK interprets all managed code in Debug (for C# Hot Reload), several times slower than JIT and a
	       large share of the skipped frames seen in Debug runs. JIT keeps breakpoints and stepping. -->
	  <UseInterpreter>false</UseInterpreter>
	</PropertyGroup>

	<!-- Release Android: single source of truth for build, run, and publish (no duplicate TFM|Platform overrides). -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(Configuration)' == 'Release'">
	  <AndroidUseAapt2>True</AndroidUseAapt2>
	  <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
	  <AndroidEnableMultiDex>True</AndroidEnableMultiDex>
	  <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	  <!-- Play Console: aab. Sideload on phone: -p:AndroidPackageFormat=apk -p:RuntimeIdentifier=android-arm64 -->
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	  <!-- Partial trimming: only framework assemblies that declare themselves trimmable are cut (Mono.Android alone is
	       ~40 MB untrimmed); the app, Dapper and the libraries rooted below are kept whole. -->
	  <PublishTrimmed>True</PublishTrimmed>
	  <TrimMode>partial</TrimMode>
	  <!-- AOT: code ships precompiled instead of being JIT-compiled on the phone (the first-open cost of each tab was 0.4-0.9 s).
	       NOT profiled AOT: with AndroidEnableProfiledAot the Release build aborted at random on the .NET Timer / .NET TP Gate threads
	       ("aot-runtime.c: condition `plt_entry' not met", SIGABRT) a few seconds to a minute after opening Prayers or Quotes, on a
	       Samsung A25 (Android 14). The same build without the profile ran for minutes under load without a crash. The price is a
	       larger package (about 9 MB). Re-test on a device for several minutes before turning the profile back on. -->
	  <RunAOTCompilation>True</RunAOTCompilation>
	  <AndroidEnableProfiledAot>False</AndroidEnableProfiledAot>
	  <!-- LLVM can cause native startup crashes on some devices; re-enable after device QA. -->
	  <EnableLLVM>False</EnableLLVM>
	  <DebugSymbols>False</DebugSymbols>
	  <AndroidIncludeDebugSymbols>False</AndroidIncludeDebugSymbols>
	  <!-- SdkOnly: Mono linker trims SDK assemblies; R8 + ProguardConfiguration shrink dex. Full breaks AndroidX (PickVisualMedia). -->
	  <AndroidLinkTool>r8</AndroidLinkTool>
	  <AndroidLinkMode>SdkOnly</AndroidLinkMode>
	  <!-- Phones only; build an emulator package with -p:RuntimeIdentifiers=android-x64. -->
	  <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
	  <!-- Release signing: paths/passwords in AndroidSigning.local.props (gitignored) or env vars. -->
	  <AndroidKeyStore Condition="'$(AndroidSigningKeyStore)' != ''">true</AndroidKeyStore>
	  <AndroidSigningKeyStore Condition="'$(AndroidSigningKeyStore)' != ''">$(AndroidSigningKeyStore)</AndroidSigningKeyStore>
	  <AndroidSigningKeyAlias Condition="'$(AndroidSigningKeyAlias)' != ''">$(AndroidSigningKeyAlias)</AndroidSigningKeyAlias>
	  <AndroidSigningStorePass Condition="'$(AndroidSigningStorePass)' != ''">$(AndroidSigningStorePass)</AndroidSigningStorePass>
	  <AndroidSigningKeyPass Condition="'$(AndroidSigningKeyPass)' != ''">$(AndroidSigningKeyPass)</AndroidSigningKeyPass>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-maccatalyst|AnyCPU'">
	  <IsPublishable>False</IsPublishable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-ios|AnyCPU'">
	  <IsPublishable>False</IsPublishable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-windows10.0.19041.0|AnyCPU'">
	  <IsPublishable>False</IsPublishable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-maccatalyst|AnyCPU'">
	  <IsPublishable>False</IsPublishable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-ios|AnyCPU'">
	  <IsPublishable>False</IsPublishable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-windows10.0.19041.0|AnyCPU'">
	  <IsPublishable>False</IsPublishable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
	  <EnableLLVM>True</EnableLLVM>
	  <TrimMode>link</TrimMode>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
	  <TrimMode>link</TrimMode>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<ProguardConfiguration Include="Platforms\Android\proguard-rules.pro" />
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\logo.jpeg" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\AppIcon\logo.jpeg" Color="#FFFFFF" BaseSize="512,512" />

		<!-- Images -->
		<MauiImage Include="Resources\AppIcon\logo.jpeg" Link="Resources\Images\onboarding_app_logo.jpeg" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="Renderers\**" />
	  <EmbeddedResource Remove="Renderers\**" />
	  <MauiCss Remove="Renderers\**" />
	  <MauiXaml Remove="Renderers\**" />
	  <None Remove="Renderers\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Resources\Raw\Psyhosomatic.txt" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AathifMahir.Maui.MauiIcons.Material" Version="5.0.0" />
		<PackageReference Include="CommunityToolkit.Maui" Version="14.0.0" />
		<!-- Android plays music with the platform MediaPlayer (Platforms/Android/AndroidAudioPlaybackService.cs);
		     MediaElement and its ExoPlayer are only shipped to iOS and Mac. -->
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="9.0.0" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.41" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.3" />
		<PackageReference Include="Refractored.MvvmHelpers" Version="1.6.2" />

		<TrimmerRootAssembly Include="Microsoft.Maui" RootMode="All" />
		<TrimmerRootAssembly Include="Microsoft.Maui.Controls" RootMode="All" />
		<TrimmerRootAssembly Include="Microsoft.Maui.Controls.Xaml" RootMode="All" />
		<TrimmerRootAssembly Include="Microsoft.Maui.Graphics" RootMode="All" />
		<TrimmerRootAssembly Include="Microsoft.Maui.Essentials" RootMode="All" />
		<TrimmerRootAssembly Include="CommunityToolkit.Maui" RootMode="All" />
		<TrimmerRootAssembly Include="CommunityToolkit.Maui.Core" RootMode="All" />
		<TrimmerRootAssembly Include="CommunityToolkit.Maui.MediaElement" RootMode="All" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'" />
		<TrimmerRootAssembly Include="MauiIcons.Core" RootMode="All" />
		<TrimmerRootAssembly Include="MauiIcons.Material" RootMode="All" />
		<TrimmerRootAssembly Include="MvvmHelpers" RootMode="All" />
		<TrimmerRootAssembly Include="Dapper" RootMode="All" />
		<TrimmerRootAssembly Include="Microsoft.Data.Sqlite" RootMode="All" />
		<TrimmerRootAssembly Include="System.Text.Json" RootMode="All" />
		<TrimmerRootAssembly Include="PsychologyApp.Presentation" RootMode="All" />
		<TrimmerRootAssembly Include="PsychologyApp.Presentation.Core" RootMode="All" />
		<TrimmerRootAssembly Include="PsychologyApp.Bootstrap" RootMode="All" />
		<TrimmerRootAssembly Include="PsychologyApp.Application" RootMode="All" />
		<TrimmerRootAssembly Include="PsychologyApp.Infrastructure" RootMode="All" />
		<TrimmerRootAssembly Include="PsychologyApp.Domain" RootMode="All" />
	
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\PsychologyApp.Application\PsychologyApp.Application.csproj" />
	  <ProjectReference Include="..\PsychologyApp.Bootstrap\PsychologyApp.Bootstrap.csproj" />
	  <ProjectReference Include="..\PsychologyApp.Presentation.Core\PsychologyApp.Presentation.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <InternalsVisibleTo Include="PsychologyApp.Presentation.Tests" />
	</ItemGroup>

	<Import Project="AndroidSigning.local.props" Condition="Exists('AndroidSigning.local.props')" />

</Project>
