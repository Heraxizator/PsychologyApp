<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.RunTests.TestHistory.TestHistoryPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:testUi="clr-namespace:PsychologyApp.Presentation.Widgets.Test"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.RunTests.TestHistory"
             xmlns:models="clr-namespace:PsychologyApp.Presentation.Entities.Test"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:DataType="vm:TestHistoryViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <ContentPage.Behaviors>
        <behaviors:PageAnalyticsBehavior TestId="{Binding TestFlowId}" />
    </ContentPage.Behaviors>

    <Grid Padding="{StaticResource LayoutPageMarginThickness}" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource LayoutSpacing}">
        <ui:NavigationBarSimpleView
            Grid.Row="0"
            TitleText="{Binding PageTitle}"
            BackCommand="{Binding Finish}" />

        <!-- Virtualised: up to 50 heavy result rows are only built as they scroll into view. -->
        <CollectionView
            x:Name="HistoryContent"
            Grid.Row="1"
            IsVisible="{Binding IsDone}"
            ItemsSource="{Binding HistoryEntries}"
            SelectionMode="None"
            VerticalScrollBarVisibility="Default">
            <CollectionView.Header>
                <testUi:TestScoreTrendChartView
                    Margin="0,0,0,20"
                    IsVisible="{Binding HasChart}"
                    ChartPoints="{Binding ChartPoints}"
                    DomainMin="{Binding ChartDomainMin}"
                    DomainMax="{Binding ChartDomainMax}"
                    Subtitle="{Binding ChartSubtitle}" />
            </CollectionView.Header>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource ListItemSpacing}" />
            </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TestHistoryEntryItem">
                            <testUi:TestHistoryEntryView
                                DateText="{Binding DateText}"
                                SummaryText="{Binding SummaryText}"
                                ScoreText="{Binding ScoreText}"
                                TrendText="{Binding TrendText}"
                                DurationText="{Binding DurationText}"
                                HasScore="{Binding HasScore}"
                                HasTrend="{Binding HasTrend}"
                                HasDetail="{Binding HasDetail}"
                                HasLuscherDetail="{Binding HasLuscherDetail}"
                                HasStandardLuscherDetail="{Binding HasStandardLuscherDetail}"
                                HasBriefLuscherDetail="{Binding HasBriefLuscherDetail}"
                                IsWorse="{Binding IsWorse}"
                                DetailQuestions="{Binding DetailQuestions}"
                                LuscherFirstPassTitle="{Binding LuscherFirstPassTitle}"
                                LuscherSecondPassTitle="{Binding LuscherSecondPassTitle}"
                                LuscherBkText="{Binding LuscherBkText}"
                                LuscherStandardDetail="{Binding LuscherStandardDetail}"
                                LuscherBriefDetail="{Binding LuscherBriefDetail}"
                                LuscherBriefFirstRoleLabel="{Binding LuscherBriefFirstRoleLabel}"
                                LuscherBriefSecondRoleLabel="{Binding LuscherBriefSecondRoleLabel}">
                                <testUi:TestHistoryEntryView.Behaviors>
                                    <behaviors:ListItemRevealBehavior />
                                </testUi:TestHistoryEntryView.Behaviors>
                            </testUi:TestHistoryEntryView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <ui:EmptyStateView
                    BodyText="{Binding EmptyText}"
                    IconName="History" />
            </CollectionView.EmptyView>
        </CollectionView>

        <ui:ButtonView
            Grid.Row="2"
            IsVisible="{Binding IsDone}"
            BodyText="{Binding RetakeButtonText}"
            TapCommand="{Binding RetakeCommand}" />

        <ui:SkeletonView
            Grid.Row="1"
            Kind="Rows"
            VerticalOptions="Start"
            IsActive="{Binding IsLoadingOverlayVisible}" />

        <ui:ProgressBarView
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
            Padding="24,8"
            x:Name="LoadingProgress"
            Grid.RowSpan="3"
            VerticalOptions="End"
            HorizontalOptions="Center"
            IsVisible="{Binding IsSlowLoadingVisible}"
            IsLoading="{Binding IsSlowLoadingVisible}"
            ProgressText="{Binding LoadingText}" />

        <ui:RetryView
            Grid.RowSpan="3"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            IsVisible="{Binding IsFail}"
            FailedText="{Binding FailedText}"
            RetryText="{Binding RetryText}"
            RetryCommand="{Binding Reload}" />
    </Grid>
</ContentPage>
