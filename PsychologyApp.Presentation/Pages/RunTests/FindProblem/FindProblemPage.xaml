<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.RunTests.FindProblem.FindProblemPage"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.RunTests.FindProblem"
             xmlns:models="clr-namespace:PsychologyApp.Presentation.Entities.Test"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:testUi="clr-namespace:PsychologyApp.Presentation.Widgets.Test"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:DataType="vm:FindProblemViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <ContentPage.Behaviors>
        <behaviors:PageAnalyticsBehavior TestId="{Binding TestFlowId}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto" VerticalOptions="Fill">
        <Grid.Behaviors>
            <behaviors:StaggerChildrenBehavior />
        </Grid.Behaviors>

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="{StaticResource CompactSpacing}"
            Margin="{StaticResource LayoutPageMarginThickness}">
            <ui:NavigationBarSimpleView
                TitleText="{Binding PageTitle}"
                BackCommand="{Binding BackCommand}" />
            <testUi:TestFlowMetaStripView
                DurationText="{Binding DurationText}"
                QuestionCountText="{Binding QuestionCountText}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Margin="{StaticResource LayoutPageMarginThickness}" Spacing="{StaticResource LayoutSpacing}">
                <!-- What the test is, how to answer and what it is not, in one card: three titled boxes and a banner read as a form. -->
                <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0" Padding="18,16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding DescriptionText}" Style="{StaticResource BodyStyle}" />
                        <!-- The steps of answering, each with its number in a circle: a block of grey numbered text read as small print. -->
                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding AlgorithmRows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:AlgorithmRow">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" SemanticProperties.Description="{Binding Text}">
                                        <Border
                                            WidthRequest="26"
                                            HeightRequest="26"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 13"
                                            VerticalOptions="Start"
                                            BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}">
                                            <Label
                                                Text="{Binding Number}"
                                                FontSize="13"
                                                FontFamily="{StaticResource SemiBoldFontFamily}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding Body}" Style="{StaticResource BodyStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <ui:MaterialIconView IconName="InfoOutline" IconSize="16" VerticalOptions="Start" Margin="0,2,0,0" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label Grid.Column="1" Text="{Binding CommentText}" Style="{StaticResource CaptionStyle}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasPastResults}" Spacing="8">
                    <Label Text="{Binding PastResultsTitle}" Style="{StaticResource CaptionStyle}" Margin="4,0" />
                    <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0">
                        <VerticalStackLayout Spacing="0">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding PastResults}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:TestHistoryEntryItem">
                                        <VerticalStackLayout Spacing="2" Padding="0,8">
                                            <Label Text="{Binding SummaryText}" Style="{StaticResource BodyStyle}" FontFamily="{StaticResource MediumFontFamily}" />
                                            <Label Style="{StaticResource CaptionStyle}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding DateText}" />
                                                        <Span Text="  " />
                                                        <Span Text="{Binding ScoreText}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <BoxView Style="{StaticResource SettingRowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44" SemanticProperties.Description="{Binding OpenHistoryText}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenHistoryCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="{Binding OpenHistoryText}" Style="{StaticResource BodyStyle}" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                                <ui:MaterialIconView Grid.Column="1" IconName="ChevronRight" IconSize="18" VerticalOptions="Center"
                                                     IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <ui:ButtonView
            Grid.Row="2"
            Margin="{StaticResource LayoutPageMarginThickness}"
            BodyText="{Binding StartButtonText}"
            TapCommand="{Binding Continue}" />
    </Grid>
</ContentPage>
