<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.RunTechniqueSession.PracticeCompletion.PracticeCompletionPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:mood="clr-namespace:PsychologyApp.Presentation.Widgets.MoodStrip"
             xmlns:tension="clr-namespace:PsychologyApp.Presentation.Widgets.TensionSlider"
             xmlns:today="clr-namespace:PsychologyApp.Presentation.Widgets.TodayPracticeRow"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.RunTechniqueSession.PracticeCompletion"
             xmlns:common="clr-namespace:PsychologyApp.Presentation.Common;assembly=PsychologyApp.Presentation.Core"
             x:DataType="vm:PracticeCompletionViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto">
            <Grid.Behaviors>
                <behaviors:RevealOnAppearingBehavior />
            </Grid.Behaviors>
            <ui:CompletionCelebrationView
                Grid.Row="0"
                TitleText="{Binding TitleText}"
                BodyText="{Binding BodyText}"
                IconName="{Binding CelebrationIconName}"
                IsMilestone="{Binding IsMilestone}"
                StreakValueText="{Binding StreakValueText}"
                StreakLabelText="{Binding StreakLabelText}"
                HasStreak="{Binding HasStreak}"
                PrimaryActionText="{Binding MorePracticeText}"
                PrimaryCommand="{Binding MorePracticeCommand}" />

            <VerticalStackLayout
                Grid.Row="1"
                Padding="{StaticResource LayoutPageMarginThickness}"
                Spacing="{StaticResource LayoutSpacing}">
                <VerticalStackLayout.Behaviors>
                    <behaviors:StaggerChildrenBehavior />
                </VerticalStackLayout.Behaviors>
                <Border
                    Style="{StaticResource BrandCardStyle}"
                    IsVisible="{Binding IsCrisis}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource DangerSurface}, Dark={StaticResource DangerSurfaceDark}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding CrisisText}" Style="{StaticResource BodyStyle}" />
                        <ui:ButtonView BodyText="{Binding CrisisButtonText}" TapCommand="{Binding CrisisCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- What was written in the practice, question by question: the thought and its balanced answer stay in sight. -->
                <Border Style="{StaticResource BrandCardStyle}" IsVisible="{Binding HasAnswers}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding AnswersTitle}" Style="{StaticResource SectionTitleStyle}" />
                        <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Answers}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="common:PracticeAnswer">
                                    <Grid ColumnDefinitions="4,*" ColumnSpacing="12">
                                        <BoxView
                                            Grid.Column="0"
                                            WidthRequest="4"
                                            CornerRadius="2"
                                            Color="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Title}" Style="{StaticResource CaptionStyle}" />
                                            <Label Text="{Binding Answer}" Style="{StaticResource BodyStyle}" FontFamily="{StaticResource MediumFontFamily}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <today:TodayPracticeRowView
                    x:Name="NextPracticeRow"
                    IsVisible="False"
                    CaptionText="{Binding NextPracticeCaption}"
                    Title="{Binding NextPracticeTitle}"
                    Subtitle="{Binding NextPracticeSubtitle}"
                    ReasonText="{Binding NextPracticeReason}"
                    IconName="{Binding NextPracticeIcon}"
                    TapCommand="{Binding NextPracticeCommand}">
                    <today:TodayPracticeRowView.Behaviors>
                        <behaviors:ListItemRevealBehavior RevealIndex="0" />
                    </today:TodayPracticeRowView.Behaviors>
                </today:TodayPracticeRowView>

                <Border Style="{StaticResource BrandCardStyle}">
                    <Border.Behaviors>
                        <behaviors:ListItemRevealBehavior RevealIndex="1" />
                    </Border.Behaviors>
                    <VerticalStackLayout Spacing="{StaticResource SectionSpacing}">
                        <Label
                            Text="{Binding SudsSectionTitle}"
                            Style="{StaticResource SectionTitleStyle}" />
                        <ui:RatingEntryView
                            TitleText="{Binding PostSudsLabel}"
                            BodyText="{Binding PostIntensityText, Mode=TwoWay}" />
                        <tension:TensionReliefView
                            IsVisible="{Binding HasSudsDelta}"
                            Before="{Binding PreIntensityValue}"
                            After="{Binding PostIntensityValue}" />
                        <Border
                            x:Name="SudsDeltaPill"
                            Style="{StaticResource MetaPillStyle}"
                            IsVisible="False"
                            HorizontalOptions="Center">
                            <Label
                                Text="{Binding SudsDeltaText}"
                                Style="{StaticResource CaptionStyle}"
                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                                FontFamily="{StaticResource SemiBoldFontFamily}"
                                HorizontalTextAlignment="Center" />
                        </Border>

                        <BoxView Style="{StaticResource SubtleDividerStyle}" Margin="{StaticResource FieldTopMargin}" />

                        <Label
                            Text="{Binding MoodSectionTitle}"
                            Style="{StaticResource SectionTitleStyle}" />
                        <mood:MoodStripView
                            QuestionText="{Binding ReflectionQuestion}"
                            RecordMoodCommand="{Binding RecordMoodCommand}"
                            SelectedMoodLevel="{Binding SelectedMoodLevel}" />
                        <Label
                            x:Name="MoodDeltaLabel"
                            IsVisible="False"
                            Text="{Binding MoodDeltaText}"
                            Style="{StaticResource EmphasisBodyStyle}"
                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                            FontFamily="{StaticResource SemiBoldFontFamily}"
                            HorizontalTextAlignment="Center"
                            Margin="{StaticResource FieldTopMargin}" />
                        <ui:TextEntryView
                            TitleText="{Binding ReflectionNotePlaceholder}"
                            BodyText="{Binding ReflectionNote}"
                            Margin="{StaticResource FieldTopMargin}" />
                    </VerticalStackLayout>
                </Border>
                <ui:SettingsLinkCardView
                    Title="{Binding OpenJournalText}"
                    IconName="Edit"
                    TapCommand="{Binding OpenJournalCommand}">
                    <ui:SettingsLinkCardView.Behaviors>
                        <behaviors:ListItemRevealBehavior RevealIndex="2" />
                    </ui:SettingsLinkCardView.Behaviors>
                </ui:SettingsLinkCardView>
                <ui:ButtonView
                    Variant="Secondary"
                    BodyText="{Binding GoHomeText}"
                    TapCommand="{Binding GoHomeCommand}" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
   
</ContentPage>
