<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.RunTechniqueSession.TechniqueTheory.TheoryPage"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.RunTechniqueSession.TechniqueTheory"
             xmlns:practice="clr-namespace:PsychologyApp.Application.Models.Practice;assembly=PsychologyApp.Application"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:DataType="vm:TheoryViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Margin="{StaticResource LayoutPageMarginThickness}" Spacing="{StaticResource LayoutSpacing}">
            <VerticalStackLayout.Behaviors>
                <behaviors:StaggerChildrenBehavior />
            </VerticalStackLayout.Behaviors>

            <ui:NavigationBarSimpleView
                TitleText="{Binding PageTitle}"
                BackText="{Binding BackText}"
                BackCommand="{Binding Finish}" />

            <Label
                IsVisible="{Binding HasTechniqueSubtitle}"
                Text="{Binding TechniqueSubtitle}"
                Style="{StaticResource CaptionStyle}"
                TextColor="{DynamicResource Primary}"
                MaxLines="2"
                LineBreakMode="TailTruncation" />

            <VerticalStackLayout
                IsVisible="{Binding HasSections}"
                Spacing="{StaticResource ListItemSpacing}"
                BindableLayout.ItemsSource="{Binding Sections}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="practice:TheorySection">
                        <Border Style="{StaticResource BrandCardStyle}" Margin="0">
                            <Border.Behaviors>
                                <behaviors:ListItemRevealBehavior />
                            </Border.Behaviors>
                            <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                                <Label Text="{Binding Heading}" Style="{StaticResource SectionTitleStyle}" />
                                <Label
                                    Text="{Binding Body}"
                                    Style="{StaticResource BodyStyle}"
                                    HorizontalTextAlignment="Justify" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Border
                IsVisible="{Binding HasLegacyText}"
                Style="{StaticResource BrandCardStyle}"
                Margin="0">
                <Label
                    Text="{Binding Text}"
                    Style="{StaticResource BodyStyle}"
                    HorizontalTextAlignment="Justify" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
