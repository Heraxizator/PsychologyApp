<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.RunTechniqueSession.TechniqueTheory.TheoryPage"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.RunTechniqueSession.TechniqueTheory"
             xmlns:practice="clr-namespace:PsychologyApp.Application.Models.Practice;assembly=PsychologyApp.Application"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:DataType="vm:TheoryViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <Grid VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
        <Grid
            IsVisible="{Binding IsDone}"
            Margin="{StaticResource LayoutPageMarginThickness}"
            RowDefinitions="Auto,*"
            RowSpacing="{StaticResource CompactSpacing}">
            <ui:NavigationBarSimpleView
                Grid.Row="0"
                TitleText="{Binding PageTitle}"
                BackText="{Binding BackText}"
                BackCommand="{Binding Finish}" />

        <ScrollView
            x:Name="TheoryContent"
            Grid.Row="1"
            VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}" Padding="0,0,0,8">
                <VerticalStackLayout.Behaviors>
                    <behaviors:StaggerChildrenBehavior />
                </VerticalStackLayout.Behaviors>

                <Label
                    IsVisible="{Binding HasTechniqueSubtitle}"
                    Text="{Binding TechniqueSubtitle}"
                    Style="{StaticResource CaptionStyle}"
                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                    MaxLines="2"
                    LineBreakMode="TailTruncation" />

                <VerticalStackLayout
                    IsVisible="{Binding HasSections}"
                    Spacing="{StaticResource ListItemSpacing}"
                    BindableLayout.ItemsSource="{Binding Sections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="practice:TheorySection">
                            <Border Style="{StaticResource BrandCardStyle}" Margin="0">
                                <Border.Behaviors>
                                    <behaviors:ListItemRevealBehavior />
                                </Border.Behaviors>
                                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                                    <Label Text="{Binding Heading}" Style="{StaticResource SectionTitleStyle}" />
                                    <Label
                                        Text="{Binding Body}"
                                        Style="{StaticResource BodyStyle}"
                                        HorizontalTextAlignment="Start" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border
                    IsVisible="{Binding HasLegacyText}"
                    Style="{StaticResource BrandCardStyle}"
                    Margin="0">
                    <Border.Behaviors>
                        <behaviors:ListItemRevealBehavior />
                    </Border.Behaviors>
                    <Label
                        Text="{Binding Text}"
                        Style="{StaticResource BodyStyle}"
                        HorizontalTextAlignment="Start" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        </Grid>

        <ui:SkeletonView
            Kind="Cards"
            Count="3"
            VerticalOptions="Start"
            Margin="20,76,20,0"
            IsActive="{Binding IsLoadingOverlayVisible}" />

        <ui:ProgressBarView
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
            Padding="24,8"
            x:Name="LoadingProgress"
            VerticalOptions="End"
            Margin="0,0,0,24"
            HorizontalOptions="Center"
            IsVisible="{Binding IsSlowLoadingVisible}"
            IsLoading="{Binding IsSlowLoadingVisible}"
            ProgressText="{Binding LoadingText}"
            CancelCommand="{Binding Cancel}" />

        <ui:RetryView
            VerticalOptions="Center"
            HorizontalOptions="Center"
            IsVisible="{Binding IsFail}"
            FailedText="{Binding FailedText}"
            RetryText="{Binding RetryText}"
            RetryCommand="{Binding Reload}" />
    </Grid>
</ContentPage>
