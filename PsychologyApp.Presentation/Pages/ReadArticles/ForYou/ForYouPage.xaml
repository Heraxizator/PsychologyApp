<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ReadArticles.ForYou.ForYouPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:card="clr-namespace:PsychologyApp.Presentation.Widgets.LibraryCard"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ReadArticles.ForYou"
             x:DataType="vm:ForYouViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <!-- Opened over the tabs: the same back arrow and title as every other pushed page, instead of the system bar. -->
    <Grid RowDefinitions="Auto,*">
        <ui:NavigationBarSimpleView
            Grid.Row="0"
            Margin="20,0"
            BackCommand="{Binding BackCommand}"
            TitleText="{Binding PageTitle}" />

    <ScrollView Grid.Row="1">
        <VerticalStackLayout Margin="{StaticResource LayoutTabPageMarginThickness}" Spacing="{StaticResource ListItemSpacing}">
            <VerticalStackLayout Spacing="{StaticResource ListItemSpacing}" IsVisible="{Binding HasPicks}" BindableLayout.ItemsSource="{Binding Picks}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="card:LibraryCardItem">
                        <card:LibraryCardView />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource ListItemSpacing}" IsVisible="{Binding HasSaved}">
                <Label Text="{Binding SavedTitle}" Style="{StaticResource SectionTitleStyle}" Margin="4,12,4,0" />
                <VerticalStackLayout Spacing="{StaticResource ListItemSpacing}" BindableLayout.ItemsSource="{Binding Saved}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="card:LibraryCardItem">
                            <card:LibraryCardView />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Nothing yet: one quiet line on how the page fills up, then a way in right away rather than an empty page. -->
            <VerticalStackLayout Spacing="{StaticResource ListItemSpacing}" IsVisible="{Binding IsEmpty}">
                <Label Text="{Binding EmptyText}" Style="{StaticResource CaptionStyle}" Margin="4,0" />
                <VerticalStackLayout Spacing="{StaticResource ListItemSpacing}" BindableLayout.ItemsSource="{Binding Starters}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="card:LibraryCardItem">
                            <card:LibraryCardView />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <ui:ButtonView BodyText="{Binding TakeTestText}" TapCommand="{Binding TakeTestCommand}" Variant="Secondary" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
