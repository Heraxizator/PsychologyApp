<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.SendReviewForm.ReviewForm.FormPage"
             xmlns:reviewForm="clr-namespace:PsychologyApp.Presentation.Features.SendReviewForm"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:DataType="reviewForm:FormViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">
    <Grid
        Margin="{StaticResource LayoutPageMarginThickness}"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="{StaticResource CompactSpacing}">
        <ui:NavigationBarSimpleView
            Grid.Row="0"
            TitleText="{Binding PageTitle}"
            BackCommand="{Binding BackCommand}" />

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout
                Spacing="{StaticResource LayoutSpacing}"
                Padding="0,0,0,8">
                <VerticalStackLayout.Behaviors>
                    <behaviors:StaggerChildrenBehavior />
                </VerticalStackLayout.Behaviors>

                <!-- One field and a line on where it goes (an info sign, not a lock: in one mode the message is sent): an explanation card and a "Your notes" title above a message read as a form
                     about something else. -->
                <ui:TextEditorView
                    PlaceholderText="{Binding MessagePlaceholder}"
                    BodyText="{Binding MessageText}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="4,0">
                    <ui:MaterialIconView
                        IconName="InfoOutline"
                        IconSize="16"
                        VerticalOptions="Start"
                        Margin="0,2,0,0"
                        IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Grid.Column="1" Text="{Binding ExplanationBody}" Style="{StaticResource CaptionStyle}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <ui:ButtonView
            Grid.Row="2"
            BodyText="{Binding SendButtonText}"
            TapCommand="{Binding Send}" />
    </Grid>
</ContentPage>
