<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.Chat.ChatList.ChatListPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.Chat.ChatList"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:avatar="clr-namespace:PsychologyApp.Presentation.Widgets.CompanionAvatar"
             x:DataType="vm:ChatListViewModel"
             Shell.NavBarIsVisible="True"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Behaviors>
        <behaviors:PageAnalyticsBehavior />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <!-- The neutral colour sits in the style: a local TextColor would win over the improving / worsening triggers. -->
        <Style x:Key="ChatMoodTrendStyle" TargetType="Label" BasedOn="{StaticResource CaptionStyle}">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
        </Style>
    </ContentPage.Resources>

    <!-- One card per chat, as elsewhere in the app: the initial, the title and time, the last line; the new-chat button in the corner. -->
    <Grid>
        <CollectionView
            ItemsSource="{Binding Chats}"
            SelectionMode="None"
            VerticalScrollBarVisibility="Never"
            Margin="12,8,12,0">
            <CollectionView.Footer>
                <!-- Room under the last row, so the round button never covers it. -->
                <BoxView HeightRequest="88" Color="Transparent" />
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatListItem">
                    <SwipeView Margin="4,4,4,8" BackgroundColor="Transparent">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem
                                    Text="{Binding RenameText}"
                                    BackgroundColor="{DynamicResource Primary}"
                                    Command="{Binding RenameCommand}" />
                                <SwipeItem
                                    Text="{Binding DeleteText}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                    Command="{Binding DeleteCommand}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border
                            Style="{StaticResource BrandCardStyle}"
                            Margin="0"
                            Padding="14,12"
                            BindingContextChanged="OnChatRowContextChanged">
                            <Border.Behaviors>
                                <behaviors:PressFeedbackBehavior />
                            </Border.Behaviors>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    VerticalOptions="Start"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}">
                                    <Label
                                        Text="{Binding Initial}"
                                        FontSize="19"
                                        FontFamily="{StaticResource SemiBoldFontFamily}"
                                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding Title}"
                                            Style="{StaticResource ListRowTitleStyle}"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="1" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding TimeText}"
                                            Style="{StaticResource CaptionStyle}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                    <Label
                                        Text="{Binding Preview}"
                                        Style="{StaticResource CaptionStyle}"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2" />
                                    <Label
                                        IsVisible="{Binding HasMood}"
                                        Text="{Binding MoodText}"
                                        Style="{StaticResource ChatMoodTrendStyle}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsImproving}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsWorsening}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!--
            No chats yet: a small drawn conversation (the companion typing, a reply, its answer) instead of a lone avatar,
            the promise that it stays on the phone, one big way to start and a few ready first lines for someone who does
            not know what to write. The scene is decoration only; screen readers skip it.
        -->
        <ScrollView IsVisible="{Binding IsEmpty}" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout
                VerticalOptions="Center"
                Spacing="16"
                Padding="28,24,28,32">
                <Grid
                    WidthRequest="264"
                    HorizontalOptions="Center"
                    RowDefinitions="Auto,Auto,Auto"
                    RowSpacing="10"
                    AutomationProperties.IsInAccessibleTree="False">
                    <!-- The companion, typing. -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalOptions="Start">
                        <avatar:CompanionAvatarView
                            WidthRequest="36"
                            HeightRequest="36"
                            IconSize="18"
                            ShowStatus="False"
                            VerticalOptions="End" />
                        <Border
                            Grid.Column="1"
                            Padding="16,14"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18,18,4,18" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse WidthRequest="8" HeightRequest="8" Fill="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" />
                                <Ellipse WidthRequest="8" HeightRequest="8" Fill="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" />
                                <Ellipse WidthRequest="8" HeightRequest="8" Fill="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <!-- The person's words. -->
                    <Border
                        Grid.Row="1"
                        HorizontalOptions="End"
                        Padding="16,14"
                        StrokeThickness="0"
                        BackgroundColor="{DynamicResource PrimaryFill}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18,18,18,4" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="7">
                            <BoxView WidthRequest="120" HeightRequest="8" CornerRadius="4" Color="White" Opacity="0.75" HorizontalOptions="Start" />
                            <BoxView WidthRequest="76" HeightRequest="8" CornerRadius="4" Color="White" Opacity="0.55" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>
                    <!-- Its answer. -->
                    <Border
                        Grid.Row="2"
                        Margin="44,0,0,0"
                        HorizontalOptions="Start"
                        Padding="16,14"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18,18,4,18" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="7">
                            <BoxView WidthRequest="140" HeightRequest="8" CornerRadius="4" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" HorizontalOptions="Start" />
                            <BoxView WidthRequest="96" HeightRequest="8" CornerRadius="4" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="8" Margin="0,8,0,0">
                    <Label
                        Text="{Binding EmptyTitle}"
                        Style="{StaticResource PageTitleStyle}"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="{Binding EmptyBody}"
                        Style="{StaticResource BodyStyle}"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- A grid, not a horizontal stack: the sentence has to wrap on a narrow phone or in Russian. -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalOptions="Center" Padding="8,0">
                    <ui:MaterialIconView
                        IconName="Lock"
                        IconSize="16"
                        IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                        VerticalOptions="Start"
                        Margin="0,2,0,0" />
                    <Label
                        Grid.Column="1"
                        Text="{Binding EmptyPrivacy}"
                        Style="{StaticResource CaptionStyle}"
                        LineBreakMode="WordWrap" />
                </Grid>

                <ui:ButtonView
                    BodyText="{Binding StartChatText}"
                    TapCommand="{Binding NewChatCommand}" />

                <Label
                    Margin="0,8,0,0"
                    Text="{Binding OpenersTitle}"
                    Style="{StaticResource CaptionStyle}"
                    HorizontalTextAlignment="Center" />
                <FlexLayout
                    Wrap="Wrap"
                    Direction="Row"
                    JustifyContent="Center"
                    AlignItems="Start"
                    BindableLayout.ItemsSource="{Binding Openers}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatOpener">
                            <Border
                                FlexLayout.Shrink="0"
                                Margin="4"
                                Padding="16,10"
                                MinimumHeightRequest="44"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}"
                                StrokeShape="RoundRectangle 22"
                                SemanticProperties.Description="{Binding Text}">
                                <Border.Behaviors>
                                    <behaviors:PressFeedbackBehavior />
                                </Border.Behaviors>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Command}" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="{Binding Text}"
                                    Style="{StaticResource BodyStyle}"
                                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                                    VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- A new chat: one round button in the corner, under the thumb. -->
        <Border
            IsVisible="{Binding HasChats}"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,20"
            WidthRequest="58"
            HeightRequest="58"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 29"
            BackgroundColor="{DynamicResource PrimaryFill}"
            SemanticProperties.Description="{Binding NewChatText}">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.28" />
            </Border.Shadow>
            <Border.Behaviors>
                <behaviors:PressFeedbackBehavior />
            </Border.Behaviors>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding NewChatCommand}" />
            </Border.GestureRecognizers>
            <ui:MaterialIconView
                IconName="Edit"
                IconSize="26"
                IconColor="{DynamicResource OnPrimary}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>
