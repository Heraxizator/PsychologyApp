<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.Chat.Companion.CompanionProfilePage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.Chat.Companion"
             xmlns:avatar="clr-namespace:PsychologyApp.Presentation.Widgets.CompanionAvatar"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:DataType="vm:CompanionProfileViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Behaviors>
        <behaviors:PageAnalyticsBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*" Margin="{StaticResource LayoutPageMarginThickness}">

        <!-- Kept outside the loading gate below: going back must always work, even while the page is still loading. -->
        <ui:NavigationBarSimpleView
            Grid.Row="0"
            TitleText="{Binding Title}"
            BackCommand="{Binding BackCommand}" />

        <ui:SkeletonView
            Grid.Row="1"
            Kind="Profile"
            VerticalOptions="Start"
            Margin="20,20,20,0"
            IsActive="{Binding IsLoading}" />

    <!-- Quiet on purpose: who this is, how it addresses you, what helped, what it is not. The counters, the streak, the trust meter
         and the statistics of topics that stood here made a page about a helper read like a game score. -->
    <ScrollView Grid.Row="1" IsVisible="{Binding HasLoaded}" VerticalScrollBarVisibility="Never">
        <VerticalStackLayout
            Spacing="{StaticResource LayoutSpacing}">
            <VerticalStackLayout.Behaviors>
                <behaviors:StaggerChildrenBehavior />
            </VerticalStackLayout.Behaviors>

            <!-- Face, name and one line about it; that it works offline is said in the card about it below. -->
            <Border Style="{StaticResource BrandCardStyle}" Margin="0">
                <VerticalStackLayout Spacing="10">
                    <!-- The top margin leaves room for the breathing ring, which reaches past the face and was clipped by the card. -->
                    <avatar:CompanionAvatarView
                        Margin="0,14,0,0"
                        WidthRequest="88"
                        HeightRequest="88"
                        IconSize="40"
                        HorizontalOptions="Center"
                        IsAlive="True"
                        SemanticProperties.Description="{Binding Title}" />
                    <Label Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}" HorizontalTextAlignment="Center" />
                    <Label
                        Text="{Binding Tagline}"
                        Style="{StaticResource BodyStyle}"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- How to address the person -->
            <Border Style="{StaticResource BrandCardStyle}" Margin="0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding NameTitle}" Style="{StaticResource CaptionStyle}" />
                        <Label Text="{Binding NameText}" Style="{StaticResource ListRowTitleStyle}" />
                    </VerticalStackLayout>
                    <Border
                        Grid.Column="1"
                        Padding="14,9"
                        StrokeThickness="1.2"
                        Stroke="{DynamicResource Primary}"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        SemanticProperties.Description="{Binding NameEditText}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditNameCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6">
                            <ui:MaterialIconView IconName="Edit" IconSize="16" IconColor="{DynamicResource Primary}" VerticalOptions="Center" />
                            <Label Text="{Binding NameEditText}" FontFamily="{StaticResource MediumFontFamily}" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <!-- Tension over time, and what helps: only once there is something to show, not two cards of instructions. -->
            <Border Style="{StaticResource BrandCardStyle}" Margin="0" IsVisible="{Binding HasTension}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding TensionTitle}" Style="{StaticResource SectionTitleStyle}" />

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasTension}">
                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="14"
                            BindableLayout.ItemsSource="{Binding TensionBars}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:TensionBarItem">
                                    <VerticalStackLayout Spacing="4" WidthRequest="38">
                                        <Grid HeightRequest="118" ColumnDefinitions="*,*" ColumnSpacing="3">
                                            <VerticalStackLayout Grid.Column="0" VerticalOptions="End" Spacing="2">
                                                <Label Text="{Binding BeforeText}" FontSize="12" HorizontalTextAlignment="Center" Style="{StaticResource CaptionStyle}" />
                                                <Border
                                                    StyleId="before"
                                                    HeightRequest="{Binding BeforeHeight}"
                                                    AnchorY="1"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 5,5,2,2"
                                                    BackgroundColor="{AppThemeBinding Light=#B7D9FF, Dark=#3A5F8F}"
                                                    BindingContextChanged="OnBarContextChanged" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="End" Spacing="2">
                                                <Label Text="{Binding AfterText}" FontSize="12" HorizontalTextAlignment="Center" Style="{StaticResource CaptionStyle}" />
                                                <Border
                                                    StyleId="after"
                                                    HeightRequest="{Binding AfterHeight}"
                                                    AnchorY="1"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 5,5,2,2"
                                                    BackgroundColor="{DynamicResource Primary}"
                                                    BindingContextChanged="OnBarContextChanged">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding Improved}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                </Border>
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Label Text="{Binding Label}" FontSize="12" HorizontalTextAlignment="Center" Style="{StaticResource CaptionStyle}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="18">
                            <HorizontalStackLayout Spacing="6">
                                <Border WidthRequest="12" HeightRequest="12" StrokeThickness="0" StrokeShape="RoundRectangle 3" BackgroundColor="{AppThemeBinding Light=#B7D9FF, Dark=#3A5F8F}" VerticalOptions="Center" />
                                <Label Text="{Binding TensionStartText}" Style="{StaticResource CaptionStyle}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <Border WidthRequest="12" HeightRequest="12" StrokeThickness="0" StrokeShape="RoundRectangle 3" BackgroundColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" VerticalOptions="Center" />
                                <Label Text="{Binding TensionEndText}" Style="{StaticResource CaptionStyle}" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Label Text="{Binding TensionCaption}" Style="{StaticResource BodyStyle}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource BrandCardStyle}" Margin="0" IsVisible="{Binding HasPractices}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding PracticesTitle}" Style="{StaticResource SectionTitleStyle}" />
                    <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Practices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PracticeRowItem">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8">
                                        <Label Text="{Binding Title}" Style="{StaticResource ListRowTitleStyle}" VerticalOptions="Center" />
                                        <Border
                                            IsVisible="{Binding IsBest}"
                                            Padding="8,2"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 9"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                            VerticalOptions="Center">
                                            <Label Text="{Binding BestText}" FontSize="12" TextColor="White" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding Detail}" Style="{StaticResource CaptionStyle}" />
                                    <ProgressBar Grid.Row="2" Grid.Column="0" Progress="{Binding HelpedFraction}" ProgressColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                                    <Border
                                        Grid.Row="0"
                                        Grid.RowSpan="3"
                                        Grid.Column="1"
                                        Padding="14,8"
                                        StrokeThickness="1.2"
                                        Stroke="{DynamicResource Primary}"
                                        StrokeShape="RoundRectangle 16"
                                        BackgroundColor="Transparent"
                                        VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding StartCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding StartText}" FontFamily="{StaticResource MediumFontFamily}" TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- What it is and what it is not: the safety text of the page, kept whole. -->
            <Border Style="{StaticResource BrandCardStyle}" Margin="0">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding AboutTitle}" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="{Binding AboutBody}" Style="{StaticResource BodyStyle}" />
                    <Label Text="{Binding PrivacyLine}" Style="{StaticResource CaptionStyle}" />
                    <Label Text="{Binding Disclaimer}" Style="{StaticResource CaptionStyle}" />
                </VerticalStackLayout>
            </Border>

            <ui:ButtonView BodyText="{Binding NewChatText}" TapCommand="{Binding NewChatCommand}" />

            <!-- Rare and irreversible: quiet rows behind a confirmation, not a stack of big buttons. -->
            <Border Style="{StaticResource BrandCardStyle}" Margin="0" Padding="20,6">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48" SemanticProperties.Description="{Binding ForgetText}">
                        <Grid.Behaviors>
                            <behaviors:PressFeedbackBehavior />
                        </Grid.Behaviors>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ForgetCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="{Binding ForgetText}" Style="{StaticResource BodyStyle}" VerticalOptions="Center" />
                        <ui:MaterialIconView Grid.Column="1" IconName="ChevronRight" IconSize="22" VerticalOptions="Center" />
                    </Grid>
                    <Grid IsVisible="{Binding HasHistory}" ColumnDefinitions="*,Auto" MinimumHeightRequest="48" SemanticProperties.Description="{Binding DeleteAllText}">
                        <Grid.Behaviors>
                            <behaviors:PressFeedbackBehavior />
                        </Grid.Behaviors>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DeleteAllCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="{Binding DeleteAllText}" Style="{StaticResource BodyStyle}" VerticalOptions="Center" />
                        <ui:MaterialIconView Grid.Column="1" IconName="ChevronRight" IconSize="22" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <BoxView HeightRequest="16" Color="Transparent" />
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
