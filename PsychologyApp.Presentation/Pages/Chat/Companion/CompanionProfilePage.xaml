<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.Chat.Companion.CompanionProfilePage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.Chat.Companion"
             xmlns:avatar="clr-namespace:PsychologyApp.Presentation.Widgets.CompanionAvatar"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:DataType="vm:CompanionProfileViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Behaviors>
        <behaviors:PageAnalyticsBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*" Margin="{StaticResource LayoutPageMarginThickness}">

        <!-- Kept outside the loading gate below: going back must always work, even while the page is still loading. -->
        <ui:NavigationBarSimpleView
            Grid.Row="0"
            TitleText="{Binding Title}"
            BackCommand="{Binding BackCommand}" />

        <ui:SkeletonView
            Grid.Row="1"
            Kind="Profile"
            VerticalOptions="Start"
            Margin="20,20,20,0"
            IsActive="{Binding IsLoading}" />

        <!-- One card on one screen: who it is, what it is not, the way to help, a new chat. The rare actions sit behind
             "Chat settings". The counters, charts and paragraphs that stood here made a page about a helper read like a report. -->
        <ScrollView Grid.Row="1" IsVisible="{Binding HasLoaded}" VerticalScrollBarVisibility="Never">
            <Border Style="{StaticResource BrandCardStyle}" Margin="0,16,0,16" Padding="24,28" VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <!-- The top margin leaves room for the breathing ring, which reaches past the face. -->
                    <avatar:CompanionAvatarView
                        Margin="0,22,0,0"
                        WidthRequest="96"
                        HeightRequest="96"
                        IconSize="44"
                        HorizontalOptions="Center"
                        IsAlive="True"
                        SemanticProperties.Description="{Binding Title}" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}" HorizontalTextAlignment="Center" />
                        <Label
                            Text="{Binding Tagline}"
                            Style="{StaticResource BodyStyle}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Three facts as tiles; the last one opens urgent help. -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,6,0,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Border Style="{StaticResource LargeIconTileStyle}" HorizontalOptions="Center">
                                <ui:MaterialIconView IconName="CloudOff" IconSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding OfflineText}" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Border Style="{StaticResource LargeIconTileStyle}" HorizontalOptions="Center">
                                <ui:MaterialIconView IconName="Lock" IconSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding OnPhoneText}" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="6" SemanticProperties.Description="{Binding CrisisText}">
                            <VerticalStackLayout.Behaviors>
                                <behaviors:PressFeedbackBehavior />
                            </VerticalStackLayout.Behaviors>
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CrisisCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <!-- The warm colours of urgent help in the side menu (AppMenuLook, Help), so it reads as the same door. -->
                            <Border
                                Style="{StaticResource LargeIconTileStyle}"
                                HorizontalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light=#FBE0DC, Dark=#4A2420}">
                                <ui:MaterialIconView
                                    IconName="HealthAndSafety"
                                    IconSize="24"
                                    IconColor="{AppThemeBinding Light=#B3261E, Dark=#F4B4AB}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding CrisisText}" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- What it is not: the safety line stays on the card, in one sentence. -->
                    <Label Text="{Binding Disclaimer}" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />

                    <ui:ButtonView BodyText="{Binding NewChatText}" TapCommand="{Binding NewChatCommand}" Margin="0,6,0,0" />

                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6" HorizontalOptions="Center" MinimumHeightRequest="44"
                          SemanticProperties.Description="{Binding SettingsText}">
                        <Grid.Behaviors>
                            <behaviors:PressFeedbackBehavior />
                        </Grid.Behaviors>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SettingsCommand}" />
                        </Grid.GestureRecognizers>
                        <ui:MaterialIconView
                            IconName="Settings"
                            IconSize="18"
                            VerticalOptions="Center"
                            IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding SettingsText}"
                            Style="{StaticResource BodyStyle}"
                            FontFamily="{StaticResource MediumFontFamily}"
                            VerticalOptions="Center"
                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>
