<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.Chat.Companion.CompanionProfilePage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.Chat.Companion"
             xmlns:avatar="clr-namespace:PsychologyApp.Presentation.Widgets.CompanionAvatar"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:DataType="vm:CompanionProfileViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Behaviors>
        <behaviors:PageAnalyticsBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*" Margin="{StaticResource LayoutPageMarginThickness}">

        <!-- Kept outside the loading gate below: going back must always work, even while the page is still loading. -->
        <ui:NavigationBarSimpleView
            Grid.Row="0"
            TitleText="{Binding Title}"
            BackCommand="{Binding BackCommand}" />

        <ui:SkeletonView
            Grid.Row="1"
            Kind="Profile"
            VerticalOptions="Start"
            Margin="20,20,20,0"
            IsActive="{Binding IsLoading}" />

        <!-- Laid out like the app's settings: who it is and what it is not, then its actions as rows in the cards of the settings
             screen. Nothing hides behind a sheet, and there is no slogan or tiles of text: the rows are the page. -->
        <ScrollView Grid.Row="1" IsVisible="{Binding HasLoaded}" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}" Padding="0,16,0,24">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="4,0,4,8">
                    <avatar:CompanionAvatarView
                        WidthRequest="56"
                        HeightRequest="56"
                        IconSize="28"
                        ShowStatus="False"
                        VerticalOptions="Center"
                        AutomationProperties.IsInAccessibleTree="False" />
                    <!-- What it is not stays at the top, under its name, in one sentence. -->
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="{Binding Disclaimer}" Style="{StaticResource CaptionStyle}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>

                <ui:SettingsLinkCardView Title="{Binding NewChatText}" IconName="AddComment" TapCommand="{Binding NewChatCommand}" />
                <ui:SettingsLinkCardView
                    Title="{Binding NameTitle}"
                    IconName="Person"
                    Subtitle="{Binding UserName}"
                    TapCommand="{Binding EditNameCommand}" />

                <ui:SettingsLinkCardView
                    Margin="0,8,0,0"
                    Title="{Binding CrisisText}"
                    IconName="HealthAndSafety"
                    TapCommand="{Binding CrisisCommand}" />

                <!-- The two that erase, apart from the rest; each still asks first. Deleting chats only when there are some. -->
                <ui:SettingsLinkCardView
                    Margin="0,8,0,0"
                    Title="{Binding ForgetText}"
                    IconName="PersonOff"
                    TapCommand="{Binding ForgetCommand}" />
                <ui:SettingsLinkCardView
                    IsVisible="{Binding HasHistory}"
                    Title="{Binding DeleteAllText}"
                    IconName="DeleteOutline"
                    TapCommand="{Binding DeleteAllCommand}" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="4,8,4,0">
                    <ui:MaterialIconView
                        IconName="Lock"
                        IconSize="16"
                        IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                        VerticalOptions="Start"
                        Margin="0,2,0,0" />
                    <Label Grid.Column="1" Text="{Binding PrivacyText}" Style="{StaticResource CaptionStyle}" LineBreakMode="WordWrap" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
