<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.Chat.Conversation.ChatPage"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.Chat.Conversation"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:avatar="clr-namespace:PsychologyApp.Presentation.Widgets.CompanionAvatar"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:tension="clr-namespace:PsychologyApp.Presentation.Widgets.TensionSlider"
             x:DataType="vm:ChatViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}"
             SafeAreaEdges="All"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
             Background="{AppThemeBinding Light={StaticResource ChatBackdropLight}, Dark={StaticResource ChatBackdropDark}}">

    <ContentPage.Resources>
        <!-- A very faint top-to-bottom wash behind the conversation: the white companion bubbles stand out from it a little, and the page is not flat grey. -->
        <LinearGradientBrush x:Key="ChatBackdropLight" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F3F4F6" Offset="0.0" />
            <GradientStop Color="#E9F0F7" Offset="1.0" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ChatBackdropDark" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#121212" Offset="0.0" />
            <GradientStop Color="#151B22" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <behaviors:PageAnalyticsBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header: back, avatar, name and status -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="44,Auto,*"
            ColumnSpacing="10"
            Padding="4,8,16,10"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <Label
                Grid.Column="0"
                Style="{StaticResource NavBackIconStyle}"
                Text="{mi:Material Icon=KeyboardArrowLeft}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </Label.GestureRecognizers>
            </Label>
            <avatar:CompanionAvatarView
                x:Name="HeaderAvatar"
                Grid.Column="1"
                WidthRequest="46"
                HeightRequest="46"
                VerticalOptions="Center"
                SemanticProperties.Description="{Binding OpenProfileText}"
                SemanticProperties.Hint="{Binding OpenProfileText}">
                <avatar:CompanionAvatarView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
                </avatar:CompanionAvatarView.GestureRecognizers>
            </avatar:CompanionAvatarView>
            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
                </VerticalStackLayout.GestureRecognizers>
                <Label
                    Text="{Binding Title}"
                    Style="{StaticResource ListRowTitleStyle}"
                    FontSize="17"
                    LineBreakMode="TailTruncation"
                    MaxLines="1" />
                <Label
                    Text="{Binding StatusText}"
                    Style="{StaticResource CaptionStyle}"
                    LineBreakMode="TailTruncation"
                    MaxLines="1" />
            </VerticalStackLayout>
            <BoxView
                Grid.ColumnSpan="3"
                HeightRequest="1"
                VerticalOptions="End"
                Margin="-4,0,-16,-10"
                Color="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource InputBorderDark}}" />
        </Grid>

        <!-- Conversation -->
        <CollectionView
            x:Name="MessageList"
            Grid.Row="1"
            Margin="12,0"
            ItemsSource="{Binding Messages}"
            SelectionMode="None"
            Scrolled="OnMessageListScrolled"
            VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatBubble">
                    <VerticalStackLayout Margin="{Binding OuterMargin}" Spacing="8" BindingContextChanged="OnBubbleContextChanged">
                        <Border
                            IsVisible="{Binding HasDate}"
                            HorizontalOptions="Center"
                            Margin="0,10,0,4"
                            Padding="12,4"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                            <Label Text="{Binding DateText}" Style="{StaticResource CaptionStyle}" FontSize="12" />
                        </Border>

                        <Border
                            HorizontalOptions="{Binding Alignment}"
                            MaximumWidthRequest="300"
                            Padding="14,9,14,6"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18,18,4,18"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryFill}" />
                                    <Setter Property="StrokeShape" Value="RoundRectangle 18,18,18,4" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Text}" Style="{StaticResource BodyStyle}" LineBreakMode="WordWrap">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsUser}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label
                                    Text="{Binding TimeText}"
                                    Style="{StaticResource CaptionStyle}"
                                    FontSize="12"
                                    HorizontalOptions="End">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsUser}" Value="True">
                                            <Setter Property="TextColor" Value="#CCFFFFFF" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <vm:TypingBubbleView IsVisible="{Binding IsTyping}" IsRunning="{Binding IsTyping}" />
            </CollectionView.Footer>
        </CollectionView>

        <ui:SkeletonView
            Grid.Row="1"
            Kind="Bubbles"
            VerticalOptions="Start"
            Margin="12,12,12,0"
            IsActive="{Binding IsLoading}" />

        <!-- Jump to the newest or the oldest message. Each appears only while there is somewhere to jump to. -->
        <VerticalStackLayout
            Grid.Row="1"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,14,14"
            Spacing="10">
            <Border
                x:Name="ScrollToTopButton"
                IsVisible="False"
                WidthRequest="44"
                HeightRequest="44"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22"
                Shadow="{AppThemeBinding Light={StaticResource BrandCardShadowLight}, Dark={StaticResource BrandCardShadowDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                SemanticProperties.Description="{Binding ScrollToOldestText}">
                <Border.Behaviors>
                    <behaviors:PressFeedbackBehavior />
                </Border.Behaviors>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnScrollToTopTapped" />
                </Border.GestureRecognizers>
                <Label
                    Text="{mi:Material Icon=KeyboardArrowUp}"
                    FontSize="22"
                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
            <Border
                x:Name="ScrollToBottomButton"
                IsVisible="False"
                WidthRequest="44"
                HeightRequest="44"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22"
                Shadow="{AppThemeBinding Light={StaticResource BrandCardShadowLight}, Dark={StaticResource BrandCardShadowDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                SemanticProperties.Description="{Binding ScrollToNewestText}">
                <Border.Behaviors>
                    <behaviors:PressFeedbackBehavior />
                </Border.Behaviors>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnScrollToBottomTapped" />
                </Border.GestureRecognizers>
                <Label
                    Text="{mi:Material Icon=KeyboardArrowDown}"
                    FontSize="22"
                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
        </VerticalStackLayout>

        <!-- Suggestions and the input bar -->
        <VerticalStackLayout Grid.Row="2" Spacing="0">

            <!-- The tension question is a card of its own on the soft backdrop. -->
            <Border
                IsVisible="{Binding IsRatingMode}"
                Margin="12,8,12,0"
                Padding="0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Stroke="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource InputBorderDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <tension:TensionSliderView
                    x:Name="TensionPicker"
                    ReferenceValue="{Binding RatingReference}"
                    Chosen="OnTensionChosen" />
            </Border>

            <FlexLayout
                IsVisible="{Binding ShowChips}"
                Wrap="Wrap"
                JustifyContent="Start"
                Margin="12,10,12,0"
                BindableLayout.ItemsSource="{Binding QuickReplies}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuickReplyItem">
                        <Border
                            Margin="0,0,8,8"
                            BindingContextChanged="OnChipContextChanged"
                            Padding="14,8"
                            StrokeThickness="1.2"
                            Stroke="{DynamicResource Primary}"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsPractice}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryFill}" />
                                    <Setter Property="Stroke" Value="{DynamicResource PrimaryFill}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Command}" CommandParameter="{Binding Reply}" />
                            </Border.GestureRecognizers>
                            <Label
                                Text="{Binding Label}"
                                FontSize="14"
                                FontFamily="{StaticResource MediumFontFamily}"
                                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsPractice}" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                                        <Setter Property="FontFamily" Value="{StaticResource SemiBoldFontFamily}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- One rounded bar: the text and the send button sit inside it, both centred on the same line. A tall message grows the bar upward and the button stays at its bottom. -->
            <Border
                Margin="12,8,12,12"
                Padding="6"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 28"
                Stroke="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource InputBorderDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <Editor
                        x:Name="InputEditor"
                        Grid.Column="0"
                        Margin="14,0,0,0"
                        Text="{Binding DraftText, Mode=TwoWay}"
                        Placeholder="{Binding Placeholder}"
                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                        FontSize="{DynamicResource BodyFontSize}"
                        AutoSize="TextChanges"
                        MaxLength="1500"
                        MinimumHeightRequest="44"
                        MaximumHeightRequest="120"
                        VerticalOptions="Center"
                        BackgroundColor="Transparent" />

                    <Border
                        Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        VerticalOptions="End"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        SemanticProperties.Description="{Binding SendText}"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding CanSend}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryFill}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SendCommand}" Tapped="OnSendTapped" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="{mi:Material Icon=Send}"
                            FontSize="20"
                            TranslationX="1"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding CanSend}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
