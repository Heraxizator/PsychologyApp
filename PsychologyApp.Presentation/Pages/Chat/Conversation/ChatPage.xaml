<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.Chat.Conversation.ChatPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.Chat.Conversation"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:DataType="vm:ChatViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource Gray950}}">

    <ContentPage.Behaviors>
        <behaviors:PageAnalyticsBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto" Padding="{StaticResource LayoutPageMarginThickness}" RowSpacing="8">

        <ui:NavigationBarSimpleView
            Grid.Row="0"
            TitleText="{Binding Title}"
            BackCommand="{Binding BackCommand}" />

        <CollectionView
            x:Name="MessageList"
            Grid.Row="1"
            ItemsSource="{Binding Messages}"
            SelectionMode="None"
            VerticalScrollBarVisibility="Never">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatBubble">
                    <Border
                        HorizontalOptions="{Binding Alignment}"
                        MaximumWidthRequest="320"
                        Padding="14,10,14,6"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsUser}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Text}" Style="{StaticResource BodyStyle}" LineBreakMode="WordWrap" />
                            <Label
                                Text="{Binding TimeText}"
                                Style="{StaticResource CaptionStyle}"
                                FontSize="11"
                                HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <Label
                    Text="{Binding TypingText}"
                    IsVisible="{Binding IsTyping}"
                    Style="{StaticResource CaptionStyle}"
                    Margin="6,10,0,4" />
            </CollectionView.Footer>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Spacing="8">

            <FlexLayout
                IsVisible="{Binding HasQuickReplies}"
                Wrap="Wrap"
                JustifyContent="Start"
                BindableLayout.ItemsSource="{Binding QuickReplies}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuickReplyItem">
                        <Border Style="{StaticResource FilterChipStyle}" Margin="0,0,8,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Command}" CommandParameter="{Binding Reply}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Label}" Style="{StaticResource FilterChipLabelStyle}" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource InputBorderStyle}">
                    <Editor
                        Text="{Binding DraftText, Mode=TwoWay}"
                        Placeholder="{Binding Placeholder}"
                        AutoSize="TextChanges"
                        MaxLength="1500"
                        MaximumHeightRequest="120"
                        BackgroundColor="Transparent" />
                </Border>
                <ui:ButtonView
                    Grid.Column="1"
                    VerticalOptions="End"
                    BodyText="{Binding SendText}"
                    TapCommand="{Binding SendCommand}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
