<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.Chat.Conversation.ChatPage"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.Chat.Conversation"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:avatar="clr-namespace:PsychologyApp.Presentation.Widgets.CompanionAvatar"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             x:DataType="vm:ChatViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource Gray950}}">

    <ContentPage.Behaviors>
        <behaviors:PageAnalyticsBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header: back, avatar, name and status -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="44,Auto,*"
            ColumnSpacing="10"
            Padding="4,8,16,10"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <Label
                Grid.Column="0"
                Style="{StaticResource NavBackIconStyle}"
                Text="{mi:Material Icon=KeyboardArrowLeft}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </Label.GestureRecognizers>
            </Label>
            <avatar:CompanionAvatarView
                x:Name="HeaderAvatar"
                Grid.Column="1"
                WidthRequest="46"
                HeightRequest="46"
                VerticalOptions="Center"
                SemanticProperties.Description="{Binding OpenProfileText}"
                SemanticProperties.Hint="{Binding OpenProfileText}">
                <avatar:CompanionAvatarView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
                </avatar:CompanionAvatarView.GestureRecognizers>
            </avatar:CompanionAvatarView>
            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
                </VerticalStackLayout.GestureRecognizers>
                <Label
                    Text="{Binding Title}"
                    Style="{StaticResource ListRowTitleStyle}"
                    FontSize="17"
                    LineBreakMode="TailTruncation"
                    MaxLines="1" />
                <Label
                    Text="{Binding StatusText}"
                    Style="{StaticResource CaptionStyle}"
                    LineBreakMode="TailTruncation"
                    MaxLines="1" />
            </VerticalStackLayout>
            <BoxView
                Grid.ColumnSpan="3"
                HeightRequest="1"
                VerticalOptions="End"
                Margin="-4,0,-16,-10"
                Color="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource InputBorderDark}}" />
        </Grid>

        <!-- Conversation -->
        <CollectionView
            x:Name="MessageList"
            Grid.Row="1"
            Margin="12,0"
            IsVisible="{Binding HasLoaded}"
            ItemsSource="{Binding Messages}"
            SelectionMode="None"
            Scrolled="OnMessageListScrolled"
            VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatBubble">
                    <VerticalStackLayout Margin="{Binding OuterMargin}" Spacing="8" BindingContextChanged="OnBubbleContextChanged">
                        <Border
                            IsVisible="{Binding HasDate}"
                            HorizontalOptions="Center"
                            Margin="0,10,0,4"
                            Padding="12,4"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                            <Label Text="{Binding DateText}" Style="{StaticResource CaptionStyle}" FontSize="12" />
                        </Border>

                        <Border
                            HorizontalOptions="{Binding Alignment}"
                            MaximumWidthRequest="300"
                            Padding="14,9,14,6"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18,18,4,18"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                                    <Setter Property="StrokeShape" Value="RoundRectangle 18,18,18,4" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Text}" Style="{StaticResource BodyStyle}" LineBreakMode="WordWrap">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsUser}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label
                                    Text="{Binding TimeText}"
                                    Style="{StaticResource CaptionStyle}"
                                    FontSize="11"
                                    HorizontalOptions="End">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsUser}" Value="True">
                                            <Setter Property="TextColor" Value="#CCFFFFFF" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <vm:TypingBubbleView IsVisible="{Binding IsTyping}" IsRunning="{Binding IsTyping}" />
            </CollectionView.Footer>
        </CollectionView>

        <ui:ProgressBarView
            Grid.Row="1"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            IsVisible="{Binding IsLoading}"
            IsLoading="{Binding IsLoading}"
            ProgressText="{Binding LoadingText}" />

        <!-- Jump to the newest or the oldest message. Each appears only while there is somewhere to jump to. -->
        <VerticalStackLayout
            Grid.Row="1"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,14,14"
            Spacing="10">
            <Border
                x:Name="ScrollToTopButton"
                IsVisible="False"
                WidthRequest="42"
                HeightRequest="42"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 21"
                Shadow="{AppThemeBinding Light={StaticResource BrandCardShadowLight}, Dark={StaticResource BrandCardShadowDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                SemanticProperties.Description="{Binding ScrollToOldestText}">
                <Border.Behaviors>
                    <behaviors:PressFeedbackBehavior />
                </Border.Behaviors>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnScrollToTopTapped" />
                </Border.GestureRecognizers>
                <Label
                    Text="{mi:Material Icon=KeyboardArrowUp}"
                    FontSize="22"
                    TextColor="{DynamicResource Primary}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
            <Border
                x:Name="ScrollToBottomButton"
                IsVisible="False"
                WidthRequest="42"
                HeightRequest="42"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 21"
                Shadow="{AppThemeBinding Light={StaticResource BrandCardShadowLight}, Dark={StaticResource BrandCardShadowDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                SemanticProperties.Description="{Binding ScrollToNewestText}">
                <Border.Behaviors>
                    <behaviors:PressFeedbackBehavior />
                </Border.Behaviors>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnScrollToBottomTapped" />
                </Border.GestureRecognizers>
                <Label
                    Text="{mi:Material Icon=KeyboardArrowDown}"
                    FontSize="22"
                    TextColor="{DynamicResource Primary}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
        </VerticalStackLayout>

        <!-- Suggestions and the input bar -->
        <VerticalStackLayout
            Grid.Row="2"
            Spacing="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">

            <BoxView
                HeightRequest="1"
                Color="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource InputBorderDark}}" />

            <FlexLayout
                IsVisible="{Binding HasQuickReplies}"
                Wrap="Wrap"
                JustifyContent="Start"
                Margin="12,10,12,0"
                BindableLayout.ItemsSource="{Binding QuickReplies}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuickReplyItem">
                        <Border
                            Margin="0,0,8,8"
                            BindingContextChanged="OnChipContextChanged"
                            Padding="14,8"
                            StrokeThickness="1.2"
                            Stroke="{DynamicResource Primary}"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Command}" CommandParameter="{Binding Reply}" />
                            </Border.GestureRecognizers>
                            <Label
                                Text="{Binding Label}"
                                FontSize="14"
                                FontFamily="{StaticResource MediumFontFamily}"
                                TextColor="{DynamicResource Primary}" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="12,10,12,12">
                <Border
                    Grid.Column="0"
                    Padding="16,4"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 23"
                    Stroke="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource InputBorderDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource Gray950}}">
                    <Editor
                        x:Name="InputEditor"
                        Text="{Binding DraftText, Mode=TwoWay}"
                        Placeholder="{Binding Placeholder}"
                        AutoSize="TextChanges"
                        MaxLength="1500"
                        MinimumHeightRequest="36"
                        MaximumHeightRequest="120"
                        VerticalOptions="Center"
                        BackgroundColor="Transparent" />
                </Border>

                <Border
                    Grid.Column="1"
                    WidthRequest="46"
                    HeightRequest="46"
                    VerticalOptions="End"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 23"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding CanSend}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SendCommand}" Tapped="OnSendTapped" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="{mi:Material Icon=Send}"
                        FontSize="22"
                        TextColor="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
