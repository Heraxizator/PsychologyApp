<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.Chat.Conversation.TypingBubbleView">

    <Border
        HorizontalOptions="Start"
        Margin="0,10,0,4"
        Padding="16,13"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 18,18,4,18"
        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
        <HorizontalStackLayout Spacing="5">
            <Ellipse x:Name="Dot1" WidthRequest="8" HeightRequest="8" Opacity="0.35"
                     Fill="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}" />
            <Ellipse x:Name="Dot2" WidthRequest="8" HeightRequest="8" Opacity="0.35"
                     Fill="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}" />
            <Ellipse x:Name="Dot3" WidthRequest="8" HeightRequest="8" Opacity="0.35"
                     Fill="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}" />
        </HorizontalStackLayout>
    </Border>
</ContentView>
