<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.Chat.ChatInfo.ChatInfoPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.Chat.ChatInfo"
             xmlns:list="clr-namespace:PsychologyApp.Presentation.Pages.Chat.ChatList"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:DataType="vm:ChatInfoViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Resources>
        <list:ChatTileColorConverter x:Key="ChatTileColor" />
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <behaviors:PageAnalyticsBehavior />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*" Margin="{StaticResource LayoutPageMarginThickness}">
        <ui:NavigationBarSimpleView Grid.Row="0" TitleText="{Binding PageTitle}" BackCommand="{Binding BackCommand}" />

        <ScrollView Grid.Row="1" IsVisible="{Binding HasLoaded}" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}" Padding="0,16,0,24">

                <!-- Who this chat is, as the AI psychologist's page begins: its state's tile (as in the chat list), its name and dates. -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="4,0,4,8">
                    <Border
                        Style="{StaticResource LargeIconTileStyle}"
                        BackgroundColor="{Binding Flavor, Converter={StaticResource ChatTileColor}, ConverterParameter=tile}">
                        <ui:MaterialIconView
                            IconName="{Binding IconName}"
                            IconSize="26"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            IconColor="{Binding Flavor, Converter={StaticResource ChatTileColor}, ConverterParameter=icon}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}" LineBreakMode="WordWrap" />
                        <Label Text="{Binding DatesText}" Style="{StaticResource CaptionStyle}" />
                    </VerticalStackLayout>
                </Grid>

                <!-- What the chat held. Each row shows only once the chat reached it, and the card only with one of them. -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasSummary}">
                    <Label Text="{Binding SectionText}" Style="{StaticResource CaptionStyle}" Margin="4,0,0,0" />
                    <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0">
                        <VerticalStackLayout Spacing="0">

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="48" IsVisible="{Binding HasFeeling}">
                                <ui:MaterialIconView IconName="SentimentNeutral" IconSize="20" VerticalOptions="Center"
                                                     IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Grid.Column="1" Text="{Binding FeelingLabel}" Style="{StaticResource BodyStyle}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding FeelingText}" Style="{StaticResource BodyStyle}" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </Grid>

                            <BoxView Style="{StaticResource SettingRowDividerStyle}" IsVisible="{Binding HasTension}" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="48" IsVisible="{Binding HasTension}">
                                <ui:MaterialIconView IconName="Speed" IconSize="20" VerticalOptions="Center"
                                                     IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Grid.Column="1" Text="{Binding TensionLabel}" Style="{StaticResource BodyStyle}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding TensionText}" Style="{StaticResource BodyStyle}" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </Grid>

                            <BoxView Style="{StaticResource SettingRowDividerStyle}" IsVisible="{Binding HasPractice}" />
                            <!-- The practice is a link: it opens the practice itself, to do it again. -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="48" IsVisible="{Binding HasPractice}"
                                  SemanticProperties.Description="{Binding PracticeText}">
                                <Grid.Behaviors>
                                    <behaviors:PressFeedbackBehavior />
                                </Grid.Behaviors>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PracticeCommand}" />
                                </Grid.GestureRecognizers>
                                <ui:MaterialIconView IconName="SelfImprovement" IconSize="20" VerticalOptions="Center"
                                                     IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Grid.Column="1" Text="{Binding PracticeLabel}" Style="{StaticResource BodyStyle}" VerticalOptions="Center" />
                                <HorizontalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding PracticeText}" Style="{StaticResource BodyStyle}" VerticalOptions="Center" LineBreakMode="TailTruncation" MaximumWidthRequest="180"
                                           TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                                    <ui:MaterialIconView IconName="ChevronRight" IconSize="18" VerticalOptions="Center"
                                                         IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                                </HorizontalStackLayout>
                            </Grid>

                            <BoxView Style="{StaticResource SettingRowDividerStyle}" IsVisible="{Binding HasStep}" />
                            <!-- The step is the person's own words, so it may be long: it goes under its label, not beside it. -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,12" IsVisible="{Binding HasStep}">
                                <ui:MaterialIconView IconName="OutlinedFlag" IconSize="20" VerticalOptions="Start"
                                                     IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding StepLabel}" Style="{StaticResource BodyStyle}" />
                                    <Label Text="{Binding StepText}" Style="{StaticResource BodyStyle}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Its actions as rows in the cards of the settings screen, as on the AI psychologist's page. There is no "Open": this
                     page is reached from the chat, and back is the way to it. Deleting stays apart and still asks first. -->
                <ui:SettingsLinkCardView Title="{Binding RenameText}" IconName="Edit" TapCommand="{Binding RenameCommand}" />
                <!-- The companion itself (its name for you, forgetting) is one row away, in its own speech-bubble icon. -->
                <ui:SettingsLinkCardView Title="{Binding AboutCompanionText}" IconName="Forum" TapCommand="{Binding AboutCompanionCommand}" />
                <ui:SettingsLinkCardView Margin="0,8,0,0" Title="{Binding DeleteText}" IconName="DeleteOutline" TapCommand="{Binding DeleteCommand}" />

                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <ui:MaterialIconView IconName="Lock" IconSize="16" VerticalOptions="Center"
                                         IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Text="{Binding OnPhoneText}" Style="{StaticResource CaptionStyle}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
