<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.SearchPhysics.StartPhysics.StartPhysicsPage"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.SearchPhysics.StartPhysics"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:DataType="vm:StartPhysicsViewModel"
             Shell.NavBarIsVisible="True"
             Title="{Binding PageTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding ProfileToolbarText}" Command="{Binding OpenProfileCommand}" />
    </ContentPage.ToolbarItems>

    <Grid VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
        <Grid
            IsVisible="{Binding IsDone}"
            Margin="{StaticResource LayoutTabPageMarginThickness}"
            RowDefinitions="*,Auto"
            RowSpacing="{StaticResource SectionSpacing}">

            <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout
                    x:Name="ContentStack"
                    Spacing="{StaticResource LayoutSpacing}"
                    Padding="0,0,0,8">
                    <VerticalStackLayout.Behaviors>
                        <behaviors:StaggerChildrenBehavior />
                        <behaviors:RevealOnAppearingBehavior RevealOnTabAppearOnly="True" />
                    </VerticalStackLayout.Behaviors>

                    <!-- Hero: what the tool is for -->
                    <Border Style="{StaticResource HeroCardStyle}" Margin="0" Padding="16">
                        <VerticalStackLayout Spacing="{StaticResource SectionSpacing}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Grid.Column="0" Style="{StaticResource IconTileStyle}" WidthRequest="52" HeightRequest="52">
                                    <ui:MaterialIconView
                                        IconName="Favorite"
                                        IconSize="28"
                                        IconColor="{DynamicResource Primary}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding ExplanationHeader}"
                                    Style="{StaticResource SectionTitleStyle}"
                                    VerticalOptions="Center" />
                            </Grid>
                            <Label Text="{Binding ExplanationBody}" Style="{StaticResource BodyStyle}" />
                        </VerticalStackLayout>
                    </Border>

                    <ui:TextBoxView
                        HeaderText="{Binding DescriptionHeader}"
                        BodyText="{Binding DescriptionBody}" />

                    <ui:AlgorithmBoxView
                        TitleText="{Binding AlgorithmHeader}"
                        BodySource="{Binding AlgorithmSteps}" />
                </VerticalStackLayout>
            </ScrollView>

            <ui:ButtonView
                Grid.Row="1"
                BodyText="{Binding StartButtonText}"
                TapCommand="{Binding StartCommand}" />
        </Grid>

        <ui:ProgressBarView
            x:Name="LoadingProgress"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            IsVisible="{Binding IsLoadingOverlayVisible}"
            IsLoading="{Binding IsLoadingOverlayVisible}"
            ProgressText="{Binding LoadingText}"
            CancelCommand="{Binding Cancel}" />

        <ui:RetryView
            VerticalOptions="Center"
            HorizontalOptions="Center"
            IsVisible="{Binding IsFail}"
            FailedText="{Binding FailedText}"
            RetryText="{Binding RetryText}"
            RetryCommand="{Binding Reload}" />
    </Grid>
</ContentPage>
