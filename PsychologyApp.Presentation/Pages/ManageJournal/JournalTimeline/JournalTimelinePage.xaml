<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageJournal.JournalTimeline.JournalTimelinePage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:journalUi="clr-namespace:PsychologyApp.Presentation.Widgets.Journal"
             xmlns:profile="clr-namespace:PsychologyApp.Presentation.Entities.Profile"
             xmlns:journal="clr-namespace:PsychologyApp.Presentation.Entities.Journal"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageJournal.JournalTimeline"
             x:Name="TimelineRoot"
             x:DataType="vm:JournalTimelineViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <Grid
        Margin="{StaticResource LayoutPageMarginThickness}"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="{StaticResource LayoutSpacing}">
        <ui:NavigationBarSimpleView
            Grid.Row="0"
            TitleText="{Binding PageTitle}"
            BackCommand="{Binding BackCommand}" />

        <VerticalStackLayout Grid.Row="1" Spacing="{StaticResource CompactSpacing}">
            <ui:TextEntryView
                PlaceholderText="{Binding SearchPlaceholder}"
                BodyText="{Binding SearchQuery}" />
            <Label
                IsVisible="{Binding HasTimelineStreak}"
                Text="{Binding TimelineStreakText}"
                Style="{StaticResource CaptionStyle}"
                TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        </VerticalStackLayout>

        <ui:EmptyStateView
            Grid.Row="2"
            IsVisible="{Binding ShowMoodNotesEmpty}"
            BodyText="{Binding MoodNotesEmpty}"
            IconName="Edit" />

        <CollectionView
            Grid.Row="3"
            IsVisible="{Binding HasMoodNotes}"
            ItemsSource="{Binding TimelineItems}"
            SelectionMode="None"
            VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <vm:JournalTimelineItemTemplateSelector>
                    <vm:JournalTimelineItemTemplateSelector.HeaderTemplate>
                        <DataTemplate x:DataType="journal:JournalTimelineHeaderItem">
                            <ui:SectionHeaderView
                                Margin="0,8,0,4"
                                TitleText="{Binding DateLabel}" />
                        </DataTemplate>
                    </vm:JournalTimelineItemTemplateSelector.HeaderTemplate>
                    <vm:JournalTimelineItemTemplateSelector.EntryTemplate>
                        <DataTemplate x:DataType="profile:MoodNoteItem">
                            <journalUi:JournalEntryView
                                Margin="0,0,0,8"
                                DateText="{Binding DateText}"
                                TimeText="{Binding TimeText}"
                                NoteText="{Binding NoteText}"
                                HasNote="{Binding HasNote}"
                                MoodDisplay="{Binding MoodDisplay}"
                                MoodGlyph="{Binding MoodGlyph}"
                                TapCommand="{Binding Source={x:Reference TimelineRoot}, Path=BindingContext.SelectTimelineEntryCommand}"
                                CommandParameter="{Binding .}"
                                ShareCommand="{Binding Source={x:Reference TimelineRoot}, Path=BindingContext.ShareEntryCommand}"
                                ShareCommandParameter="{Binding .}"
                                ShareDescription="{Binding Source={x:Reference TimelineRoot}, Path=BindingContext.ShareLabel}" />
                        </DataTemplate>
                    </vm:JournalTimelineItemTemplateSelector.EntryTemplate>
                </vm:JournalTimelineItemTemplateSelector>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
