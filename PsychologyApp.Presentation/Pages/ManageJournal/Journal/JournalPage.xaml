<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageJournal.Journal.JournalPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:mood="clr-namespace:PsychologyApp.Presentation.Widgets.MoodStrip"
             xmlns:journalStrip="clr-namespace:PsychologyApp.Presentation.Widgets.Journal"
             xmlns:journal="clr-namespace:PsychologyApp.Presentation.Entities.Journal"
             xmlns:filterChip="clr-namespace:PsychologyApp.Presentation.Entities.FilterChip"
             xmlns:profile="clr-namespace:PsychologyApp.Presentation.Entities.Profile"
             xmlns:common="clr-namespace:PsychologyApp.Presentation.Common;assembly=PsychologyApp.Presentation.Core"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageJournal.Journal"
             x:Name="JournalRoot"
             x:DataType="vm:JournalViewModel"
             Shell.NavBarIsVisible="True"
             Title="{Binding PageTitle}">

    <!-- The same bar as the other tabs: the title on the left, the overview and the history as icons. The glyph goes through a
         FontImageSource: the icon extension set straight on IconImageSource draws nothing in the Android toolbar. -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding OpenOverviewLabel}" Command="{Binding OpenOverviewCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialIcons" Glyph="{mi:Material Icon=Insights}" Size="24"
                                 Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem Text="{Binding OpenTimelineLabel}" Command="{Binding OpenTimelineCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialIcons" Glyph="{mi:Material Icon=History}" Size="24"
                                 Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid>
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout
            Margin="{StaticResource LayoutTabPageMarginThickness}"
            Spacing="{StaticResource LayoutSpacing}">
            <VerticalStackLayout.Behaviors>
                <behaviors:StaggerChildrenBehavior />
            </VerticalStackLayout.Behaviors>

            <!-- The week first, as a calendar: the card below is the check-in of the day chosen here. -->
            <journalStrip:JournalWeekStripView
                CaptionText=""
                ItemsSource="{Binding WeekDays}"
                SelectDayCommand="{Binding SelectDayCommand}"
                IsInteractive="True" />

            <!-- The check-in as a card, like the first card of the other tabs: the day and the slot on top, the question, the faces. -->
            <Border Style="{StaticResource BrandCardStyle}" Margin="0">
                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                    <!-- Morning and evening are two check-ins of one day; the chips show which one is open. -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label
                            Text="{Binding DayHeaderText}"
                            Style="{StaticResource HeroCaptionStyle}"
                            FontFamily="{StaticResource SemiBoldFontFamily}"
                            VerticalOptions="Center"
                            LineBreakMode="WordWrap" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="6" BindableLayout.ItemsSource="{Binding SlotFilters}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="filterChip:FilterChipTabItem">
                                    <ui:FilterChipView
                                        TitleText="{Binding Title}"
                                        IsSelected="{Binding IsSelected}"
                                        TapCommand="{Binding SelectSlotCommand, Source={RelativeSource AncestorType={x:Type vm:JournalViewModel}}, x:DataType=vm:JournalViewModel}"
                                        CommandParameter="{Binding Key}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </Grid>

                    <Label
                        IsVisible="{Binding ShowMoodQuestion}"
                        Text="{Binding MoodQuestionHero}"
                        Style="{StaticResource SectionTitleStyle}"
                        LineBreakMode="WordWrap" />

                    <mood:MoodStripView
                        UsePlainLayout="True"
                        HorizontalOptions="Fill"
                        QuestionText=""
                        RecordMoodCommand="{Binding RecordMoodCommand}"
                        SelectedMoodLevel="{Binding SelectedMoodLevel}"
                        TodayMoodDisplay="{Binding MoodSavedStatus}"
                        HasTodayMood="{Binding HasMoodSelected}"
                        MoodHistorySummary=""
                        HasMoodHistorySummary="False">
                        <mood:MoodStripView.Behaviors>
                            <behaviors:RevealOnAppearingBehavior />
                        </mood:MoodStripView.Behaviors>
                    </mood:MoodStripView>
                </VerticalStackLayout>
            </Border>

            <!-- The note as a card with the question of the day on top: an empty note is the hardest thing to fill. The question
                 changes daily and is never required. -->
            <Border IsVisible="{Binding ShowNoteEditor}" Style="{StaticResource BrandCardStyle}" Margin="0">
                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Style="{StaticResource IconTileStyle}" VerticalOptions="Start">
                            <ui:MaterialIconView WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center" IconName="Lightbulb" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding PromptTitle}" Style="{StaticResource HeroCaptionStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" />
                            <Label Text="{Binding PromptText}" Style="{StaticResource ListRowTitleStyle}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                    <ui:TextEditorView
                        PlaceholderText="{Binding NotePlaceholder}"
                        BodyText="{Binding JournalNote, Mode=TwoWay}"
                        UnfocusedCommand="{Binding FlushNoteCommand}" />

                    <FlexLayout
                        Wrap="Wrap"
                        Direction="Row"
                        AlignItems="Start"
                        JustifyContent="Start"
                        BindableLayout.ItemsSource="{Binding ActivityChips}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="journal:JournalActivityChip">
                                <ui:FilterChipView
                                    Margin="0,0,8,8"
                                    FlexLayout.Shrink="0"
                                    FlexLayout.AlignSelf="Start"
                                    TitleText="{Binding Label}"
                                    IsSelected="{Binding IsActive}"
                                    TapCommand="{Binding ToggleFactorCommand, Source={RelativeSource AncestorType={x:Type vm:JournalViewModel}}, x:DataType=vm:JournalViewModel}"
                                    CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- After a low check-in today: something small to do and help one tap away. In a crisis only the help row stays. -->
            <Border IsVisible="{Binding ShowLowMoodSupport}" Style="{StaticResource BrandCardStyle}" Margin="0">
                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Style="{StaticResource IconTileStyle}">
                            <ui:MaterialIconView WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center" IconName="VolunteerActivism" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding LowMoodTitle}" Style="{StaticResource SectionTitleStyle}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding LowMoodBody}" Style="{StaticResource BodyStyle}" />
                    <VerticalStackLayout IsVisible="{Binding ShowLowMoodPractices}" Spacing="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="44" SemanticProperties.Description="{Binding LowMoodBreathText}">
                        <Grid.Behaviors>
                            <behaviors:PressFeedbackBehavior />
                        </Grid.Behaviors>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenLowMoodBreathCommand}" />
                        </Grid.GestureRecognizers>
                        <ui:MaterialIconView IconName="SelfImprovement" IconSize="22" VerticalOptions="Center"
                                             IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                        <Label Grid.Column="1" Text="{Binding LowMoodBreathText}" Style="{StaticResource BodyStyle}" FontFamily="{StaticResource MediumFontFamily}" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                        <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="22" VerticalOptions="Center"
                                             IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="44" SemanticProperties.Description="{Binding LowMoodAnchorsText}">
                        <Grid.Behaviors>
                            <behaviors:PressFeedbackBehavior />
                        </Grid.Behaviors>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenLowMoodAnchorsCommand}" />
                        </Grid.GestureRecognizers>
                        <ui:MaterialIconView IconName="Anchor" IconSize="22" VerticalOptions="Center"
                                             IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                        <Label Grid.Column="1" Text="{Binding LowMoodAnchorsText}" Style="{StaticResource BodyStyle}" FontFamily="{StaticResource MediumFontFamily}" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                        <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="22" VerticalOptions="Center"
                                             IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                    </Grid>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="44" SemanticProperties.Description="{Binding LowMoodHelpText}">
                        <Grid.Behaviors>
                            <behaviors:PressFeedbackBehavior />
                        </Grid.Behaviors>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenLowMoodHelpCommand}" />
                        </Grid.GestureRecognizers>
                        <ui:MaterialIconView IconName="SupportAgent" IconSize="22" VerticalOptions="Center"
                                             IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                        <Label Grid.Column="1" Text="{Binding LowMoodHelpText}" Style="{StaticResource BodyStyle}" FontFamily="{StaticResource MediumFontFamily}" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                        <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="22" VerticalOptions="Center"
                                             IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- The week at a glance, the same figures as the overview; before there are any, what this place will show. -->
            <Border Style="{StaticResource BrandCardStyle}" Margin="0">
                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Style="{StaticResource IconTileStyle}">
                            <ui:MaterialIconView WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center" IconName="Insights" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding WeekCardTitle}" Style="{StaticResource SectionTitleStyle}" VerticalOptions="Center" />
                    </Grid>
                    <Grid IsVisible="{Binding HasWeekStats}" ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource CompactSpacing}">
                        <ui:MetricTileView Grid.Column="0" ValueText="{Binding WeekCheckIns}" LabelText="{Binding CheckInsLabel}" TapCommand="{Binding OpenOverviewCommand}" />
                        <ui:MetricTileView Grid.Column="1" ValueText="{Binding WeekAverage}" LabelText="{Binding AverageLabel}" TapCommand="{Binding OpenOverviewCommand}" />
                        <ui:MetricTileView Grid.Column="2" ValueText="{Binding WeekStreak}" LabelText="{Binding StreakLabel}" TapCommand="{Binding OpenOverviewCommand}" />
                    </Grid>
                    <Label IsVisible="{Binding HasWeekInsight}" Text="{Binding WeekInsight}" Style="{StaticResource BodyStyle}" />
                    <Label Text="{Binding WeekCardEmpty}" Style="{StaticResource BodyStyle}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasWeekStats}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44" SemanticProperties.Description="{Binding WeekOpenOverviewText}">
                        <Grid.Behaviors>
                            <behaviors:PressFeedbackBehavior />
                        </Grid.Behaviors>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenOverviewCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="{Binding WeekOpenOverviewText}" Style="{StaticResource BodyStyle}" FontFamily="{StaticResource MediumFontFamily}" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                        <ui:MaterialIconView Grid.Column="1" IconName="ChevronRight" IconSize="22" VerticalOptions="Center"
                                             IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding HasOnThisDay}" Style="{StaticResource BrandCardStyle}" Margin="0">
                <Label Text="{Binding OnThisDayText}" Style="{StaticResource BodyStyle}" />
            </Border>

            <!-- What was written lately comes back here; the full history is one tap away. -->
            <Border IsVisible="{Binding HasRecentNotes}" Style="{StaticResource BrandCardStyle}" Margin="0">
                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Style="{StaticResource IconTileStyle}">
                            <ui:MaterialIconView WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center" IconName="History" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding RecentTitle}" Style="{StaticResource SectionTitleStyle}" VerticalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding RecentNotes}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="profile:MoodNoteItem">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" SemanticProperties.Description="{Binding NoteText}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenTimelineCommand, Source={RelativeSource AncestorType={x:Type vm:JournalViewModel}}, x:DataType=vm:JournalViewModel}" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="{Binding MoodGlyph}" FontSize="24" VerticalOptions="Start" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                                        <Label Text="{Binding DateText}" Style="{StaticResource CaptionStyle}" />
                                        <Label Text="{Binding NoteText}" Style="{StaticResource BodyStyle}" MaxLines="2" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44" SemanticProperties.Description="{Binding RecentAllText}">
                        <Grid.Behaviors>
                            <behaviors:PressFeedbackBehavior />
                        </Grid.Behaviors>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenTimelineCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="{Binding RecentAllText}" Style="{StaticResource BodyStyle}" FontFamily="{StaticResource MediumFontFamily}" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                        <ui:MaterialIconView Grid.Column="1" IconName="ChevronRight" IconSize="22" VerticalOptions="Center"
                                             IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

        <!-- A soft circle in the colour of the chosen mood that opens from the tapped face and fades. -->
        <Border
            x:Name="MoodBloom"
            WidthRequest="120"
            HeightRequest="120"
            Opacity="0"
            InputTransparent="True"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="60" />
            </Border.StrokeShape>
        </Border>
    </Grid>
</ContentPage>
