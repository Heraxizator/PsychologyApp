<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageJournal.Journal.JournalPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:mood="clr-namespace:PsychologyApp.Presentation.Widgets.MoodStrip"
             xmlns:moodTrend="clr-namespace:PsychologyApp.Presentation.Widgets.Profile"
             xmlns:journalUi="clr-namespace:PsychologyApp.Presentation.Widgets.Journal"
             xmlns:profile="clr-namespace:PsychologyApp.Presentation.Entities.Profile"
             xmlns:journal="clr-namespace:PsychologyApp.Presentation.Entities.Journal"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageJournal.Journal"
             x:Name="JournalRoot"
             x:DataType="vm:JournalViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout
            Margin="{StaticResource LayoutPageMarginThickness}"
            Spacing="{StaticResource LayoutSpacing}">
            <VerticalStackLayout.Behaviors>
                <behaviors:StaggerChildrenBehavior />
            </VerticalStackLayout.Behaviors>

            <ui:NavigationBarSimpleView
                TitleText="{Binding PageTitle}"
                BackCommand="{Binding BackCommand}" />

            <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                <ui:SectionHeaderView TitleText="{Binding EditorDayTitle}" />
                <Border Style="{StaticResource BrandCardStyle}">
                    <Border.Behaviors>
                        <behaviors:ListItemRevealBehavior RevealIndex="0" />
                    </Border.Behaviors>
                    <VerticalStackLayout Spacing="{StaticResource SectionSpacing}">
                        <mood:MoodStripView
                            QuestionText="{Binding MoodCheckInTitle}"
                            RecordMoodCommand="{Binding RecordMoodCommand}"
                            SelectedMoodLevel="{Binding SelectedMoodLevel}"
                            TodayMoodDisplay="{Binding TodayMoodDisplay}"
                            HasTodayMood="{Binding HasTodayMood}"
                            MoodHistorySummary="{Binding MoodHistorySummary}"
                            HasMoodHistorySummary="{Binding HasMoodHistorySummary}" />
                        <Label
                            Text="{Binding NoteSaveHint}"
                            Style="{StaticResource CaptionStyle}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        <ui:FilterChipTabBarView
                            ItemsSource="{Binding PromptChips}"
                            TapCommand="{Binding ApplyPromptCommand}" />
                        <ui:TextEditorView
                            PlaceholderText="{Binding NotePlaceholder}"
                            BodyText="{Binding JournalNote}" />
                        <ui:ButtonView
                            BodyText="{Binding SaveLabel}"
                            TapCommand="{Binding SaveMoodCommand}"
                            Variant="Primary" />
                        <ui:ButtonView
                            IsVisible="{Binding CanDeleteEntry}"
                            BodyText="{Binding DeleteLabel}"
                            TapCommand="{Binding DeleteMoodCommand}"
                            Variant="Secondary" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                <ui:SectionHeaderView
                    TitleText="{Binding StatsSectionTitle}"
                    SubtitleText="{Binding WeekRangeSubtitle}" />
                <CollectionView
                    HeightRequest="72"
                    SelectionMode="None"
                    HorizontalScrollBarVisibility="Never"
                    ItemsSource="{Binding WeekDays}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="{StaticResource CompactSpacing}" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="journal:JournalDayChip">
                            <Border
                                WidthRequest="52"
                                HeightRequest="64"
                                Padding="4"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                Stroke="Transparent"
                                StrokeThickness="2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
                                        <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference JournalRoot}, Path=BindingContext.SelectDayCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Label
                                        Text="{Binding DayLabel}"
                                        Style="{StaticResource CaptionStyle}"
                                        FontSize="11"
                                        HorizontalTextAlignment="Center" />
                                    <Label
                                        Text="{Binding MoodGlyph}"
                                        FontSize="18"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <ui:FilterChipTabBarView
                    ItemsSource="{Binding RangeFilters}"
                    TapCommand="{Binding SelectRangeCommand}" />
                <ui:EmptyStateView
                    IsVisible="{Binding ShowStatsEmpty}"
                    BodyText="{Binding WeekEmptyText}"
                    IconName="SelfImprovement" />
                <Border
                    IsVisible="{Binding HasMoodStats}"
                    Style="{StaticResource BrandCardStyle}">
                    <Border.Behaviors>
                        <behaviors:ListItemRevealBehavior RevealIndex="1" />
                    </Border.Behaviors>
                    <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource CompactSpacing}">
                            <ui:MetricTileView
                                Grid.Column="0"
                                ValueText="{Binding CheckInCountDisplay}"
                                LabelText="{Binding WeekMoodCheckInsLabel}" />
                            <ui:MetricTileView
                                Grid.Column="1"
                                ValueText="{Binding AverageMoodDisplay}"
                                LabelText="{Binding WeekAvgMoodLabel}" />
                            <ui:MetricTileView
                                Grid.Column="2"
                                ValueText="{Binding MoodStreakDisplay}"
                                LabelText="{Binding WeekMoodStreakLabel}" />
                        </Grid>
                        <HorizontalStackLayout Spacing="{StaticResource CompactSpacing}">
                            <Border
                                Style="{StaticResource MetaPillStyle}"
                                IsVisible="{Binding HasMoodTrendPill}">
                                <Label
                                    Text="{Binding MoodTrendLabel}"
                                    Style="{StaticResource CaptionStyle}"
                                    TextColor="{DynamicResource Primary}"
                                    FontFamily="{StaticResource SemiBoldFontFamily}" />
                            </Border>
                            <Border
                                Style="{StaticResource MetaPillStyle}"
                                IsVisible="{Binding HasBestWorstPill}">
                                <Label
                                    Text="{Binding BestWorstLabel}"
                                    Style="{StaticResource CaptionStyle}"
                                    TextColor="{DynamicResource Primary}"
                                    FontFamily="{StaticResource SemiBoldFontFamily}" />
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                <ui:SectionHeaderView TitleText="{Binding MoodTrendTitle}" />
                <ui:EmptyStateView
                    IsVisible="{Binding ShowMoodTrendHint}"
                    BodyText="{Binding MoodTrendHint}"
                    IconName="SelfImprovement" />
                <moodTrend:MoodTrendChartView
                    IsVisible="{Binding HasMoodTrendChart}"
                    ChartPoints="{Binding MoodChartPoints}"
                    Subtitle="{Binding MoodChartSubtitle}"
                    Title="" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                <ui:SectionHeaderView TitleText="{Binding EntriesTitle}" />
                <ui:TextEntryView
                    PlaceholderText="{Binding SearchPlaceholder}"
                    BodyText="{Binding SearchQuery}" />
                <ui:EmptyStateView
                    IsVisible="{Binding ShowMoodNotesEmpty}"
                    BodyText="{Binding MoodNotesEmpty}"
                    IconName="Edit" />
                <VerticalStackLayout
                    IsVisible="{Binding HasMoodNotes}"
                    BindableLayout.ItemsSource="{Binding TimelineGroups}"
                    Spacing="{StaticResource LayoutSpacing}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="journal:JournalTimelineDayGroup">
                            <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                                <Label
                                    Text="{Binding DateLabel}"
                                    Style="{StaticResource SectionTitleStyle}" />
                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding Entries}"
                                    Spacing="{StaticResource ListItemSpacing}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="profile:MoodNoteItem">
                                            <journalUi:JournalEntryView
                                                DateText="{Binding DateText}"
                                                TimeText="{Binding TimeText}"
                                                NoteText="{Binding NoteText}"
                                                HasNote="{Binding HasNote}"
                                                MoodDisplay="{Binding MoodDisplay}"
                                                TapCommand="{Binding Source={x:Reference JournalRoot}, Path=BindingContext.SelectTimelineEntryCommand}"
                                                CommandParameter="{Binding .}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
