<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageJournal.Journal.JournalPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:mood="clr-namespace:PsychologyApp.Presentation.Widgets.MoodStrip"
             xmlns:journalStrip="clr-namespace:PsychologyApp.Presentation.Widgets.Journal"
             xmlns:journal="clr-namespace:PsychologyApp.Presentation.Entities.Journal"
             xmlns:filterChip="clr-namespace:PsychologyApp.Presentation.Entities.FilterChip"
             xmlns:profile="clr-namespace:PsychologyApp.Presentation.Entities.Profile"
             xmlns:common="clr-namespace:PsychologyApp.Presentation.Common;assembly=PsychologyApp.Presentation.Core"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageJournal.Journal"
             xmlns:manageJournal="clr-namespace:PsychologyApp.Presentation.Features.ManageJournal"
             x:Name="JournalRoot"
             x:DataType="vm:JournalViewModel"
             Shell.NavBarIsVisible="True"
             Title="{Binding PageTitle}">

    <!-- The colours of MoodPalette, for the drawing of a week on the empty page. -->
    <ContentPage.Resources>
        <Color x:Key="MoodFill1Light">#F2B8B0</Color>
        <Color x:Key="MoodFill1Dark">#7A3B37</Color>
        <Color x:Key="MoodFill2Light">#F6CFA3</Color>
        <Color x:Key="MoodFill2Dark">#7A5A32</Color>
        <Color x:Key="MoodFill3Light">#E6E2D3</Color>
        <Color x:Key="MoodFill3Dark">#4A4A44</Color>
        <Color x:Key="MoodFill4Light">#BFE3D6</Color>
        <Color x:Key="MoodFill4Dark">#2F6B5C</Color>
        <Color x:Key="MoodFill5Light">#8FD1BE</Color>
        <Color x:Key="MoodFill5Dark">#1F6E5C</Color>
    </ContentPage.Resources>

    <!-- The history alone in the bar, in the secondary colour: the other tabs have bare bars, and a black icon pair outweighed the
         title. The overview opens from the week's line. The glyph goes through a FontImageSource: the icon extension set straight
         on IconImageSource draws nothing in the Android toolbar. -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding OpenTimelineLabel}" Command="{Binding OpenTimelineCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialIcons" Glyph="{mi:Material Icon=History}" Size="22"
                                 Color="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid>
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout
            Margin="{StaticResource LayoutTabPageMarginThickness}"
            Spacing="{StaticResource LayoutSpacing}">
            <VerticalStackLayout.Behaviors>
                <behaviors:StaggerChildrenBehavior />
            </VerticalStackLayout.Behaviors>

            <!-- Nothing this week yet: one welcome instead of empty cards, drawn like the empty chat list. The faces are on the card
                 under it, so the first check-in is still one tap. -->
            <VerticalStackLayout IsVisible="{Binding ShowEmptyState}" Spacing="16" Padding="12,8,12,0">
                <Border
                    WidthRequest="264"
                    HorizontalOptions="Center"
                    Padding="20,18"
                    StrokeThickness="0"
                    AutomationProperties.IsInAccessibleTree="False"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" HeightRequest="64">
                            <Ellipse Grid.Column="0" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="End"
                                     Margin="0,0,0,20"
                                     Fill="{AppThemeBinding Light={StaticResource MoodFill3Light}, Dark={StaticResource MoodFill3Dark}}" />
                            <Ellipse Grid.Column="1" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="End"
                                     Margin="0,0,0,10"
                                     Fill="{AppThemeBinding Light={StaticResource MoodFill2Light}, Dark={StaticResource MoodFill2Dark}}" />
                            <Ellipse Grid.Column="2" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="End"
                                     Margin="0,0,0,20"
                                     Fill="{AppThemeBinding Light={StaticResource MoodFill3Light}, Dark={StaticResource MoodFill3Dark}}" />
                            <Ellipse Grid.Column="3" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="End"
                                     Margin="0,0,0,30"
                                     Fill="{AppThemeBinding Light={StaticResource MoodFill4Light}, Dark={StaticResource MoodFill4Dark}}" />
                            <Ellipse Grid.Column="4" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="End"
                                     Margin="0,0,0,20"
                                     Fill="{AppThemeBinding Light={StaticResource MoodFill3Light}, Dark={StaticResource MoodFill3Dark}}" />
                            <Ellipse Grid.Column="5" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="End"
                                     Margin="0,0,0,40"
                                     Fill="{AppThemeBinding Light={StaticResource MoodFill5Light}, Dark={StaticResource MoodFill5Dark}}" />
                            <Ellipse Grid.Column="6" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="End"
                                     Margin="0,0,0,30"
                                     Fill="{AppThemeBinding Light={StaticResource MoodFill4Light}, Dark={StaticResource MoodFill4Dark}}" />
                        </Grid>
                        <VerticalStackLayout Spacing="7">
                            <BoxView WidthRequest="180" HeightRequest="8" CornerRadius="4" HorizontalOptions="Start" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                            <BoxView WidthRequest="120" HeightRequest="8" CornerRadius="4" HorizontalOptions="Start" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding EmptyTitle}" Style="{StaticResource PageTitleStyle}" HorizontalTextAlignment="Center" />
                    <Label
                        Text="{Binding EmptyBody}"
                        Style="{StaticResource BodyStyle}"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- A grid, not a horizontal stack: the sentence has to wrap on a narrow phone. -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalOptions="Center" Padding="8,0">
                    <ui:MaterialIconView
                        IconName="Lock"
                        IconSize="16"
                        IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                        VerticalOptions="Start"
                        Margin="0,2,0,0" />
                    <Label Grid.Column="1" Text="{Binding EmptyPrivacy}" Style="{StaticResource CaptionStyle}" LineBreakMode="WordWrap" />
                </Grid>

                <!-- A quiet week has no week line to open the overview from; someone with older check-ins still gets there. -->
                <Grid
                    IsVisible="{Binding ShowEarlierWeeks}"
                    ColumnDefinitions="Auto,Auto"
                    ColumnSpacing="4"
                    HorizontalOptions="Center"
                    MinimumHeightRequest="44"
                    SemanticProperties.Description="{Binding EarlierWeeksText}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenOverviewCommand}" />
                    </Grid.GestureRecognizers>
                    <Label
                        Text="{Binding EarlierWeeksText}"
                        Style="{StaticResource BodyStyle}"
                        FontFamily="{StaticResource MediumFontFamily}"
                        VerticalOptions="Center"
                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                    <ui:MaterialIconView
                        Grid.Column="1"
                        IconName="ChevronRight"
                        IconSize="20"
                        VerticalOptions="Center"
                        IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                </Grid>
            </VerticalStackLayout>

            <!-- The week first, as a calendar: the card below is the check-in of the day chosen here. Its figures are one quiet line;
                 the overview has them in full. -->
            <!-- In a card like everything on the other tabs: seven loose tiles on the grey read as a different screen. The 4-point side
                 inset, corners and padding of the test cards keep the tabs in line. -->
            <Border IsVisible="{Binding ShowWeek}" Style="{StaticResource TestListCardStyle}" Margin="4,0" Padding="12,14">
                <VerticalStackLayout Spacing="8">
                    <journalStrip:JournalWeekStripView
                        CaptionText=""
                        ItemsSource="{Binding WeekDays}"
                        SelectDayCommand="{Binding SelectDayCommand}"
                        IsInteractive="True" />
                    <!-- The chevron says the line opens something: it is the only way to the overview. Not the whole card: its days are taps. -->
                    <Grid
                        IsVisible="{Binding HasWeekStats}"
                        ColumnDefinitions="*,Auto"
                        Margin="6,0,0,0"
                        SemanticProperties.Description="{Binding WeekSummaryText}"
                        SemanticProperties.Hint="{Binding OpenOverviewLabel}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenOverviewCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="{Binding WeekSummaryText}" Style="{StaticResource CaptionStyle}" VerticalOptions="Center" />
                        <ui:MaterialIconView
                            Grid.Column="1"
                            IconName="ChevronRight"
                            IconSize="20"
                            IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                            VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- The check-in and its note in one card: the question with the morning and evening chips beside it, the faces,
                 then the note. Colour is kept for the chosen face; the rest of the card is grey and text, so the journal stays calm. -->
            <Border Style="{StaticResource TestListCardStyle}" Margin="4,0">
                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                    <!-- Another day than today is named above the question. -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label
                                IsVisible="{Binding ShowDayHeader}"
                                Text="{Binding DayHeaderText}"
                                Style="{StaticResource CaptionStyle}"
                                LineBreakMode="WordWrap" />
                            <Label
                                Text="{Binding MoodQuestionHero}"
                                Style="{StaticResource SectionTitleStyle}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <!-- Morning and evening are two check-ins of one day; the chips show which one is open. -->
                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center" BindableLayout.ItemsSource="{Binding SlotFilters}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="filterChip:FilterChipTabItem">
                                    <ui:FilterChipView
                                        TitleText="{Binding Title}"
                                        IsSelected="{Binding IsSelected}"
                                        TapCommand="{Binding SelectSlotCommand, Source={RelativeSource AncestorType={x:Type vm:JournalViewModel}}, x:DataType=vm:JournalViewModel}"
                                        CommandParameter="{Binding Key}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </Grid>

                    <mood:MoodStripView
                        UsePlainLayout="True"
                        HorizontalOptions="Fill"
                        QuestionText=""
                        RecordMoodCommand="{Binding RecordMoodCommand}"
                        SelectedMoodLevel="{Binding SelectedMoodLevel}"
                        TodayMoodDisplay=""
                        HasTodayMood="False"
                        MoodHistorySummary=""
                        HasMoodHistorySummary="False">
                        <mood:MoodStripView.Behaviors>
                            <behaviors:RevealOnAppearingBehavior />
                        </mood:MoodStripView.Behaviors>
                    </mood:MoodStripView>

                    <!-- A quiet status: the chosen face already shows the answer; large blue text was the loudest thing on the page. -->
                    <Grid IsVisible="{Binding HasMoodSelected}" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <ui:MaterialIconView
                            IconName="CheckCircle"
                            IconSize="16"
                            VerticalOptions="Center"
                            IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        <Label Grid.Column="1" Text="{Binding MoodSavedStatus}" Style="{StaticResource CaptionStyle}" VerticalOptions="Center" />
                    </Grid>

                    <!-- The question of the day is the field's own hint (an empty note is the hardest thing to fill); it changes daily and
                         is never required. -->
                    <VerticalStackLayout IsVisible="{Binding ShowNoteEditor}" Spacing="{StaticResource CompactSpacing}">
                        <ui:TextEditorView
                            PlaceholderText="{Binding NotePlaceholder}"
                            BodyText="{Binding JournalNote, Mode=TwoWay}"
                            UnfocusedCommand="{Binding FlushNoteCommand}" />

                        <Label
                            IsVisible="{Binding ShowFactorsLink}"
                            Text="{Binding FactorsShowText}"
                            Style="{StaticResource CaptionStyle}"
                            MinimumHeightRequest="44"
                            VerticalTextAlignment="Center"
                            SemanticProperties.Description="{Binding FactorsShowText}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowFactorsCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <FlexLayout
                            IsVisible="{Binding ShowFactors}"
                            Wrap="Wrap"
                            Direction="Row"
                            AlignItems="Start"
                            JustifyContent="Start"
                            BindableLayout.ItemsSource="{Binding ActivityChips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="journal:JournalActivityChip">
                                    <ui:FilterChipView
                                        Margin="0,0,8,8"
                                        FlexLayout.Shrink="0"
                                        FlexLayout.AlignSelf="Start"
                                        TitleText="{Binding Label}"
                                        IsSelected="{Binding IsActive}"
                                        TapCommand="{Binding ToggleFactorCommand, Source={RelativeSource AncestorType={x:Type vm:JournalViewModel}}, x:DataType=vm:JournalViewModel}"
                                        CommandParameter="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- After a low check-in today: something small to do and help one tap away. In a crisis only the help row stays. -->
            <Border IsVisible="{Binding ShowLowMoodSupport}" Style="{StaticResource TestListCardStyle}" Margin="4,0">
                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Style="{StaticResource IconTileStyle}">
                            <ui:MaterialIconView WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center" IconName="VolunteerActivism" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding LowMoodTitle}" Style="{StaticResource SectionTitleStyle}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding LowMoodBody}" Style="{StaticResource BodyStyle}" />
                    <VerticalStackLayout IsVisible="{Binding ShowLowMoodPractices}" Spacing="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="44" SemanticProperties.Description="{Binding LowMoodBreathText}">
                        <Grid.Behaviors>
                            <behaviors:PressFeedbackBehavior />
                        </Grid.Behaviors>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenLowMoodBreathCommand}" />
                        </Grid.GestureRecognizers>
                        <ui:MaterialIconView IconName="SelfImprovement" IconSize="22" VerticalOptions="Center"
                                             IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                        <Label Grid.Column="1" Text="{Binding LowMoodBreathText}" Style="{StaticResource BodyStyle}" FontFamily="{StaticResource MediumFontFamily}" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                        <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="22" VerticalOptions="Center"
                                             IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="44" SemanticProperties.Description="{Binding LowMoodAnchorsText}">
                        <Grid.Behaviors>
                            <behaviors:PressFeedbackBehavior />
                        </Grid.Behaviors>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenLowMoodAnchorsCommand}" />
                        </Grid.GestureRecognizers>
                        <ui:MaterialIconView IconName="Anchor" IconSize="22" VerticalOptions="Center"
                                             IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                        <Label Grid.Column="1" Text="{Binding LowMoodAnchorsText}" Style="{StaticResource BodyStyle}" FontFamily="{StaticResource MediumFontFamily}" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                        <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="22" VerticalOptions="Center"
                                             IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                    </Grid>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="44" SemanticProperties.Description="{Binding LowMoodHelpText}">
                        <Grid.Behaviors>
                            <behaviors:PressFeedbackBehavior />
                        </Grid.Behaviors>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenLowMoodHelpCommand}" />
                        </Grid.GestureRecognizers>
                        <ui:MaterialIconView IconName="SupportAgent" IconSize="22" VerticalOptions="Center"
                                             IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                        <Label Grid.Column="1" Text="{Binding LowMoodHelpText}" Style="{StaticResource BodyStyle}" FontFamily="{StaticResource MediumFontFamily}" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                        <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="22" VerticalOptions="Center"
                                             IconColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label
                IsVisible="{Binding HasOnThisDay}"
                Text="{Binding OnThisDayText}"
                Style="{StaticResource CaptionStyle}"
                HorizontalTextAlignment="Center"
                Margin="12,0" />

            <!-- The week's latest check-ins, so the page goes on as a list like the other tabs; a tap opens one in the card above. -->
            <VerticalStackLayout IsVisible="{Binding HasRecentEntries}" Spacing="8">
                <Label Text="{Binding RecentTitle}" Style="{StaticResource CaptionStyle}" Margin="6,0" />
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding RecentEntries}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="manageJournal:JournalRecentEntry">
                            <journalStrip:JournalEntryView
                                DateText="{Binding Caption}"
                                NoteText="{Binding Entry.NoteText}"
                                MoodLevel="{Binding Entry.MoodLevel}"
                                TapCommand="{Binding OpenRecentEntryCommand, Source={RelativeSource AncestorType={x:Type vm:JournalViewModel}}, x:DataType=vm:JournalViewModel}"
                                CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

        <!-- A soft circle in the colour of the chosen mood that opens from the tapped face and fades. -->
        <Border
            x:Name="MoodBloom"
            WidthRequest="120"
            HeightRequest="120"
            Opacity="0"
            InputTransparent="True"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="60" />
            </Border.StrokeShape>
        </Border>
    </Grid>
</ContentPage>
