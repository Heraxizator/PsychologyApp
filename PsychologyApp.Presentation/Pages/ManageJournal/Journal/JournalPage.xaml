<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageJournal.Journal.JournalPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:mood="clr-namespace:PsychologyApp.Presentation.Widgets.MoodStrip"
             xmlns:journalStrip="clr-namespace:PsychologyApp.Presentation.Widgets.Journal"
             xmlns:journal="clr-namespace:PsychologyApp.Presentation.Entities.Journal"
             xmlns:common="clr-namespace:PsychologyApp.Presentation.Common;assembly=PsychologyApp.Presentation.Core"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageJournal.Journal"
             x:Name="JournalRoot"
             x:DataType="vm:JournalViewModel"
             Shell.NavBarIsVisible="True"
             Title="{Binding PageTitle}">

    <!-- The same bar as the other tabs: the title on the left, the overview and the history as icons. The glyph goes through a
         FontImageSource: the icon extension set straight on IconImageSource draws nothing in the Android toolbar. -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding OpenOverviewLabel}" Command="{Binding OpenOverviewCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialIcons" Glyph="{mi:Material Icon=Insights}" Size="24"
                                 Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem Text="{Binding OpenTimelineLabel}" Command="{Binding OpenTimelineCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="MaterialIcons" Glyph="{mi:Material Icon=History}" Size="24"
                                 Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid>
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout
            Margin="{StaticResource LayoutTabPageMarginThickness}"
            Spacing="{StaticResource LayoutSpacing}">
            <VerticalStackLayout.Behaviors>
                <behaviors:StaggerChildrenBehavior />
            </VerticalStackLayout.Behaviors>

            <Label
                Text="{Binding DayHeaderText}"
                Style="{StaticResource CaptionStyle}"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                FontFamily="{StaticResource SemiBoldFontFamily}"
                SemanticProperties.Description="{Binding DayHeaderText}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PickSlotCommand}" />
                </Label.GestureRecognizers>
                <Label.Behaviors>
                    <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                </Label.Behaviors>
            </Label>

            <Label
                IsVisible="{Binding ShowMoodQuestion}"
                Text="{Binding MoodQuestionHero}"
                Style="{StaticResource SectionTitleStyle}"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap" />

            <mood:MoodStripView
                UsePlainLayout="True"
                HorizontalOptions="Fill"
                QuestionText=""
                RecordMoodCommand="{Binding RecordMoodCommand}"
                SelectedMoodLevel="{Binding SelectedMoodLevel}"
                TodayMoodDisplay="{Binding MoodSavedStatus}"
                HasTodayMood="{Binding HasMoodSelected}"
                MoodHistorySummary=""
                HasMoodHistorySummary="False">
                <mood:MoodStripView.Behaviors>
                    <behaviors:RevealOnAppearingBehavior />
                </mood:MoodStripView.Behaviors>
            </mood:MoodStripView>

            <journalStrip:JournalWeekStripView
                CaptionText=""
                ItemsSource="{Binding WeekDays}"
                SelectDayCommand="{Binding SelectDayCommand}"
                IsInteractive="True" />

            <VerticalStackLayout
                IsVisible="{Binding ShowNoteEditor}"
                Spacing="{StaticResource CompactSpacing}">
                <ui:TextEditorView
                    PlaceholderText="{Binding NotePlaceholder}"
                    BodyText="{Binding JournalNote, Mode=TwoWay}"
                    UnfocusedCommand="{Binding FlushNoteCommand}" />

                <FlexLayout
                    Wrap="Wrap"
                    Direction="Row"
                    AlignItems="Start"
                    JustifyContent="Start"
                    BindableLayout.ItemsSource="{Binding ActivityChips}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="journal:JournalActivityChip">
                            <ui:FilterChipView
                                Margin="0,0,8,8"
                                FlexLayout.Shrink="0"
                                FlexLayout.AlignSelf="Start"
                                TitleText="{Binding Label}"
                                IsSelected="{Binding IsActive}"
                                TapCommand="{Binding ToggleFactorCommand, Source={RelativeSource AncestorType={x:Type vm:JournalViewModel}}, x:DataType=vm:JournalViewModel}"
                                CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <Label
                IsVisible="{Binding ShowPracticeSuggest}"
                Text="{Binding PracticeSuggestText}"
                Style="{StaticResource CaptionStyle}"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                SemanticProperties.Description="{Binding PracticeSuggestText}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenPracticeSuggestCommand}" />
                </Label.GestureRecognizers>
                <Label.Behaviors>
                    <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                </Label.Behaviors>
            </Label>
        </VerticalStackLayout>
    </ScrollView>

        <!-- A soft circle in the colour of the chosen mood that opens from the tapped face and fades. -->
        <Border
            x:Name="MoodBloom"
            WidthRequest="120"
            HeightRequest="120"
            Opacity="0"
            InputTransparent="True"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="60" />
            </Border.StrokeShape>
        </Border>
    </Grid>
</ContentPage>
