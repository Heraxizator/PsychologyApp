<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageJournal.Journal.JournalPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:mood="clr-namespace:PsychologyApp.Presentation.Widgets.MoodStrip"
             xmlns:journalStrip="clr-namespace:PsychologyApp.Presentation.Widgets.Journal"
             xmlns:journal="clr-namespace:PsychologyApp.Presentation.Entities.Journal"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageJournal.Journal"
             x:Name="JournalRoot"
             x:DataType="vm:JournalViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout
            Margin="{StaticResource LayoutPageMarginThickness}"
            Spacing="{StaticResource LayoutSpacing}">
            <VerticalStackLayout.Behaviors>
                <behaviors:StaggerChildrenBehavior />
            </VerticalStackLayout.Behaviors>

            <Grid
                Margin="{StaticResource NavBarBottomMargin}"
                ColumnDefinitions="44,*,Auto,Auto"
                ColumnSpacing="4"
                MinimumHeightRequest="48">
                <Grid.Behaviors>
                    <behaviors:PressFeedbackBehavior AttachToTappableLabels="True" />
                </Grid.Behaviors>
                <BoxView
                    Grid.ColumnSpan="4"
                    HeightRequest="1"
                    VerticalOptions="End"
                    Color="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource InputBorderDark}}" />
                <Label
                    Grid.Column="0"
                    Style="{StaticResource NavBackIconStyle}"
                    Text="{mi:Material Icon=KeyboardArrowLeft}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label
                    Grid.Column="1"
                    Text="{Binding PageTitle}"
                    Style="{StaticResource NavTitleStyle}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="1" />
                <Label
                    Grid.Column="2"
                    Style="{StaticResource IconActionStyle}"
                    WidthRequest="40"
                    VerticalOptions="Center"
                    Text="{mi:Material Icon=Insights}"
                    SemanticProperties.Description="{Binding OpenOverviewLabel}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenOverviewCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label
                    Grid.Column="3"
                    Style="{StaticResource IconActionStyle}"
                    WidthRequest="40"
                    VerticalOptions="Center"
                    Text="{mi:Material Icon=History}"
                    SemanticProperties.Description="{Binding OpenTimelineLabel}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenTimelineCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                <Label
                    Text="{Binding DayHeaderText}"
                    Style="{StaticResource SectionTitleStyle}"
                    HorizontalTextAlignment="Center" />

                <ui:FilterChipTabBarView
                    HorizontalOptions="Center"
                    ItemsSource="{Binding SlotFilters}"
                    TapCommand="{Binding SelectSlotCommand}" />

                <mood:MoodStripView
                    UsePlainLayout="True"
                    QuestionText="{Binding MoodQuestionText}"
                    RecordMoodCommand="{Binding RecordMoodCommand}"
                    SelectedMoodLevel="{Binding SelectedMoodLevel}"
                    TodayMoodDisplay="{Binding TodayMoodDisplay}"
                    HasTodayMood="{Binding HasTodayMood}"
                    MoodHistorySummary=""
                    HasMoodHistorySummary="False">
                    <mood:MoodStripView.Behaviors>
                        <behaviors:RevealOnAppearingBehavior />
                    </mood:MoodStripView.Behaviors>
                </mood:MoodStripView>

                <Label
                    IsVisible="{Binding ShowDayEmptyCaption}"
                    Text="{Binding DayEmptyCaption}"
                    Style="{StaticResource CaptionStyle}"
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                <journalStrip:JournalWeekStripView
                    CaptionText=""
                    ItemsSource="{Binding WeekDays}"
                    SelectDayCommand="{Binding SelectDayCommand}"
                    IsInteractive="True" />
            </VerticalStackLayout>

            <ui:SettingsLinkCardView
                IsVisible="{Binding ShowPracticeSuggest}"
                Title="{Binding PracticeSuggestText}"
                TapCommand="{Binding OpenPracticeSuggestCommand}" />

            <Label
                IsVisible="{Binding ShowAddNoteButton}"
                Text="{Binding AddNoteLabel}"
                Style="{StaticResource NavActionLabelStyle}"
                HorizontalOptions="Center"
                TextColor="{DynamicResource Primary}"
                SemanticProperties.Description="{Binding AddNoteLabel}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ExpandNoteCommand}" />
                </Label.GestureRecognizers>
                <Label.Behaviors>
                    <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                </Label.Behaviors>
            </Label>

            <Border
                IsVisible="{Binding ShowNoteEditor}"
                Style="{StaticResource BrandCardStyle}"
                Margin="0">
                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                    <ui:TextEditorView
                        PlaceholderText="{Binding NotePlaceholder}"
                        BodyText="{Binding JournalNote}" />

                    <FlexLayout
                        Wrap="Wrap"
                        Direction="Row"
                        AlignItems="Start"
                        JustifyContent="Start">
                        <ui:FilterChipView
                            Margin="0,0,8,8"
                            TitleText="{Binding PromptHelpedLabel}"
                            TapCommand="{Binding ApplyPromptCommand}"
                            CommandParameter="helped" />
                        <ui:FilterChipView
                            Margin="0,0,8,8"
                            TitleText="{Binding PromptBlockedLabel}"
                            TapCommand="{Binding ApplyPromptCommand}"
                            CommandParameter="blocked" />
                        <ui:FilterChipView
                            Margin="0,0,8,8"
                            TitleText="{Binding PromptGratefulLabel}"
                            TapCommand="{Binding ApplyPromptCommand}"
                            CommandParameter="grateful" />
                        <ui:FilterChipView
                            Margin="0,0,8,8"
                            TitleText="{Binding PromptNextLabel}"
                            TapCommand="{Binding ApplyPromptCommand}"
                            CommandParameter="next" />
                    </FlexLayout>

                    <FlexLayout
                        Wrap="Wrap"
                        Direction="Row"
                        AlignItems="Start"
                        JustifyContent="Start"
                        BindableLayout.ItemsSource="{Binding ActivityChips}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="journal:JournalActivityChip">
                                <ui:FilterChipView
                                    Margin="0,0,8,8"
                                    TitleText="{Binding Label}"
                                    IsSelected="{Binding IsActive}"
                                    TapCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:JournalViewModel}}, Path=ToggleFactorCommand}"
                                    CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <ui:ButtonView
                        BodyText="{Binding SaveLabel}"
                        TapCommand="{Binding SaveMoodCommand}"
                        Variant="Primary" />

                    <BoxView
                        IsVisible="{Binding ShowEntryActions}"
                        Style="{StaticResource SubtleDividerStyle}" />

                    <Grid
                        IsVisible="{Binding ShowEntryActions}"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="{StaticResource CompactSpacing}">
                        <Border
                            Grid.Column="0"
                            Style="{StaticResource TestFlatCardStyle}"
                            IsVisible="{Binding CanShareEntry}"
                            Margin="0"
                            Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShareCommand}" />
                            </Border.GestureRecognizers>
                            <Border.Behaviors>
                                <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                            </Border.Behaviors>
                            <HorizontalStackLayout
                                Spacing="8"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Label
                                    Style="{StaticResource IconActionStyle}"
                                    Text="{mi:Material Icon=Share}"
                                    TextColor="{DynamicResource Primary}"
                                    VerticalOptions="Center" />
                                <Label
                                    Text="{Binding ShareLabel}"
                                    Style="{StaticResource CaptionStyle}"
                                    FontFamily="{StaticResource SemiBoldFontFamily}"
                                    TextColor="{DynamicResource Primary}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border
                            Grid.Column="1"
                            Style="{StaticResource TestFlatCardStyle}"
                            IsVisible="{Binding CanDeleteEntry}"
                            Margin="0"
                            Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DeleteMoodCommand}" />
                            </Border.GestureRecognizers>
                            <Border.Behaviors>
                                <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                            </Border.Behaviors>
                            <HorizontalStackLayout
                                Spacing="8"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Label
                                    Style="{StaticResource IconActionStyle}"
                                    Text="{mi:Material Icon=Delete}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                    VerticalOptions="Center" />
                                <Label
                                    Text="{Binding DeleteLabel}"
                                    Style="{StaticResource CaptionStyle}"
                                    FontFamily="{StaticResource SemiBoldFontFamily}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
