<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageJournal.JournalOverview.JournalOverviewPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:moodTrend="clr-namespace:PsychologyApp.Presentation.Widgets.Profile"
             xmlns:journalStrip="clr-namespace:PsychologyApp.Presentation.Widgets.Journal"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageJournal.JournalOverview"
             x:Name="OverviewRoot"
             x:DataType="vm:JournalOverviewViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout
            Margin="{StaticResource LayoutPageMarginThickness}"
            Spacing="{StaticResource LayoutSpacing}">
            <VerticalStackLayout.Behaviors>
                <behaviors:StaggerChildrenBehavior />
            </VerticalStackLayout.Behaviors>

            <ui:NavigationBarExtendedView
                TitleText="{Binding PageTitle}"
                BackCommand="{Binding BackCommand}"
                ExtensionText="{Binding ExportLabel}"
                ExtensionCommand="{Binding ExportCommand}" />

            <Border Style="{StaticResource HeroCardStyle}" Margin="0">
                <Border.Behaviors>
                    <behaviors:RevealOnAppearingBehavior />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                    <Label
                        Text="{Binding WeekRangeSubtitle}"
                        Style="{StaticResource CaptionStyle}"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label
                        Text="{Binding OverviewInsightText}"
                        Style="{StaticResource BodyStyle}" />
                    <Label
                        IsVisible="{Binding HasPracticeMoodInsight}"
                        Text="{Binding PracticeMoodInsightText}"
                        Style="{StaticResource CaptionStyle}"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource BrandCardStyle}" Margin="0">
                <Border.Behaviors>
                    <behaviors:ListItemRevealBehavior RevealIndex="0" />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                    <ui:FilterChipTabBarView
                        ItemsSource="{Binding CalendarScaleFilters}"
                        TapCommand="{Binding SelectCalendarScaleCommand}" />

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource CompactSpacing}">
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource IconActionStyle}"
                            WidthRequest="40"
                            VerticalOptions="Center"
                            Text="{mi:Material Icon=KeyboardArrowLeft}"
                            SemanticProperties.Description="{Binding PeriodNavPrevLabel}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PrevPeriodCommand}" />
                            </Label.GestureRecognizers>
                            <Label.Behaviors>
                                <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                            </Label.Behaviors>
                        </Label>
                        <Label
                            Grid.Column="1"
                            Text="{Binding PeriodTitle}"
                            Style="{StaticResource SectionTitleStyle}"
                            HorizontalTextAlignment="Center"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="2"
                            Style="{StaticResource IconActionStyle}"
                            WidthRequest="40"
                            VerticalOptions="Center"
                            IsEnabled="{Binding CanGoNextPeriod}"
                            Opacity="0.35"
                            Text="{mi:Material Icon=KeyboardArrowRight}"
                            SemanticProperties.Description="{Binding PeriodNavNextLabel}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding CanGoNextPeriod}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Label.Triggers>
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NextPeriodCommand}" />
                            </Label.GestureRecognizers>
                            <Label.Behaviors>
                                <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                            </Label.Behaviors>
                        </Label>
                    </Grid>

                    <journalStrip:JournalWeekStripView
                        IsVisible="{Binding IsWeekScale}"
                        CaptionText=""
                        ItemsSource="{Binding WeekDays}"
                        SelectDayCommand="{Binding SelectDayCommand}"
                        IsInteractive="True" />
                    <journalStrip:JournalMonthGridView
                        IsVisible="{Binding IsMonthScale}"
                        CaptionText=""
                        ItemsSource="{Binding MonthCells}"
                        SelectDayCommand="{Binding SelectDayCommand}" />
                    <journalStrip:JournalYearHeatmapView
                        IsVisible="{Binding IsYearScale}"
                        CaptionText=""
                        ItemsSource="{Binding YearCells}"
                        SelectDayCommand="{Binding SelectDayCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource BrandCardStyle}" Margin="0">
                <Border.Behaviors>
                    <behaviors:ListItemRevealBehavior RevealIndex="1" />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                    <ui:FilterChipTabBarView
                        ItemsSource="{Binding RangeFilters}"
                        TapCommand="{Binding SelectRangeCommand}" />

                    <Grid
                        IsVisible="{Binding HasMoodStats}"
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="{StaticResource CompactSpacing}">
                        <ui:MetricTileView
                            Grid.Column="0"
                            ValueText="{Binding CheckInCountDisplay}"
                            LabelText="{Binding WeekMoodCheckInsLabel}" />
                        <ui:MetricTileView
                            Grid.Column="1"
                            ValueText="{Binding AverageMoodDisplay}"
                            LabelText="{Binding WeekAvgMoodLabel}" />
                        <ui:MetricTileView
                            Grid.Column="2"
                            ValueText="{Binding MoodStreakDisplay}"
                            LabelText="{Binding StreakMetricLabel}" />
                    </Grid>

                    <Label
                        IsVisible="{Binding HasBestWorstPill}"
                        Text="{Binding BestWorstLabel}"
                        Style="{StaticResource CaptionStyle}"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                    <FlexLayout
                        IsVisible="{Binding HasFactorPills}"
                        Wrap="Wrap"
                        Direction="Row"
                        AlignItems="Start"
                        JustifyContent="Start"
                        BindableLayout.ItemsSource="{Binding ActivityPills}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Style="{StaticResource MetaPillStyle}" Margin="0,0,8,8">
                                    <Label
                                        Text="{Binding .}"
                                        Style="{StaticResource CaptionStyle}"
                                        TextColor="{DynamicResource Primary}"
                                        FontFamily="{StaticResource SemiBoldFontFamily}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                <ui:SectionHeaderView TitleText="{Binding MoodTrendTitle}" />
                <ui:EmptyStateView
                    IsVisible="{Binding ShowMoodTrendHint}"
                    BodyText="{Binding MoodTrendHint}"
                    IconName="SelfImprovement" />
                <moodTrend:MoodTrendChartView
                    IsVisible="{Binding HasMoodTrendChart}"
                    ChartPoints="{Binding MoodChartPoints}"
                    Subtitle="{Binding MoodChartSubtitle}"
                    Title="" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
