<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageProfile.ProfileOptions.OptionsPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageProfile.ProfileOptions"
             x:DataType="vm:OptionsViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <!-- Rows grouped in cards, as the phone's own settings: a card with an icon tile for every row made seven heavy blocks. -->
    <Grid
        Margin="{StaticResource LayoutPageMarginThickness}"
        RowDefinitions="Auto,*"
        RowSpacing="{StaticResource LayoutSpacing}">
        <ui:NavigationBarSimpleView
            Grid.Row="0"
            TitleText="{Binding PageTitle}"
            BackCommand="{Binding BackCommand}" />

        <ScrollView
            Grid.Row="1"
            VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding AppSectionTitle}" Style="{StaticResource CaptionStyle}" Margin="4,0" />
                    <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0">
                        <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="52"
                              SemanticProperties.Description="{Binding SettingsTitle}">
                            <Grid.Behaviors>
                                <behaviors:PressFeedbackBehavior />
                            </Grid.Behaviors>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSettingsPageCommand}" />
                            </Grid.GestureRecognizers>
                            <ui:MaterialIconView IconName="Tune" IconSize="20" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding SettingsTitle}" Style="{StaticResource BodyStyle}" />
                                <Label Text="{Binding SettingsSubtitle}" Style="{StaticResource CaptionStyle}" MaxLines="1" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        <BoxView Style="{StaticResource SettingRowDividerStyle}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="52"
                              SemanticProperties.Description="{Binding DataBackupTitle}">
                            <Grid.Behaviors>
                                <behaviors:PressFeedbackBehavior />
                            </Grid.Behaviors>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenDataBackupCommand}" />
                            </Grid.GestureRecognizers>
                            <ui:MaterialIconView IconName="Backup" IconSize="20" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding DataBackupTitle}" Style="{StaticResource BodyStyle}" />
                                <Label Text="{Binding DataBackupSubtitle}" Style="{StaticResource CaptionStyle}" MaxLines="1" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding SafetySectionTitle}" Style="{StaticResource CaptionStyle}" Margin="4,0" />
                    <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0">
                        <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="52"
                              SemanticProperties.Description="{Binding CrisisTitle}">
                            <Grid.Behaviors>
                                <behaviors:PressFeedbackBehavior />
                            </Grid.Behaviors>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCrisisHubCommand}" />
                            </Grid.GestureRecognizers>
                            <ui:MaterialIconView IconName="HealthAndSafety" IconSize="20" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding CrisisTitle}" Style="{StaticResource BodyStyle}" />
                                <Label Text="{Binding CrisisSubtitle}" Style="{StaticResource CaptionStyle}" MaxLines="1" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding SupportSectionTitle}" Style="{StaticResource CaptionStyle}" Margin="4,0" />
                    <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0">
                        <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="52"
                              SemanticProperties.Description="{Binding FeedbackTitle}">
                            <Grid.Behaviors>
                                <behaviors:PressFeedbackBehavior />
                            </Grid.Behaviors>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenFeedbackPageCommand}" />
                            </Grid.GestureRecognizers>
                            <ui:MaterialIconView IconName="Feedback" IconSize="20" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding FeedbackTitle}" Style="{StaticResource BodyStyle}" />
                                <Label Text="{Binding FeedbackSubtitle}" Style="{StaticResource CaptionStyle}" MaxLines="1" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        <BoxView Style="{StaticResource SettingRowDividerStyle}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="52"
                              SemanticProperties.Description="{Binding DonateTitle}">
                            <Grid.Behaviors>
                                <behaviors:PressFeedbackBehavior />
                            </Grid.Behaviors>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenDonatePageCommand}" />
                            </Grid.GestureRecognizers>
                            <ui:MaterialIconView IconName="VolunteerActivism" IconSize="20" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding DonateTitle}" Style="{StaticResource BodyStyle}" />
                                <Label Text="{Binding DonateSubtitle}" Style="{StaticResource CaptionStyle}" MaxLines="1" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        <BoxView Style="{StaticResource SettingRowDividerStyle}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="52"
                              SemanticProperties.Description="{Binding AboutTitle}">
                            <Grid.Behaviors>
                                <behaviors:PressFeedbackBehavior />
                            </Grid.Behaviors>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenAboutPageCommand}" />
                            </Grid.GestureRecognizers>
                            <ui:MaterialIconView IconName="Psychology" IconSize="20" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding AboutTitle}" Style="{StaticResource BodyStyle}" />
                                <Label Text="{Binding AboutSubtitle}" Style="{StaticResource CaptionStyle}" MaxLines="1" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        <BoxView Style="{StaticResource SettingRowDividerStyle}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" MinimumHeightRequest="52"
                              SemanticProperties.Description="{Binding AliceTitle}">
                            <Grid.Behaviors>
                                <behaviors:PressFeedbackBehavior />
                            </Grid.Behaviors>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenAlicePageCommand}" />
                            </Grid.GestureRecognizers>
                            <ui:MaterialIconView IconName="SmartToy" IconSize="20" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding AliceTitle}" Style="{StaticResource BodyStyle}" />
                                <Label Text="{Binding AliceSubtitle}" Style="{StaticResource CaptionStyle}" MaxLines="1" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="18" VerticalOptions="Center" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
