<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageProfile.ProfileOptions.OptionsPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageProfile.ProfileOptions"
             x:DataType="vm:OptionsViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <Grid
        Margin="{StaticResource LayoutPageMarginThickness}"
        RowDefinitions="Auto,*"
        RowSpacing="{StaticResource LayoutSpacing}">
        <ui:NavigationBarSimpleView
            Grid.Row="0"
            TitleText="{Binding PageTitle}"
            BackCommand="{Binding BackCommand}" />

        <ScrollView
            Grid.Row="1"
            VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">
                <VerticalStackLayout.Behaviors>
                    <behaviors:StaggerChildrenBehavior />
                </VerticalStackLayout.Behaviors>

                <Label
                    Text="{Binding AppSectionTitle}"
                    Style="{StaticResource SectionTitleStyle}" />

                <ui:SettingsLinkCardView
                    Title="{Binding SettingsTitle}"
                    Subtitle="{Binding SettingsSubtitle}"
                    TapCommand="{Binding OpenSettingsPageCommand}">
                    <ui:SettingsLinkCardView.Behaviors>
                        <behaviors:ListItemRevealBehavior RevealIndex="0" />
                    </ui:SettingsLinkCardView.Behaviors>
                </ui:SettingsLinkCardView>

                <ui:SettingsLinkCardView
                    Title="{Binding AliceTitle}"
                    Subtitle="{Binding AliceSubtitle}"
                    TapCommand="{Binding OpenAlicePageCommand}">
                    <ui:SettingsLinkCardView.Behaviors>
                        <behaviors:ListItemRevealBehavior RevealIndex="1" />
                    </ui:SettingsLinkCardView.Behaviors>
                </ui:SettingsLinkCardView>

                <Label
                    Text="{Binding SafetySectionTitle}"
                    Style="{StaticResource SectionTitleStyle}" />

                <ui:SettingsLinkCardView
                    Title="{Binding CrisisTitle}"
                    Subtitle="{Binding CrisisSubtitle}"
                    TapCommand="{Binding OpenCrisisHubCommand}">
                    <ui:SettingsLinkCardView.Behaviors>
                        <behaviors:ListItemRevealBehavior RevealIndex="2" />
                    </ui:SettingsLinkCardView.Behaviors>
                </ui:SettingsLinkCardView>

                <Label
                    Text="{Binding SupportSectionTitle}"
                    Style="{StaticResource SectionTitleStyle}" />

                <ui:SettingsLinkCardView
                    Title="{Binding FeedbackTitle}"
                    Subtitle="{Binding FeedbackSubtitle}"
                    TapCommand="{Binding OpenFeedbackPageCommand}">
                    <ui:SettingsLinkCardView.Behaviors>
                        <behaviors:ListItemRevealBehavior RevealIndex="3" />
                    </ui:SettingsLinkCardView.Behaviors>
                </ui:SettingsLinkCardView>

                <ui:SettingsLinkCardView
                    Title="{Binding DonateTitle}"
                    Subtitle="{Binding DonateSubtitle}"
                    TapCommand="{Binding OpenDonatePageCommand}">
                    <ui:SettingsLinkCardView.Behaviors>
                        <behaviors:ListItemRevealBehavior RevealIndex="4" />
                    </ui:SettingsLinkCardView.Behaviors>
                </ui:SettingsLinkCardView>

                <ui:SettingsLinkCardView
                    Title="{Binding AboutTitle}"
                    Subtitle="{Binding AboutSubtitle}"
                    TapCommand="{Binding OpenAboutPageCommand}">
                    <ui:SettingsLinkCardView.Behaviors>
                        <behaviors:ListItemRevealBehavior RevealIndex="5" />
                    </ui:SettingsLinkCardView.Behaviors>
                </ui:SettingsLinkCardView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
