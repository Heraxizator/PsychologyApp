<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageProfile.ProfileInfo.InfoPage"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageProfile.ProfileInfo"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:DataType="vm:InfoViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">
    <Grid
        Margin="{StaticResource LayoutPageMarginThickness}"
        RowDefinitions="Auto,*"
        RowSpacing="{StaticResource CompactSpacing}">
        <ui:NavigationBarSimpleView
            Grid.Row="0"
            BackCommand="{Binding BackCommand}"
            TitleText="{Binding PageTitle}" />

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}" Padding="0,0,0,8">
                <VerticalStackLayout.Behaviors>
                    <behaviors:StaggerChildrenBehavior />
                </VerticalStackLayout.Behaviors>

                <Border Style="{StaticResource BrandCardStyle}" Margin="0">
                    <VerticalStackLayout Spacing="{StaticResource SectionSpacing}">
                        <Label
                            Text="{Binding AboutBody}"
                            Style="{StaticResource BodyStyle}" />
                        <BoxView Style="{StaticResource SubtleDividerStyle}" />
                        <Label
                            Text="{Binding AppVersionText}"
                            Style="{StaticResource CaptionStyle}"
                            TextColor="{DynamicResource Primary}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
