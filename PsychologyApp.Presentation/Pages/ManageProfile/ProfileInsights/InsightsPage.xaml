<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageProfile.ProfileInsights.InsightsPage"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageProfile.ProfileInsights"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:DataType="vm:InsightsViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Behaviors>
        <behaviors:PageAnalyticsBehavior />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <!-- One finding: what, how much, an optional note and, for a test due again, the way to retake it. -->
        <DataTemplate x:Key="InsightTemplate" x:DataType="vm:InsightItem">
            <VerticalStackLayout Spacing="4" Padding="0,6" SemanticProperties.Description="{Binding Title}">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Command}" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="{Binding Title}" Style="{StaticResource BodyStyle}" FontFamily="{StaticResource MediumFontFamily}" />
                <Label Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Style="{StaticResource CaptionStyle}" />
                <Label Text="{Binding Note}" IsVisible="{Binding HasNote}" Style="{StaticResource CaptionStyle}" />
                <ui:ButtonView IsVisible="{Binding HasAction}" Variant="Secondary" BodyText="{Binding ActionText}" TapCommand="{Binding Command}" Margin="0,6,0,0" />
            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>

    <!-- Opened over the tabs: the same back arrow and title as every other pushed page, instead of the system bar. -->
    <Grid RowDefinitions="Auto,*">
        <ui:NavigationBarSimpleView
            Grid.Row="0"
            Margin="20,0"
            BackCommand="{Binding BackCommand}"
            TitleText="{Binding PageTitle}" />

    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Margin="{StaticResource LayoutTabPageMarginThickness}" Spacing="{StaticResource LayoutSpacing}">
            <Label Text="{Binding LeadText}" Style="{StaticResource CaptionStyle}" Margin="4,0" />
            <!-- A card only for what there is to show, each with its icon; the hints of the empty ones are quiet lines at the end, so
                 a new person meets one short page instead of three cards that each say "nothing yet". -->
            <Border Style="{StaticResource BrandCardStyle}" Margin="0" Padding="18,16" IsVisible="{Binding HasPractices}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Style="{StaticResource IconTileStyle}" WidthRequest="36" HeightRequest="36">
                            <ui:MaterialIconView IconName="SelfImprovement" IconSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding PracticesTitle}" Style="{StaticResource SectionTitleStyle}" VerticalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Practices}" BindableLayout.ItemTemplate="{StaticResource InsightTemplate}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource BrandCardStyle}" Margin="0" Padding="18,16" IsVisible="{Binding HasTests}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Style="{StaticResource IconTileStyle}" WidthRequest="36" HeightRequest="36">
                            <ui:MaterialIconView IconName="FactCheck" IconSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding TestsTitle}" Style="{StaticResource SectionTitleStyle}" VerticalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Tests}" BindableLayout.ItemTemplate="{StaticResource InsightTemplate}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource BrandCardStyle}" Margin="0" Padding="18,16" IsVisible="{Binding HasMoods}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Style="{StaticResource IconTileStyle}" WidthRequest="36" HeightRequest="36">
                            <ui:MaterialIconView IconName="SentimentSatisfied" IconSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding MoodTitle}" Style="{StaticResource SectionTitleStyle}" VerticalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Moods}" BindableLayout.ItemTemplate="{StaticResource InsightTemplate}" />
                    <Label Text="{Binding MoodNote}" Style="{StaticResource CaptionStyle}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource BrandCardStyle}" Margin="0" Padding="18,16" IsVisible="{Binding HasBody}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Style="{StaticResource IconTileStyle}" WidthRequest="36" HeightRequest="36">
                            <ui:MaterialIconView IconName="Accessibility" IconSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding BodyTitle}" Style="{StaticResource SectionTitleStyle}" VerticalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding BodyPatterns}" BindableLayout.ItemTemplate="{StaticResource InsightTemplate}" />
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout Spacing="10" Margin="4,0">
                <Label Text="{Binding PracticesEmptyText}" IsVisible="{Binding ShowPracticesEmpty}" Style="{StaticResource CaptionStyle}" />
                <Label Text="{Binding TestsEmptyText}" IsVisible="{Binding ShowTestsEmpty}" Style="{StaticResource CaptionStyle}" />
                <Label Text="{Binding MoodEmptyText}" IsVisible="{Binding ShowMoodsEmpty}" Style="{StaticResource CaptionStyle}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
