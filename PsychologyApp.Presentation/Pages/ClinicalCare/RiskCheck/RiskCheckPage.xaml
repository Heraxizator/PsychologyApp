<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ClinicalCare.RiskCheck.RiskCheckPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ClinicalCare.RiskCheck"
             x:DataType="vm:RiskCheckViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <Grid
        Padding="{StaticResource LayoutPageMarginThickness}"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="{StaticResource LayoutSpacing}">

        <ui:NavigationBarSimpleView
            Grid.Row="0"
            TitleText="{Binding PageTitle}"
            BackCommand="{Binding BackCommand}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">
                <VerticalStackLayout.Behaviors>
                    <behaviors:StaggerChildrenBehavior />
                </VerticalStackLayout.Behaviors>

                <Border Style="{StaticResource HeroCardStyle}">
                    <Border.Behaviors>
                        <behaviors:RevealOnAppearingBehavior />
                    </Border.Behaviors>
                    <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                        <Label Text="{Binding LeadText}" Style="{StaticResource BodyStyle}" />
                        <Label Text="{Binding Subtitle}" Style="{StaticResource CaptionStyle}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource BrandCardStyle}">
                    <Border.Behaviors>
                        <behaviors:ListItemRevealBehavior RevealIndex="1" />
                    </Border.Behaviors>
                    <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">
                        <ui:YesNoSelectorView
                            LabelText="{Binding SelfHarmLabel}"
                            YesText="{Binding YesLabel}"
                            NoText="{Binding NoLabel}"
                            IsYes="{Binding IsSelfHarmYes}"
                            IsNo="{Binding IsSelfHarmNo}"
                            SelectCommand="{Binding SetSelfHarmCommand}" />
                        <BoxView Style="{StaticResource SubtleDividerStyle}" />
                        <ui:YesNoSelectorView
                            LabelText="{Binding DisorientationLabel}"
                            YesText="{Binding YesLabel}"
                            NoText="{Binding NoLabel}"
                            IsYes="{Binding IsDisorientationYes}"
                            IsNo="{Binding IsDisorientationNo}"
                            SelectCommand="{Binding SetDisorientationCommand}" />
                        <BoxView Style="{StaticResource SubtleDividerStyle}" />
                        <ui:YesNoSelectorView
                            LabelText="{Binding SubstanceLabel}"
                            YesText="{Binding YesLabel}"
                            NoText="{Binding NoLabel}"
                            IsYes="{Binding IsSubstanceYes}"
                            IsNo="{Binding IsSubstanceNo}"
                            SelectCommand="{Binding SetSubstanceCommand}" />
                        <BoxView Style="{StaticResource SubtleDividerStyle}" />
                        <ui:YesNoSelectorView
                            LabelText="{Binding InsomniaLabel}"
                            YesText="{Binding YesLabel}"
                            NoText="{Binding NoLabel}"
                            IsYes="{Binding IsInsomniaYes}"
                            IsNo="{Binding IsInsomniaNo}"
                            SelectCommand="{Binding SetInsomniaCommand}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout
            Grid.Row="2"
            Spacing="{StaticResource CompactSpacing}">
            <ui:ButtonView
                IsVisible="{Binding ShowOpenHelpNow}"
                BodyText="{Binding OpenHelpNowText}"
                TapCommand="{Binding OpenHelpNowCommand}"
                Variant="Primary" />
            <ui:ButtonView
                BodyText="{Binding SubmitText}"
                TapCommand="{Binding SubmitCommand}"
                Variant="Primary">
                <ui:ButtonView.Triggers>
                    <DataTrigger
                        TargetType="ui:ButtonView"
                        Binding="{Binding ShowOpenHelpNow}"
                        Value="True">
                        <Setter Property="Variant" Value="Secondary" />
                    </DataTrigger>
                </ui:ButtonView.Triggers>
            </ui:ButtonView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
