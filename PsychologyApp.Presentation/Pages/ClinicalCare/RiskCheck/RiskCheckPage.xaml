<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ClinicalCare.RiskCheck.RiskCheckPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ClinicalCare.RiskCheck"
             x:DataType="vm:RiskCheckViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <Grid
        Padding="{StaticResource LayoutPageMarginThickness}"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="{StaticResource LayoutSpacing}">

        <ui:NavigationBarSimpleView
            Grid.Row="0"
            TitleText="{Binding PageTitle}"
            BackCommand="{Binding BackCommand}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">
                <VerticalStackLayout.Behaviors>
                    <behaviors:StaggerChildrenBehavior />
                </VerticalStackLayout.Behaviors>

                <Border Style="{StaticResource HeroCardStyle}">
                    <Border.Behaviors>
                        <behaviors:RevealOnAppearingBehavior />
                    </Border.Behaviors>
                    <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                        <Label Text="{Binding LeadText}" Style="{StaticResource BodyStyle}" />
                        <Label Text="{Binding Subtitle}" Style="{StaticResource CaptionStyle}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource BrandCardStyle}">
                    <Border.Behaviors>
                        <behaviors:ListItemRevealBehavior RevealIndex="1" />
                    </Border.Behaviors>
                    <VerticalStackLayout Spacing="{StaticResource SectionSpacing}">
                        <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                            <Label Text="{Binding SelfHarmLabel}" Style="{StaticResource BodyStyle}" />
                            <HorizontalStackLayout Spacing="{StaticResource CompactSpacing}">
                                <Border Style="{StaticResource MetaPillStyle}" MinimumWidthRequest="72" Padding="16,8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelfHarmYes}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetSelfHarmCommand}" CommandParameter="yes" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                                    </Border.Behaviors>
                                    <Label Text="{Binding YesLabel}" Style="{StaticResource CaptionStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" />
                                </Border>
                                <Border Style="{StaticResource MetaPillStyle}" MinimumWidthRequest="72" Padding="16,8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelfHarmNo}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetSelfHarmCommand}" CommandParameter="no" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                                    </Border.Behaviors>
                                    <Label Text="{Binding NoLabel}" Style="{StaticResource CaptionStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" />
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource InputBorderDark}}" />

                        <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                            <Label Text="{Binding DisorientationLabel}" Style="{StaticResource BodyStyle}" />
                            <HorizontalStackLayout Spacing="{StaticResource CompactSpacing}">
                                <Border Style="{StaticResource MetaPillStyle}" MinimumWidthRequest="72" Padding="16,8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsDisorientationYes}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetDisorientationCommand}" CommandParameter="yes" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                                    </Border.Behaviors>
                                    <Label Text="{Binding YesLabel}" Style="{StaticResource CaptionStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" />
                                </Border>
                                <Border Style="{StaticResource MetaPillStyle}" MinimumWidthRequest="72" Padding="16,8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsDisorientationNo}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetDisorientationCommand}" CommandParameter="no" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                                    </Border.Behaviors>
                                    <Label Text="{Binding NoLabel}" Style="{StaticResource CaptionStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" />
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource InputBorderDark}}" />

                        <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                            <Label Text="{Binding SubstanceLabel}" Style="{StaticResource BodyStyle}" />
                            <HorizontalStackLayout Spacing="{StaticResource CompactSpacing}">
                                <Border Style="{StaticResource MetaPillStyle}" MinimumWidthRequest="72" Padding="16,8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSubstanceYes}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetSubstanceCommand}" CommandParameter="yes" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                                    </Border.Behaviors>
                                    <Label Text="{Binding YesLabel}" Style="{StaticResource CaptionStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" />
                                </Border>
                                <Border Style="{StaticResource MetaPillStyle}" MinimumWidthRequest="72" Padding="16,8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSubstanceNo}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetSubstanceCommand}" CommandParameter="no" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                                    </Border.Behaviors>
                                    <Label Text="{Binding NoLabel}" Style="{StaticResource CaptionStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" />
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource InputBorderDark}}" />

                        <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                            <Label Text="{Binding InsomniaLabel}" Style="{StaticResource BodyStyle}" />
                            <HorizontalStackLayout Spacing="{StaticResource CompactSpacing}">
                                <Border Style="{StaticResource MetaPillStyle}" MinimumWidthRequest="72" Padding="16,8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsInsomniaYes}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetInsomniaCommand}" CommandParameter="yes" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                                    </Border.Behaviors>
                                    <Label Text="{Binding YesLabel}" Style="{StaticResource CaptionStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" />
                                </Border>
                                <Border Style="{StaticResource MetaPillStyle}" MinimumWidthRequest="72" Padding="16,8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsInsomniaNo}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetInsomniaCommand}" CommandParameter="no" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                                    </Border.Behaviors>
                                    <Label Text="{Binding NoLabel}" Style="{StaticResource CaptionStyle}" FontFamily="{StaticResource SemiBoldFontFamily}" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" />
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout
            Grid.Row="2"
            Spacing="{StaticResource CompactSpacing}">
            <ui:ButtonView
                IsVisible="{Binding ShowOpenHelpNow}"
                BodyText="{Binding OpenHelpNowText}"
                TapCommand="{Binding OpenHelpNowCommand}"
                Variant="Primary" />
            <ui:ButtonView
                BodyText="{Binding SubmitText}"
                TapCommand="{Binding SubmitCommand}"
                Variant="Secondary" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
