<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ClinicalCare.CrisisHub.CrisisHubPage"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ClinicalCare.CrisisHub"
             x:DataType="vm:CrisisHubViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout
            Margin="{StaticResource LayoutPageMarginThickness}"
            Spacing="{StaticResource LayoutSpacing}">
            <VerticalStackLayout.Behaviors>
                <behaviors:StaggerChildrenBehavior />
            </VerticalStackLayout.Behaviors>

            <ui:NavigationBarSimpleView
                TitleText="{Binding PageTitle}"
                BackCommand="{Binding BackCommand}" />

            <Border Style="{StaticResource BrandCardStyle}">
                <Border.Behaviors>
                    <behaviors:RevealOnAppearingBehavior />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="{StaticResource SectionSpacing}">
                    <ui:MaterialIconView
                        IconName="HealthAndSafety"
                        IconSize="32"
                        IconColor="{DynamicResource Primary}"
                        HorizontalOptions="Center" />
                    <Label Text="{Binding LeadText}" Style="{StaticResource BodyStyle}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding SpecialistHint}" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <ui:SectionHeaderView TitleText="{Binding SafetyPlanTitle}" />
            <Border Style="{StaticResource BrandCardStyle}">
                <Border.Behaviors>
                    <behaviors:ListItemRevealBehavior RevealIndex="1" />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                    <Label Text="{Binding SafetyPlanStep1}" Style="{StaticResource BodyStyle}" />
                    <Label Text="{Binding SafetyPlanStep2}" Style="{StaticResource BodyStyle}" />
                    <Label Text="{Binding SafetyPlanStep3}" Style="{StaticResource BodyStyle}" />
                </VerticalStackLayout>
            </Border>

            <ui:SectionHeaderView TitleText="{Binding HotlineTitle}" />
            <Border Style="{StaticResource BrandCardStyle}">
                <Border.Behaviors>
                    <behaviors:ListItemRevealBehavior RevealIndex="2" />
                </Border.Behaviors>
                <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
                    <Label Text="{Binding HotlineRu}" Style="{StaticResource BodyStyle}" />
                    <Label Text="{Binding HotlineIntl}" Style="{StaticResource CaptionStyle}" />
                    <ui:ButtonView
                        BodyText="{Binding CallHotlineRuText}"
                        TapCommand="{Binding CallHotlineRuCommand}"
                        Variant="Primary"
                        IsCompact="True" />
                    <ui:ButtonView
                        BodyText="{Binding CallEmergencyText}"
                        TapCommand="{Binding CallEmergencyCommand}"
                        Variant="Secondary"
                        IsCompact="True" />
                </VerticalStackLayout>
            </Border>

            <ui:ButtonView
                BodyText="{Binding OpenHelplineText}"
                TapCommand="{Binding OpenHelplineCommand}"
                Variant="Secondary">
                <ui:ButtonView.Behaviors>
                    <behaviors:ListItemRevealBehavior RevealIndex="3" />
                </ui:ButtonView.Behaviors>
            </ui:ButtonView>

            <ui:ButtonView
                BodyText="{Binding RecheckText}"
                TapCommand="{Binding RecheckCommand}"
                Variant="Secondary">
                <ui:ButtonView.Behaviors>
                    <behaviors:ListItemRevealBehavior RevealIndex="4" />
                </ui:ButtonView.Behaviors>
            </ui:ButtonView>

            <ui:ButtonView
                IsVisible="{Binding ShowContinueSoft}"
                Variant="Secondary"
                BodyText="{Binding ContinueSoftText}"
                TapCommand="{Binding ContinueSoftCommand}">
                <ui:ButtonView.Behaviors>
                    <behaviors:ListItemRevealBehavior RevealIndex="5" />
                </ui:ButtonView.Behaviors>
            </ui:ButtonView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
