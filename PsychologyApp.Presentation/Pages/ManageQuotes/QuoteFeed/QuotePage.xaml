<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Pages.ManageQuotes.QuoteFeed.QuotePage"
             xmlns:vm="clr-namespace:PsychologyApp.Presentation.Pages.ManageQuotes.QuoteFeed"
             xmlns:quotes="clr-namespace:PsychologyApp.Presentation.Entities.Quote"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:quoteCard="clr-namespace:PsychologyApp.Presentation.Widgets.QuoteCard"
             xmlns:dailyHero="clr-namespace:PsychologyApp.Presentation.Widgets.DailyQuoteHero"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:DataType="vm:QuoteViewModel"
             Shell.NavBarIsVisible="False"
             x:Name="page"
             Title="{Binding PageTitle}">

    <!-- Opened over the tabs: the same back arrow and title as every other pushed page, instead of the system bar. -->
    <Grid RowDefinitions="Auto,*">
        <ui:NavigationBarSimpleView
            Grid.Row="0"
            Margin="20,0"
            BackCommand="{Binding BackCommand}"
            TitleText="{Binding PageTitle}" />

    <Grid Grid.Row="1"
        VerticalOptions="FillAndExpand"
        HorizontalOptions="FillAndExpand">

        <RefreshView
            x:Name="QuotesRefresh"
            IsVisible="{Binding IsDone}"
            Refreshing="OnPullToRefresh">
            <Grid
                Margin="{StaticResource LayoutTabPageMarginThickness}"
                RowDefinitions="Auto,*">

                <VerticalStackLayout
                    Grid.Row="0"
                    Spacing="{StaticResource PracticeListItemSpacing}"
                    Margin="0,0,0,8">
                    <!-- The themes hide behind the button beside the search: two rows of chips over the list were the loudest part of it. -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ui:TextEntryView
                            PlaceholderText="{Binding SearchPlaceholder}"
                            BodyText="{Binding SearchQuery, Mode=TwoWay}"
                            SemanticProperties.Description="{Binding SearchPlaceholder}" />
                        <Border
                            Grid.Column="1"
                            WidthRequest="48"
                            HeightRequest="48"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            SemanticProperties.Description="{Binding ThemesToggleText}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsThemeFiltersVisible}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleThemesCommand}" />
                            </Border.GestureRecognizers>
                            <ui:MaterialIconView
                                IconName="Tune"
                                IconSize="22"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </Border>
                    </Grid>

                    <ui:ProgressBarView
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
            Padding="24,8"
                        x:Name="SearchFilteringProgress"
                        IsVisible="{Binding IsSearchFilteringVisible}"
                        IsLoading="{Binding IsSearchFilteringVisible}"
                        ProgressText="{Binding SearchFilteringText}"
                        CancelCommand="{Binding CancelSearchCommand}"
                        VerticalOptions="Center"
                        HorizontalOptions="Center" />

                    <ui:FilterChipTabBarView
                        x:Name="FeedFilterBar"
                        IsVisible="{Binding IsFeedFiltersVisible}"
                        ItemsSource="{Binding FeedFilters}"
                        TapCommand="{Binding SelectFeedCommand}"
                        SemanticProperties.Description="{Binding FeedAllLabel}" />

                    <ui:FilterChipTabBarView
                        x:Name="ThemeFilterBar"
                        IsVisible="{Binding IsThemeFiltersVisible}"
                        ItemsSource="{Binding ThemeFilters}"
                        TapCommand="{Binding SelectThemeCommand}"
                        SemanticProperties.Description="{Binding ThemeAllLabel}" />
                </VerticalStackLayout>

                <CollectionView
                    Grid.Row="1"
                    x:Name="QuotesCollectionView"
                    IsVisible="{Binding IsQuoteListVisible}"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Never"
                    VerticalOptions="FillAndExpand"
                    SelectionMode="None"
                    RemainingItemsThreshold="2"
                    RemainingItemsThresholdReached="OnRemainingItemsThresholdReached"
                    ItemsSource="{Binding DisplayItems}">

                    <CollectionView.Behaviors>
                        <behaviors:RevealOnAppearingBehavior RevealOnTabAppearOnly="True" />
                    </CollectionView.Behaviors>

                    <CollectionView.Header>
                        <VerticalStackLayout
                            BindingContext="{Binding BindingContext, Source={x:Reference page}, x:DataType=vm:QuotePage}">
                            <dailyHero:DailyQuoteHeroView
                                IsVisible="{Binding ShowDailyQuoteHeader}"
                                CaptionText="{Binding DailyQuoteTitle}"
                                QuoteText="{Binding DailyQuoteText}"
                                AuthorText="{Binding DailyQuoteAuthor}"
                                IsFavourite="{Binding DailyQuoteIsFavourite}"
                                LikeCommand="{Binding DailyQuoteLikeCommand}"
                                CopyCommand="{Binding DailyQuoteCopyCommand}"
                                ShareCommand="{Binding DailyQuoteShareCommand}" />
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout
                            Orientation="Vertical"
                            ItemSpacing="{StaticResource ListItemSpacing}" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="quotes:QuoteItem">
                            <quoteCard:QuoteCardView
                                Text="{Binding Text}"
                                Author="{Binding Author}"
                                IsFavourite="{Binding IsFavourite, Mode=TwoWay}"
                                LikeCommand="{Binding LikeCommand}"
                                CopyCommand="{Binding CopyCommand}"
                                ShareCommand="{Binding ShareCommand}"
                                MarkReadCommand="{Binding MarkReadCommand}">
                                <quoteCard:QuoteCardView.Behaviors>
                                    <behaviors:ListItemRevealBehavior />
                                </quoteCard:QuoteCardView.Behaviors>
                            </quoteCard:QuoteCardView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            Spacing="8"
                            BindingContext="{Binding BindingContext, Source={x:Reference page}, x:DataType=vm:QuotePage}">
                            <ui:EmptyStateView
                                TitleText="{Binding EmptyTitleText}"
                                BodyText="{Binding EmptyBodyText}"
                                IconName="{Binding EmptyIconName}"
                                ActionText="{Binding EmptyActionText}"
                                ActionCommand="{Binding EmptyActionCommand}" />
                            <ui:ButtonView
                                IsVisible="{Binding ShowAllReadEmpty}"
                                IsCompact="True"
                                BodyText="{Binding ShowAgainButtonText}"
                                TapCommand="{Binding ShowAgainCommand}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>
        </RefreshView>

        <ui:SkeletonView
            Kind="Cards"
            VerticalOptions="Start"
            Margin="20,120,20,0"
            IsActive="{Binding IsLoadingOverlayVisible}" />

        <ui:ProgressBarView
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
            Padding="24,8"
            x:Name="LoadingProgress"
            IsVisible="{Binding IsSlowLoadingVisible}"
            IsLoading="{Binding IsSlowLoadingVisible}"
            VerticalOptions="End"
            HorizontalOptions="Center"
            ProgressText="{Binding QuotesLoadingText}"
            CancelCommand="{Binding Cancel}" />

        <ui:RetryView
            VerticalOptions="Center"
            HorizontalOptions="Center"
            IsVisible="{Binding IsFail}"
            FailedText="{Binding LoadErrorText}"
            RetryText="{Binding RetryText}"
            RetryCommand="{Binding Reload}" />
    </Grid>

    </Grid>
</ContentPage>
