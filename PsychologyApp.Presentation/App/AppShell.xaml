<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="PsychologyApp.Presentation.App.AppShell"
       xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
       xmlns:common="clr-namespace:PsychologyApp.Presentation.Common;assembly=PsychologyApp.Presentation.Core"
       xmlns:app="clr-namespace:PsychologyApp.Presentation.App"
       xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
       xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
       NavigationPage.HasNavigationBar="False"
       FlyoutBehavior="Flyout"
       FlyoutWidth="300"
       FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
       Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
       Shell.TabBarForegroundColor="{StaticResource Primary}"
       Shell.TabBarTitleColor="{StaticResource Primary}"
       Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
       Shell.NavBarIsVisible="False">

    <Shell.Behaviors>
        <mct:StatusBarBehavior
            x:Name="StatusBar"
            StatusBarColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
            StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </Shell.Behaviors>

    <!-- The menu behind the burger: the profile as a card on top, my path, reading, support, then help (tinted) and the app's own pages. -->
    <Shell.FlyoutContent>
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="12,24,12,24" Spacing="4">
                <VerticalStackLayout.Resources>
                    <!-- A row: the icon on a tile of its group's colour. Help sits on that colour with a stronger label. -->
                    <DataTemplate x:Key="MenuEntryTemplate" x:DataType="app:AppMenuEntry">
                        <Border
                            Padding="10,8"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{Binding RowColor}"
                            SemanticProperties.Description="{Binding Title}">
                            <Border.Behaviors>
                                <behaviors:PressFeedbackBehavior />
                            </Border.Behaviors>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Command}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="{Binding TileColor}" VerticalOptions="Center">
                                    <ui:MaterialIconView IconName="{Binding Icon}" IconSize="20" IconColor="{Binding IconColor}" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource BodyStyle}" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsEmphasized}" Value="True">
                                            <Setter Property="FontFamily" Value="{StaticResource SemiBoldFontFamily}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <Style x:Key="MenuGroupTitleStyle" TargetType="Label" BasedOn="{StaticResource CaptionStyle}">
                        <Setter Property="Margin" Value="12,12,12,4" />
                    </Style>
                </VerticalStackLayout.Resources>

                <!-- The profile as a card instead of the app's name: the first thing in the menu is the person's own page. -->
                <Border
                    x:Name="MenuProfileCard"
                    x:DataType="app:AppMenuEntry"
                    Padding="12"
                    Margin="0,0,0,8"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                    StrokeShape="RoundRectangle 18"
                    SemanticProperties.Description="{Binding Title}">
                    <Border.Behaviors>
                        <behaviors:PressFeedbackBehavior />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Command}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 24" BackgroundColor="{Binding TileColor}" VerticalOptions="Center">
                            <ui:MaterialIconView IconName="{Binding Icon}" IconSize="26" IconColor="{Binding IconColor}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}" />
                            <Label x:Name="MenuProfileSubtitle" Style="{StaticResource CaptionStyle}" />
                        </VerticalStackLayout>
                        <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="22" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Label x:Name="MenuMineTitle" Style="{StaticResource MenuGroupTitleStyle}" />
                <VerticalStackLayout x:Name="MenuMine" Spacing="2" BindableLayout.ItemTemplate="{StaticResource MenuEntryTemplate}" />
                <!-- Support before reading: in a hard minute a thought to lean on is nearer than an article. -->
                <Label x:Name="MenuSupportTitle" Style="{StaticResource MenuGroupTitleStyle}" />
                <VerticalStackLayout x:Name="MenuSupport" Spacing="2" BindableLayout.ItemTemplate="{StaticResource MenuEntryTemplate}" />
                <Label x:Name="MenuReadTitle" Style="{StaticResource MenuGroupTitleStyle}" />
                <VerticalStackLayout x:Name="MenuRead" Spacing="2" BindableLayout.ItemTemplate="{StaticResource MenuEntryTemplate}" />
                <BoxView HeightRequest="1" Margin="12,12" Color="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />
                <VerticalStackLayout x:Name="MenuApp" Spacing="6" BindableLayout.ItemTemplate="{StaticResource MenuEntryTemplate}" />

                <!-- A quiet reminder of the app's promise, and the version for a support request. -->
                <HorizontalStackLayout Spacing="8" Margin="12,20,12,0">
                    <ui:MaterialIconView IconName="Lock" IconSize="16" VerticalOptions="Start" Margin="0,2,0,0" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label x:Name="MenuFooterPrivacy" Style="{StaticResource CaptionStyle}" MaximumWidthRequest="230" />
                </HorizontalStackLayout>
                <Label x:Name="MenuFooterVersion" Style="{StaticResource CaptionStyle}" Margin="36,4,12,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Shell.FlyoutContent>

    <!-- Four tabs for every day: Practices, AI chat, Tests, Journal. Everything else is in the menu. -->
    <TabBar>

        <ShellContent
            x:Name="PracticeTab"
            Route="PracticeTab"
            Title="{x:Static common:AppStrings.ShellTabPracticeShort}" />

        <ShellContent
            x:Name="ChatTab"
            Route="ChatTab"
            Title="{x:Static common:AppStrings.ShellTabChatShort}" />

        <ShellContent
            x:Name="DetectorTab"
            Route="TestsTab"
            Title="{x:Static common:AppStrings.ShellTabDetectorShort}" />

        <ShellContent
            x:Name="JournalTab"
            Route="JournalTab"
            Title="{x:Static common:AppStrings.ShellTabJournalShort}" />

    </TabBar>
</Shell>
