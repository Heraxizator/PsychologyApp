<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="PsychologyApp.Presentation.App.AppShell"
       xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
       xmlns:common="clr-namespace:PsychologyApp.Presentation.Common;assembly=PsychologyApp.Presentation.Core"
       xmlns:app="clr-namespace:PsychologyApp.Presentation.App"
       xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
       xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
       NavigationPage.HasNavigationBar="False"
       FlyoutBehavior="Flyout"
       FlyoutWidth="300"
       FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
       Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
       Shell.TabBarForegroundColor="{StaticResource Primary}"
       Shell.TabBarTitleColor="{StaticResource Primary}"
       Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
       Shell.NavBarIsVisible="False">

    <Shell.Behaviors>
        <mct:StatusBarBehavior
            x:Name="StatusBar"
            StatusBarColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
            StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </Shell.Behaviors>

    <!-- The menu behind the burger: the profile on top, my path, support, reading, then help (tinted) and the app's own pages. All of it
         fits on one screen: help and the settings sat below the edge, and the privacy line under the gesture bar. -->
    <Shell.FlyoutContent>
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="12,16,12,40" Spacing="1">
                <VerticalStackLayout.Resources>
                    <!-- A row: a grey icon and its title, as in the settings; only help keeps its colour, so it is the one thing that stands
                         out. A tile of its own colour on every row made the menu a box of sweets. The plain look is the style, so the
                         trigger for help can change it (a value set on the element would win over the trigger). -->
                    <Style x:Key="MenuTileStyle" TargetType="Border">
                        <Setter Property="BackgroundColor" Value="Transparent" />
                    </Style>
                    <Style x:Key="MenuIconStyle" TargetType="ui:MaterialIconView">
                        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </Style>
                    <DataTemplate x:Key="MenuEntryTemplate" x:DataType="app:AppMenuEntry">
                        <Border
                            Padding="10,4"
                            MinimumHeightRequest="48"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{Binding RowColor}"
                            SemanticProperties.Description="{Binding Title}">
                            <Border.Behaviors>
                                <behaviors:PressFeedbackBehavior />
                            </Border.Behaviors>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Command}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                                        Style="{StaticResource MenuTileStyle}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsEmphasized}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{Binding TileColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <ui:MaterialIconView IconName="{Binding Icon}" IconSize="20" Style="{StaticResource MenuIconStyle}">
                                        <ui:MaterialIconView.Triggers>
                                            <DataTrigger TargetType="ui:MaterialIconView" Binding="{Binding IsEmphasized}" Value="True">
                                                <Setter Property="IconColor" Value="{Binding IconColor}" />
                                            </DataTrigger>
                                        </ui:MaterialIconView.Triggers>
                                    </ui:MaterialIconView>
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource BodyStyle}" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsEmphasized}" Value="True">
                                            <Setter Property="FontFamily" Value="{StaticResource SemiBoldFontFamily}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <Style x:Key="MenuGroupTitleStyle" TargetType="Label" BasedOn="{StaticResource CaptionStyle}">
                        <Setter Property="Margin" Value="12,7,12,2" />
                    </Style>
                </VerticalStackLayout.Resources>

                <!-- The profile first: the person's own page, a row with its avatar rather than a bordered card. -->
                <Border
                    x:Name="MenuProfileCard"
                    x:DataType="app:AppMenuEntry"
                    Padding="10,6"
                    MinimumHeightRequest="56"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    SemanticProperties.Description="{Binding Title}">
                    <Border.Behaviors>
                        <behaviors:PressFeedbackBehavior />
                    </Border.Behaviors>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Command}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <!-- The accent of the profile page, not the colour of the group below: the profile is not part of "My path". -->
                        <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 20" VerticalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}">
                            <ui:MaterialIconView IconName="{Binding Icon}" IconSize="22" IconColor="{DynamicResource Primary}" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource ListRowTitleStyle}" VerticalOptions="Center" />
                        <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="20" VerticalOptions="Center"
                                             IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </Grid>
                </Border>
                <BoxView HeightRequest="1" Margin="12,4,12,0" Color="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />
                <Label x:Name="MenuMineTitle" Style="{StaticResource MenuGroupTitleStyle}" />
                <VerticalStackLayout x:Name="MenuMine" Spacing="1" BindableLayout.ItemTemplate="{StaticResource MenuEntryTemplate}" />
                <!-- Support before reading: in a hard minute a thought to lean on is nearer than an article. -->
                <Label x:Name="MenuSupportTitle" Style="{StaticResource MenuGroupTitleStyle}" />
                <VerticalStackLayout x:Name="MenuSupport" Spacing="1" BindableLayout.ItemTemplate="{StaticResource MenuEntryTemplate}" />
                <Label x:Name="MenuReadTitle" Style="{StaticResource MenuGroupTitleStyle}" />
                <VerticalStackLayout x:Name="MenuRead" Spacing="1" BindableLayout.ItemTemplate="{StaticResource MenuEntryTemplate}" />
                <BoxView HeightRequest="1" Margin="12,3" Color="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />
                <VerticalStackLayout x:Name="MenuApp" Spacing="1" BindableLayout.ItemTemplate="{StaticResource MenuEntryTemplate}" />

                <!-- A quiet reminder of the app's promise, and the version for a support request. -->
                <HorizontalStackLayout Spacing="8" Margin="12,8,12,0">
                    <ui:MaterialIconView IconName="Lock" IconSize="16" VerticalOptions="Start" Margin="0,2,0,0" IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label x:Name="MenuFooterPrivacy" Style="{StaticResource CaptionStyle}" MaximumWidthRequest="230" />
                </HorizontalStackLayout>
                <Label x:Name="MenuFooterVersion" Style="{StaticResource CaptionStyle}" Margin="36,4,12,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Shell.FlyoutContent>

    <!-- Four tabs for every day: Practices, AI chat, Tests, Journal. Everything else is in the menu. -->
    <TabBar>

        <ShellContent
            x:Name="PracticeTab"
            Route="PracticeTab"
            Title="{x:Static common:AppStrings.ShellTabPracticeShort}" />

        <ShellContent
            x:Name="ChatTab"
            Route="ChatTab"
            Title="{x:Static common:AppStrings.ShellTabChatShort}" />

        <ShellContent
            x:Name="DetectorTab"
            Route="TestsTab"
            Title="{x:Static common:AppStrings.ShellTabDetectorShort}" />

        <ShellContent
            x:Name="JournalTab"
            Route="JournalTab"
            Title="{x:Static common:AppStrings.ShellTabJournalShort}" />

    </TabBar>
</Shell>
