<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing on the widget changes by itself (the texts follow the app language and are redrawn when the app goes to the
     background), so it is never woken up on a timer. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/mood_widget"
    android:previewLayout="@layout/mood_widget"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
