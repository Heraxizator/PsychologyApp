<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:PsychologyApp.Presentation.Shared.UI.Converters">

    <converters:PreferenceLabelConverter x:Key="PreferenceLabelConverter" />
    <Style x:Key="CardFrameStyle" TargetType="Frame">
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" />
    </Style>

    <Shadow
        x:Key="BrandCardShadowLight"
        Brush="#1A152238"
        Offset="0,4"
        Radius="10"
        Opacity="0.14" />

    <Shadow
        x:Key="BrandCardShadowDark"
        Brush="#000000"
        Offset="0,2"
        Radius="12"
        Opacity="0.38" />

    <Style x:Key="BrandCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="4,4,4,12" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusShape}" />
        <Setter Property="Shadow" Value="{AppThemeBinding Light={StaticResource BrandCardShadowLight}, Dark={StaticResource BrandCardShadowDark}}" />
    </Style>

    <Style x:Key="ListCardItemStyle" TargetType="Border" BasedOn="{StaticResource BrandCardStyle}">
        <Setter Property="Margin" Value="4,4,4,12" />
    </Style>

    <Style x:Key="TestFlatCardStyle" TargetType="Border" BasedOn="{StaticResource BrandCardStyle}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Shadow" Value="{x:Null}" />
    </Style>

    <!-- dvgups page panel: single white container on #FAFAFA -->
    <Style x:Key="BrandPanelStyle" TargetType="Border">
        <Setter Property="Margin" Value="20" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusShape}" />
        <Setter Property="Shadow" Value="{AppThemeBinding Light={StaticResource BrandCardShadowLight}, Dark={StaticResource BrandCardShadowDark}}" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border" BasedOn="{StaticResource BrandCardStyle}" />

    <!-- FILLED primary button (dvgups Button FILLED + PRIMARY) -->
    <Style x:Key="PrimaryActionBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusCompactShape}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryHover}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DisabledSurfaceLight}, Dark={StaticResource DisabledSurfaceDark}}" />
                            <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="PrimaryActionLabelStyle" TargetType="Label">
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource MediumFontFamily}" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
    </Style>

    <!-- OUTLINED secondary button (dvgups Button OUTLINED + SECONDARY) -->
    <Style x:Key="OutlinedActionBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusCompactShape}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke" Value="{DynamicResource Primary}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="OutlinedActionLabelStyle" TargetType="Label">
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource Primary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource MediumFontFamily}" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
    </Style>

    <Style x:Key="CompactPrimaryBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusCompactShape}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="CompactPrimaryLabelStyle" TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource MediumFontFamily}" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
    </Style>

    <Style x:Key="CompactOutlinedBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusCompactShape}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke" Value="{DynamicResource Primary}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="CompactOutlinedLabelStyle" TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource Primary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource MediumFontFamily}" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
    </Style>

    <!-- Legacy aliases -->
    <Style x:Key="CompactSecondaryBorderStyle" TargetType="Border" BasedOn="{StaticResource CompactOutlinedBorderStyle}" />
    <Style x:Key="CompactSecondaryLabelStyle" TargetType="Label" BasedOn="{StaticResource CompactOutlinedLabelStyle}" />

    <!-- Input field shell -->
    <Style x:Key="InputBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusEntryShape}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource InputBorderDark}}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="InputTextStyle" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource InputPlaceholderLight}, Dark={StaticResource InputPlaceholderDark}}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="MusicListRowStyle" TargetType="Border" BasedOn="{StaticResource ListCardItemStyle}">
        <Setter Property="Padding" Value="12,14" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusCompactShape}" />
    </Style>

    <Style x:Key="TechniqueListCardStyle" TargetType="Border" BasedOn="{StaticResource ListCardItemStyle}">
        <Setter Property="Padding" Value="12,14" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusCompactShape}" />
    </Style>

    <Style x:Key="TestListCardStyle" TargetType="Border" BasedOn="{StaticResource ListCardItemStyle}">
        <Setter Property="Padding" Value="12,14" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusCompactShape}" />
    </Style>

    <Style x:Key="QuoteListCardStyle" TargetType="Border" BasedOn="{StaticResource ListCardItemStyle}">
        <Setter Property="Padding" Value="12,14" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusCompactShape}" />
    </Style>

    <Style x:Key="ListEntryCardStyle" TargetType="Border" BasedOn="{StaticResource BrandCardStyle}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="{StaticResource ListEntryPadding}" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusCompactShape}" />
    </Style>

    <Style x:Key="ProfileTechniqueCardStyle" TargetType="Border" BasedOn="{StaticResource ListCardItemStyle}">
        <Setter Property="Padding" Value="12" />
        <Setter Property="WidthRequest" Value="228" />
        <Setter Property="MinimumHeightRequest" Value="112" />
        <Setter Property="Margin" Value="4,4,8,12" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusCompactShape}" />
    </Style>

    <Style x:Key="ProfileAvatarBorderStyle" TargetType="Border">
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 28" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="EmptyStateIconHaloStyle" TargetType="Border">
        <Setter Property="WidthRequest" Value="72" />
        <Setter Property="HeightRequest" Value="72" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 36" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="TodayBannerStyle" TargetType="Border" BasedOn="{StaticResource BrandCardStyle}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="4,4,4,12" />
    </Style>

    <Style x:Key="TodayPracticeRowStyle" TargetType="Border" BasedOn="{StaticResource ListCardItemStyle}">
        <Setter Property="Padding" Value="12,14" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusCompactShape}" />
    </Style>

    <Shadow
        x:Key="HeroCardShadowLight"
        Brush="#120085FF"
        Offset="0,2"
        Radius="8"
        Opacity="0.10" />

    <Shadow
        x:Key="HeroCardShadowDark"
        Brush="#000000"
        Offset="0,1"
        Radius="10"
        Opacity="0.28" />

    <Style x:Key="HeroCardStyle" TargetType="Border" BasedOn="{StaticResource TodayPracticeRowStyle}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceHeroLight}, Dark={StaticResource SurfaceHeroDark}}" />
        <Setter Property="Shadow" Value="{AppThemeBinding Light={StaticResource HeroCardShadowLight}, Dark={StaticResource HeroCardShadowDark}}" />
    </Style>

    <Style x:Key="HeroAccentBarStyle" TargetType="Border">
        <Setter Property="WidthRequest" Value="{StaticResource HeroAccentBarWidth}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 2" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="Margin" Value="0,2,0,2" />
    </Style>

    <Style x:Key="MetaPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusCompactShape}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="EmptyStateActionPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceHeroLight}, Dark={StaticResource SurfaceHeroDark}}" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusCompactShape}" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="MetricTileTapTargetStyle" TargetType="VerticalStackLayout">
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="Padding" Value="4,8" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="MoodStripStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusCompactShape}" />
    </Style>

    <Style x:Key="FilterChipLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource FieldLabelFontSize}" />
        <Setter Property="FontFamily" Value="{StaticResource MediumFontFamily}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="FilterChipSelectedLabelStyle" TargetType="Label" BasedOn="{StaticResource FilterChipLabelStyle}">
        <Setter Property="TextColor" Value="{DynamicResource Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource SemiBoldFontFamily}" />
    </Style>

    <Style x:Key="FilterChipStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource InputBorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="FilterChipSelectedStyle" TargetType="Border" BasedOn="{StaticResource FilterChipStyle}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
        <Setter Property="Stroke" Value="{DynamicResource Primary}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
                            <Setter Property="Opacity" Value="0.92" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="MoodChipStyle" TargetType="Border">
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="MoodChipSelectedStyle" TargetType="Border" BasedOn="{StaticResource MoodChipStyle}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
        <Setter Property="Stroke" Value="{DynamicResource Primary}" />
    </Style>

    <Style x:Key="PlayerTransportButtonStyle" TargetType="Border">
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource InputBorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="PlayerPlayButtonStyle" TargetType="Border">
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="MoodChipEmojiStyle" TargetType="Label">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="InputEditorStyle" TargetType="Editor">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource InputPlaceholderLight}, Dark={StaticResource InputPlaceholderDark}}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="MinimumHeightRequest" Value="96" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="AutoSize" Value="TextChanges" />
    </Style>

    <Style x:Key="SettingsPickerPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinimumWidthRequest" Value="132" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource Gray700}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusCompactShape}" />
    </Style>

    <Style x:Key="SettingRowDividerStyle" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource Gray700}}" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Shadow
        x:Key="AppToastShadowLight"
        Brush="#33152238"
        Offset="0,10"
        Radius="28"
        Opacity="0.28" />

    <Shadow
        x:Key="AppToastShadowDark"
        Brush="#000000"
        Offset="0,8"
        Radius="24"
        Opacity="0.55" />

    <Shadow
        x:Key="AppDialogShadowLight"
        Brush="#40152238"
        Offset="0,16"
        Radius="32"
        Opacity="0.30" />

    <Shadow
        x:Key="AppDialogShadowDark"
        Brush="#000000"
        Offset="0,12"
        Radius="28"
        Opacity="0.62" />

    <Style x:Key="AppPopupShadowLayerStyle" TargetType="Border">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusShape}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#33152238, Dark=#80000000}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="TranslationY" Value="10" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="AppDialogShadowLayerStyle" TargetType="Border" BasedOn="{StaticResource AppPopupShadowLayerStyle}">
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusAlertShape}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#40152238, Dark=#99000000}" />
        <Setter Property="TranslationY" Value="12" />
    </Style>

    <Style x:Key="AppToastStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusShape}" />
        <Setter Property="Shadow" Value="{AppThemeBinding Light={StaticResource AppToastShadowLight}, Dark={StaticResource AppToastShadowDark}}" />
    </Style>

    <Style x:Key="AppToastPopupCardStyle" TargetType="Border" BasedOn="{StaticResource AppToastStyle}">
        <Setter Property="Shadow" Value="{x:Null}" />
    </Style>

    <Style x:Key="AppToastMessageStyle" TargetType="Label" BasedOn="{StaticResource BodyStyle}">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Start" />
        <Setter Property="MaxLines" Value="3" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="AppOptionsSheetStyle" TargetType="Border">
        <Setter Property="Padding" Value="0,12,0,8" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusShape}" />
        <Setter Property="Shadow" Value="{AppThemeBinding Light={StaticResource AppDialogShadowLight}, Dark={StaticResource AppDialogShadowDark}}" />
    </Style>

    <Style x:Key="AppOptionsSheetPopupCardStyle" TargetType="Border" BasedOn="{StaticResource AppOptionsSheetStyle}">
        <Setter Property="Shadow" Value="{x:Null}" />
    </Style>

    <Style x:Key="AppOptionsSheetTitleStyle" TargetType="Label" BasedOn="{StaticResource SectionTitleStyle}">
        <Setter Property="FontSize" Value="{StaticResource EmphasisBodyFontSize}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Margin" Value="16,4,16,8" />
    </Style>

    <Style x:Key="AppDialogCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MaximumWidthRequest" Value="320" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />
        <Setter Property="StrokeThickness" Value="0.5" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" />
        <Setter Property="StrokeShape" Value="{DynamicResource UiCornerRadiusAlertShape}" />
        <Setter Property="Shadow" Value="{AppThemeBinding Light={StaticResource AppDialogShadowLight}, Dark={StaticResource AppDialogShadowDark}}" />
    </Style>

    <Style x:Key="AppDialogPopupCardStyle" TargetType="Border" BasedOn="{StaticResource AppDialogCardStyle}">
        <Setter Property="Shadow" Value="{x:Null}" />
    </Style>

    <Style x:Key="AppOptionsSheetShadowLayerStyle" TargetType="Border" BasedOn="{StaticResource AppPopupShadowLayerStyle}">
        <Setter Property="TranslationY" Value="14" />
    </Style>

    <Style x:Key="AppDialogTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource EmphasisBodyFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource EmphasisBodyLineHeight}" />
        <Setter Property="FontFamily" Value="{StaticResource SemiBoldFontFamily}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="AppDialogMessageStyle" TargetType="Label" BasedOn="{StaticResource CaptionStyle}">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource BodyLineHeight}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="AppDialogDividerStyle" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="0.5" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource Gray700}}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="AppDialogActionDividerStyle" TargetType="BoxView">
        <Setter Property="WidthRequest" Value="0.5" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource NeutralBorder}, Dark={StaticResource Gray700}}" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <Style x:Key="AppDialogActionLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource EmphasisBodyFontSize}" />
        <Setter Property="FontFamily" Value="{StaticResource MediumFontFamily}" />
        <Setter Property="TextColor" Value="{DynamicResource Primary}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="AppDialogPrimaryActionLabelStyle" TargetType="Label" BasedOn="{StaticResource AppDialogActionLabelStyle}">
        <Setter Property="FontFamily" Value="{StaticResource SemiBoldFontFamily}" />
    </Style>

    <Style x:Key="SettingsSectionCardStyle" TargetType="Border" BasedOn="{StaticResource BrandCardStyle}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

</ResourceDictionary>
