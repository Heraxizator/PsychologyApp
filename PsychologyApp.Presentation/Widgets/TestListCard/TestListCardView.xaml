<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:Class="PsychologyApp.Presentation.Widgets.TestListCard.TestListCardView">

    <ContentView.Behaviors>
        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
    </ContentView.Behaviors>

    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Border Style="{StaticResource TestListCardStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{TemplateBinding TapCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border
                        Grid.Column="0"
                        Style="{StaticResource IconTileStyle}"
                        VerticalOptions="Start">
                        <ui:MaterialIconView
                            IconName="Quiz"
                            IconSize="22"
                            IconColor="{DynamicResource Primary}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label
                            Text="{TemplateBinding Title}"
                            Style="{StaticResource ListRowTitleStyle}"
                            MaxLines="3"
                            LineBreakMode="WordWrap" />
                        <Label
                            Text="{TemplateBinding Subtitle}"
                            Style="{StaticResource CaptionStyle}"
                            MaxLines="4"
                            LineBreakMode="WordWrap" />
                        <Label
                            IsVisible="{TemplateBinding HasMetaText}"
                            Text="{TemplateBinding MetaText}"
                            Style="{StaticResource CaptionStyle}"
                            FontFamily="{StaticResource SemiBoldFontFamily}"
                            TextColor="{DynamicResource Primary}"
                            MaxLines="2"
                            LineBreakMode="WordWrap" />
                        <Label
                            IsVisible="{TemplateBinding ShowNeverTaken}"
                            Text="{TemplateBinding NeverTakenLabel}"
                            Style="{StaticResource CaptionStyle}"
                            TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextSecondaryDark}}"
                            MaxLines="1"
                            LineBreakMode="TailTruncation" />
                        <VerticalStackLayout Spacing="8" IsVisible="{TemplateBinding HasLastResult}">
                            <Label
                                Text="{TemplateBinding LastResultText}"
                                Style="{StaticResource CaptionStyle}"
                                FontFamily="{StaticResource MediumFontFamily}"
                                TextColor="{DynamicResource Primary}"
                                MaxLines="2"
                                LineBreakMode="WordWrap">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{TemplateBinding OpenHistoryCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                            <HorizontalStackLayout Spacing="8">
                                <Border
                                    Style="{StaticResource MetaPillStyle}"
                                    Padding="14,8"
                                    MinimumHeightRequest="36">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{TemplateBinding RetakeCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="{TemplateBinding RetakeLabel}"
                                        Style="{StaticResource CaptionStyle}"
                                        VerticalOptions="Center"
                                        TextColor="{DynamicResource Primary}"
                                        FontFamily="{StaticResource SemiBoldFontFamily}" />
                                </Border>
                                <Border
                                    IsVisible="{TemplateBinding HasMultipleResults}"
                                    Style="{StaticResource MetaPillStyle}"
                                    Padding="14,8"
                                    MinimumHeightRequest="36">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{TemplateBinding OpenHistoryCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="{TemplateBinding HistoryLabel}"
                                        Style="{StaticResource CaptionStyle}"
                                        VerticalOptions="Center"
                                        TextColor="{DynamicResource Primary}"
                                        FontFamily="{StaticResource SemiBoldFontFamily}" />
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <Label
                        Grid.Column="2"
                        VerticalOptions="Center"
                        TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextSecondaryDark}}"
                        Text="{mi:Material Icon=KeyboardArrowRight}" />
                </Grid>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>

</ContentView>
