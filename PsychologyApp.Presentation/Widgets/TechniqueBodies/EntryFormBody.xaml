<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:Class="PsychologyApp.Presentation.Widgets.TechniqueBodies.EntryFormBody">
    <VerticalStackLayout Spacing="{StaticResource LayoutSpacing}">
        <Grid ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                Text="{Binding FormSectionTitle}"
                Style="{StaticResource SectionTitleStyle}"
                VerticalOptions="Center" />
            <Label
                Grid.Column="1"
                Text="{Binding StepProgressText}"
                Style="{StaticResource CaptionStyle}"
                VerticalOptions="Center" />
        </Grid>
        <ui:EntryItemFieldView x:Name="FieldHost" Entry="{Binding CurrentEntry}" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsWizardMode}">
            <ui:ButtonView
                Grid.Column="0"
                Variant="Secondary"
                BodyText="{Binding PreviousStepText}"
                TapCommand="{Binding PreviousStepCommand}"
                IsEnabled="{Binding CanGoToPreviousStep}" />
            <ui:ButtonView
                Grid.Column="1"
                BodyText="{Binding NextStepText}"
                TapCommand="{Binding NextStepCommand}"
                IsVisible="{Binding CanGoToNextStep}" />
        </Grid>
    </VerticalStackLayout>
</ContentView>
