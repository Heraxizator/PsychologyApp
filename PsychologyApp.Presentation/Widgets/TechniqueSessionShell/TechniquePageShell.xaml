<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:session="clr-namespace:PsychologyApp.Presentation.Features.RunTechniqueSession"
             xmlns:self="clr-namespace:PsychologyApp.Presentation.Widgets.TechniqueSessionShell"
             x:DataType="self:TechniquePageShell"
             x:Class="PsychologyApp.Presentation.Widgets.TechniqueSessionShell.TechniquePageShell"
             x:Name="Root">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Margin="{StaticResource LayoutTabPageMarginThickness}" Spacing="{StaticResource LayoutSpacing}">
            <VerticalStackLayout.Behaviors>
                <behaviors:StaggerChildrenBehavior />
            </VerticalStackLayout.Behaviors>
            <ui:NavigationBarExtendedView
                TitleText="{Binding Source={x:Reference Root}, Path=TitleText}"
                BackCommand="{Binding Source={x:Reference Root}, Path=BackCommand}"
                ExtensionText="{Binding Source={x:Reference Root}, Path=TheoryText}"
                ExtensionCommand="{Binding Source={x:Reference Root}, Path=TheoryCommand}" />
            <!-- What the practice is for, on a banner in the colour of its group. -->
            <Border
                x:Name="Hero"
                IsVisible="{Binding Source={x:Reference Root}, Path=HasHero}"
                Margin="0"
                Padding="16"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border
                        x:Name="HeroTile"
                        WidthRequest="56"
                        HeightRequest="56"
                        VerticalOptions="Start"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">
                        <ui:MaterialIconView
                            x:Name="HeroIconView"
                            IconSize="30"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label
                            Text="{Binding Source={x:Reference Root}, Path=HeroSubtitle}"
                            Style="{StaticResource SectionTitleStyle}" />
                        <Label
                            Text="{Binding Source={x:Reference Root}, Path=HeroMeta}"
                            Style="{StaticResource CaptionStyle}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
            <ui:AlgorithmBoxView
                x:Name="Steps"
                TitleText="{Binding Source={x:Reference Root}, Path=AlgorithmTitleText}"
                BodySource="{Binding Source={x:Reference Root}, Path=Algorithm}" />
            <Border
                x:DataType="session:ITechniqueSessionScreen"
                Style="{StaticResource BrandCardStyle}"
                Margin="0"
                IsVisible="{Binding HasLastNote}">
                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="{Binding LastNoteTitle}"
                        Style="{StaticResource CaptionStyle}"
                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                        FontFamily="{StaticResource SemiBoldFontFamily}" />
                    <Label
                        Text="{Binding LastNoteText}"
                        Style="{StaticResource BodyStyle}" />
                </VerticalStackLayout>
            </Border>
            <ui:RatingEntryView
                x:DataType="session:ITechniqueSessionScreen"
                TitleText="{Binding PreIntensityLabel}"
                BodyText="{Binding PreIntensityText, Mode=TwoWay}" />
            <Grid x:Name="BodyHost" />
            <ui:ButtonView
                BodyText="{Binding Source={x:Reference Root}, Path=FinishText}"
                TapCommand="{Binding Source={x:Reference Root}, Path=FinishCommand}"
                IsEnabled="{Binding Source={x:Reference Root}, Path=FinishEnabled}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
