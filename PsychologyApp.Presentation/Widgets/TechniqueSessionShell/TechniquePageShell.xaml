<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:session="clr-namespace:PsychologyApp.Presentation.Features.RunTechniqueSession"
             xmlns:self="clr-namespace:PsychologyApp.Presentation.Widgets.TechniqueSessionShell"
             x:DataType="self:TechniquePageShell"
             x:Class="PsychologyApp.Presentation.Widgets.TechniqueSessionShell.TechniquePageShell"
             x:Name="Root">

    <Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Margin="{StaticResource LayoutTabPageMarginThickness}" Spacing="{StaticResource LayoutSpacing}">
            <VerticalStackLayout.Behaviors>
                <behaviors:StaggerChildrenBehavior />
            </VerticalStackLayout.Behaviors>
            <ui:NavigationBarExtendedView
                TitleText="{Binding Source={x:Reference Root}, Path=TitleText}"
                BackCommand="{Binding Source={x:Reference Root}, Path=BackCommand}"
                ExtensionText="{Binding Source={x:Reference Root}, Path=TheoryText}"
                ExtensionCommand="{Binding Source={x:Reference Root}, Path=TheoryCommand}" />
            <!-- What the practice is for, on a card with a tile in the colour of its group. -->
            <Border
                x:Name="Hero"
                IsVisible="{Binding Source={x:Reference Root}, Path=HasHero}"
                Margin="0"
                Padding="16,14"
                StrokeThickness="0"
                StrokeShape="{DynamicResource UiCornerRadiusCompactShape}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border
                        x:Name="HeroTile"
                        WidthRequest="56"
                        HeightRequest="56"
                        VerticalOptions="Start"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">
                        <ui:MaterialIconView
                            x:Name="HeroIconView"
                            IconSize="30"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label
                            Text="{Binding Source={x:Reference Root}, Path=HeroSubtitle}"
                            Style="{StaticResource SectionTitleStyle}" />
                        <Label
                            Text="{Binding Source={x:Reference Root}, Path=HeroMeta}"
                            Style="{StaticResource CaptionStyle}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
            <!-- In a step-by-step practice the steps are on the cards below, so the algorithm folds to one quiet line, not a card of its
                 own; a tap opens it. -->
            <Border
                x:Name="StepsSummary"
                IsVisible="False"
                Margin="4,0"
                Padding="12,4"
                MinimumHeightRequest="44"
                StrokeThickness="0"
                BackgroundColor="Transparent">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnStepsSummaryTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <ui:MaterialIconView x:Name="StepsSummaryIcon" IconName="FormatListNumbered" IconSize="20" VerticalOptions="Center" />
                    <Label x:Name="StepsSummaryLabel" Grid.Column="1" Style="{StaticResource BodyStyle}" FontFamily="{StaticResource MediumFontFamily}" VerticalOptions="Center" />
                    <ui:MaterialIconView x:Name="StepsSummaryChevron" Grid.Column="2" IconName="ExpandMore" IconSize="22" VerticalOptions="Center" />
                </Grid>
            </Border>
            <ui:AlgorithmBoxView
                x:Name="Steps"
                TitleText="{Binding Source={x:Reference Root}, Path=AlgorithmTitleText}"
                BodySource="{Binding Source={x:Reference Root}, Path=Algorithm}" />
            <Border
                x:DataType="session:ITechniqueSessionScreen"
                Style="{StaticResource BrandCardStyle}"
                Margin="0"
                IsVisible="{Binding HasLastNote}">
                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="{Binding LastNoteTitle}"
                        Style="{StaticResource CaptionStyle}"
                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                        FontFamily="{StaticResource SemiBoldFontFamily}" />
                    <Label
                        Text="{Binding LastNoteText}"
                        Style="{StaticResource BodyStyle}" />
                </VerticalStackLayout>
            </Border>
            <Border
                x:DataType="session:ITechniqueSessionScreen"
                Style="{StaticResource BrandCardStyle}"
                Margin="0"
                Padding="18,16"
                IsVisible="{Binding AsksPreIntensity}">
                <ui:RatingEntryView
                    x:DataType="session:ITechniqueSessionScreen"
                    Embedded="True"
                    TitleText="{Binding PreIntensityLabel}"
                    BodyText="{Binding PreIntensityText, Mode=TwoWay}" />
            </Border>
            <Grid x:Name="BodyHost" />
        </VerticalStackLayout>
    </ScrollView>

    <!-- The way on stays under the thumb: "Next" and "Finish" are pinned to the bottom, so a practice can be walked one-handed. -->
    <Border
        x:Name="ActionBar"
        Grid.Row="1"
        StrokeThickness="0"
        Padding="16,10,16,14"
        BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
        <VerticalStackLayout Spacing="10">
            <BoxView Style="{StaticResource SubtleDividerStyle}" Margin="-16,-10,-16,0" />
            <Grid x:Name="FooterHost" />
            <ui:ButtonView
                x:Name="FinishButton"
                BodyText="{Binding Source={x:Reference Root}, Path=FinishText}"
                TapCommand="{Binding Source={x:Reference Root}, Path=FinishCommand}"
                IsEnabled="{Binding Source={x:Reference Root}, Path=FinishEnabled}"
                IsVisible="{Binding Source={x:Reference Root}, Path=FinishEnabled}" />
        </VerticalStackLayout>
    </Border>
    </Grid>
</ContentView>
