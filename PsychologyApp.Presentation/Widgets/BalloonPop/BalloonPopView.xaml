<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             x:Class="PsychologyApp.Presentation.Widgets.BalloonPop.BalloonPopView">
    <Border Style="{StaticResource BrandCardStyle}" Margin="{StaticResource CardBottomMargin}">
        <VerticalStackLayout Spacing="12">
            <GraphicsView x:Name="Field" HeightRequest="360" />
            <Label x:Name="CountLabel" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
            <ui:ButtonView x:Name="StartButton" />
            <ui:ButtonView x:Name="PopButton" Variant="Secondary" IsVisible="False" />
        </VerticalStackLayout>
    </Border>
</ContentView>
