<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             x:Class="PsychologyApp.Presentation.Widgets.BusyMind.BusyMindView">
    <Border Style="{StaticResource BrandCardStyle}" Margin="{StaticResource CardBottomMargin}">
        <VerticalStackLayout Spacing="12">
            <Label x:Name="StepLabel" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" IsVisible="False" />
            <!-- Room for three lines, so the buttons below stay put from one task to the next and a quick second tap does not hit "another task". -->
            <Label x:Name="TaskLabel" Style="{StaticResource EmphasisBodyStyle}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" MinimumHeightRequest="84" />
            <ui:ButtonView x:Name="MainButton" />
            <ui:ButtonView x:Name="SkipButton" Variant="Secondary" IsVisible="False" />
        </VerticalStackLayout>
    </Border>
</ContentView>
