<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:Class="PsychologyApp.Presentation.Widgets.QuoteCard.QuoteCardView"
             x:Name="Root">

    <ContentView.Behaviors>
        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
    </ContentView.Behaviors>

    <Border Style="{StaticResource QuoteListCardStyle}" Padding="16,8,8,8">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
            <!-- Top row: theme pill + favourite -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Border
                    Grid.Column="0"
                    Style="{StaticResource MetaPillStyle}"
                    Padding="10,4"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                    <Border.Triggers>
                        <DataTrigger
                            Binding="{Binding ThemeLabel, Source={x:Reference Root}}"
                            TargetType="Border"
                            Value="">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label
                        Style="{StaticResource CaptionStyle}"
                        TextColor="{DynamicResource Primary}"
                        FontFamily="{StaticResource SemiBoldFontFamily}"
                        MaxLines="1"
                        LineBreakMode="TailTruncation"
                        Text="{Binding ThemeLabel, Source={x:Reference Root}}" />
                </Border>
                <Border
                    x:Name="FavoriteActionBorder"
                    Grid.Column="1"
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeThickness="0"
                    BackgroundColor="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LikeCommand, Source={x:Reference Root}}" />
                    </Border.GestureRecognizers>
                    <ui:MaterialIconView
                        IconName="FavoriteBorder"
                        IconSize="24"
                        SemanticProperties.Description="{Binding FavoriteHint, Source={x:Reference Root}}"
                        IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}">
                        <ui:MaterialIconView.Triggers>
                            <DataTrigger
                                Binding="{Binding IsFavourite, Source={x:Reference Root}}"
                                TargetType="ui:MaterialIconView"
                                Value="True">
                                <Setter Property="IconName" Value="Favorite" />
                                <Setter Property="IconColor" Value="{DynamicResource Primary}" />
                            </DataTrigger>
                        </ui:MaterialIconView.Triggers>
                    </ui:MaterialIconView>
                </Border>
            </Grid>

            <!-- Quote body -->
            <Label
                Grid.Row="1"
                Margin="0,0,8,0"
                HorizontalTextAlignment="Start"
                Style="{StaticResource QuoteDisplayStyle}"
                Text="{Binding Text, Source={x:Reference Root}}" />

            <!-- Footer: author + copy / share -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="0">
                <Label
                    Grid.Column="0"
                    VerticalOptions="Center"
                    FontAttributes="Italic"
                    Style="{StaticResource CaptionStyle}"
                    MaxLines="2"
                    LineBreakMode="TailTruncation"
                    Text="{Binding AuthorLine, Source={x:Reference Root}}" />
                <Border
                    x:Name="CopyActionBorder"
                    Grid.Column="1"
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeThickness="0"
                    BackgroundColor="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyCommand, Source={x:Reference Root}}" />
                    </Border.GestureRecognizers>
                    <ui:MaterialIconView
                        IconName="ContentCopy"
                        IconSize="22"
                        SemanticProperties.Description="{Binding CopyHint, Source={x:Reference Root}}"
                        IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </Border>
                <Border
                    x:Name="ShareActionBorder"
                    Grid.Column="2"
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeThickness="0"
                    BackgroundColor="Transparent">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShareCommand, Source={x:Reference Root}}" />
                    </Border.GestureRecognizers>
                    <ui:MaterialIconView
                        IconName="Share"
                        IconSize="22"
                        SemanticProperties.Description="{Binding ShareHint, Source={x:Reference Root}}"
                        IconColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </Border>
            </Grid>
        </Grid>
    </Border>

</ContentView>
