<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:journal="clr-namespace:PsychologyApp.Presentation.Entities.Journal"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:Class="PsychologyApp.Presentation.Widgets.Journal.JournalWeekStripView"
             x:Name="Root">

    <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
        <Label
            IsVisible="{Binding HasCaptionText, Source={x:Reference Root}}"
            Text="{Binding CaptionText, Source={x:Reference Root}}"
            Style="{StaticResource CaptionStyle}"
            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <CollectionView
            HeightRequest="68"
            SelectionMode="None"
            HorizontalScrollBarVisibility="Never"
            InputTransparent="{Binding IsInteractionBlocked, Source={x:Reference Root}}"
            ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="{StaticResource CompactSpacing}" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="journal:JournalDayChip">
                    <Border
                        WidthRequest="44"
                        HeightRequest="60"
                        Padding="2"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="Transparent"
                        StrokeThickness="2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
                                <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectDayCommand, Source={x:Reference Root}}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Border.Behaviors>
                            <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                        </Border.Behaviors>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Center">
                            <Label
                                Text="{Binding DayLabel}"
                                Style="{StaticResource CaptionStyle}"
                                FontSize="11"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="NoWrap" />
                            <Label
                                Text="{Binding MoodGlyph}"
                                FontSize="16"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
