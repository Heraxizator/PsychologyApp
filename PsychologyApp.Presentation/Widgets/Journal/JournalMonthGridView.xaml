<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:journal="clr-namespace:PsychologyApp.Presentation.Entities.Journal;assembly=PsychologyApp.Presentation.Core"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:self="clr-namespace:PsychologyApp.Presentation.Widgets.Journal"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             x:DataType="self:JournalMonthGridView"
             x:Class="PsychologyApp.Presentation.Widgets.Journal.JournalMonthGridView"
             x:Name="Root">

    <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
        <Label
            IsVisible="{Binding HasCaptionText, Source={x:Reference Root}}"
            Text="{Binding CaptionText, Source={x:Reference Root}}"
            Style="{StaticResource CaptionStyle}"
            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <!-- The days of the week over the columns, Monday first like the cells, so a date can be read without counting. -->
        <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="4" AutomationProperties.IsInAccessibleTree="False">
            <Label x:Name="Weekday0" Grid.Column="0" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
            <Label x:Name="Weekday1" Grid.Column="1" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
            <Label x:Name="Weekday2" Grid.Column="2" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
            <Label x:Name="Weekday3" Grid.Column="3" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
            <Label x:Name="Weekday4" Grid.Column="4" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
            <Label x:Name="Weekday5" Grid.Column="5" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
            <Label x:Name="Weekday6" Grid.Column="6" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
        </Grid>
        <CollectionView
            SelectionMode="None"
            ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    Orientation="Vertical"
                    Span="7"
                    HorizontalItemSpacing="4"
                    VerticalItemSpacing="4" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="journal:JournalMonthCell">
                    <Border
                        HeightRequest="44"
                        Padding="2"
                        ui:MoodTint.Level="{Binding MoodLevel}"
                        Stroke="Transparent"
                        StrokeThickness="2"
                        Opacity="1"
                        IsEnabled="{Binding IsEnabled}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPlaceholder}" Value="True">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="InputTransparent" Value="True" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectDayCommand, Source={x:Reference Root}, x:DataType=self:JournalMonthGridView}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Border.Behaviors>
                            <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
                        </Border.Behaviors>
                        <!-- The date on the colour of the day's mood, as in the journal's week; an emoji under it only repeated the colour. -->
                        <Label
                            Text="{Binding DayNumber}"
                            FontSize="15"
                            FontFamily="{StaticResource MediumFontFamily}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                            HorizontalTextAlignment="Center"
                            VerticalOptions="Center" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
