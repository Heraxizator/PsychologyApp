<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:self="clr-namespace:PsychologyApp.Presentation.Widgets.Journal"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             x:DataType="self:JournalEntryView"
             x:Class="PsychologyApp.Presentation.Widgets.Journal.JournalEntryView"
             x:Name="Root">

    <ContentView.Behaviors>
        <behaviors:ListItemRevealBehavior />
        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
    </ContentView.Behaviors>

    <!-- The test card: its corners, padding and side inset, so a list of entries looks like the other lists. -->
    <Border Style="{StaticResource TestListCardStyle}" Margin="4,0,4,8">
        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding TapCommand, Source={x:Reference Root}}"
                CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <!-- The face of the mood on its colour (MoodTint), the same as on the check-in card. -->
            <Border
                x:Name="MoodTile"
                Grid.Column="0"
                Style="{StaticResource LargeIconTileStyle}">
                <ui:MaterialIconView
                    x:Name="MoodIcon"
                    IconName="SentimentNeutral"
                    IconSize="28"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <!-- The anatomy of the test and practice cards: a bold title (the day, or the time under a day header), the note in grey.
                 "No note" is just as quiet as a note; the face says the rest. -->
            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                <Label
                    Text="{Binding DateText, Source={x:Reference Root}}"
                    Style="{StaticResource ListRowTitleStyle}" />
                <Label
                    Text="{Binding NoteText, Source={x:Reference Root}}"
                    Style="{StaticResource CaptionStyle}"
                    MaxLines="2"
                    LineBreakMode="TailTruncation" />
            </VerticalStackLayout>

            <!-- A card that opens something says so, as on the other tabs; the history's cards carry their share button there. -->
            <Label
                Grid.Column="2"
                IsVisible="{Binding ShowChevron, Source={x:Reference Root}}"
                VerticalOptions="Center"
                TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextSecondaryDark}}"
                Text="{mi:Material Icon=KeyboardArrowRight}" />
            <Label
                Grid.Column="2"
                IsVisible="{Binding HasShareCommand, Source={x:Reference Root}}"
                Style="{StaticResource IconActionStyle}"
                WidthRequest="40"
                VerticalOptions="Center"
                Text="{mi:Material Icon=Share}"
                SemanticProperties.Description="{Binding ShareDescription, Source={x:Reference Root}}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding ShareCommand, Source={x:Reference Root}}"
                        CommandParameter="{Binding ShareCommandParameter, Source={x:Reference Root}}" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>
    </Border>
</ContentView>
