<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:self="clr-namespace:PsychologyApp.Presentation.Widgets.Profile"
             x:DataType="self:ProfileHistoryEntryView"
             x:Class="PsychologyApp.Presentation.Widgets.Profile.ProfileHistoryEntryView"
             x:Name="Root">

    <ContentView.Behaviors>
        <behaviors:ListItemRevealBehavior />
        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
    </ContentView.Behaviors>

    <Border Style="{StaticResource ListEntryCardStyle}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding TapCommand, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border
                Grid.Column="0"
                Style="{StaticResource LargeIconTileStyle}">
                <ui:MaterialIconView
                    WidthRequest="28"
                    HeightRequest="28"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    IconName="{Binding IconName, Source={x:Reference Root}}" />
            </Border>

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="4"
                VerticalOptions="Center">
                <Label
                    Text="{Binding TechniqueName, Source={x:Reference Root}}"
                    Style="{StaticResource ListRowTitleStyle}"
                    MaxLines="2"
                    LineBreakMode="TailTruncation" />
                <Label
                    Text="{Binding DetailText, Source={x:Reference Root}}"
                    Style="{StaticResource CaptionStyle}"
                    MaxLines="2"
                    LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
