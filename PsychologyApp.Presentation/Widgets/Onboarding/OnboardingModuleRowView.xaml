<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:Class="PsychologyApp.Presentation.Widgets.Onboarding.OnboardingModuleRowView"
             x:Name="Root">

    <ContentView.Behaviors>
        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
        <behaviors:ListItemRevealBehavior />
    </ContentView.Behaviors>

    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Border Style="{StaticResource BrandCardStyle}">
                <Grid ColumnDefinitions="3,Auto,*" ColumnSpacing="12">
                    <BoxView
                        Grid.Column="0"
                        WidthRequest="3"
                        Color="{DynamicResource Primary}"
                        VerticalOptions="Fill"
                        HorizontalOptions="Start" />
                    <Border
                        Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <ui:MaterialIconView
                            WidthRequest="24"
                            HeightRequest="24"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            IconName="{TemplateBinding IconName}"
                            IconColor="{DynamicResource Primary}" />
                    </Border>
                    <VerticalStackLayout
                        Grid.Column="2"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            Text="{TemplateBinding Title}"
                            Style="{StaticResource ListRowTitleStyle}"
                            MaxLines="1"
                            LineBreakMode="TailTruncation" />
                        <Label
                            Text="{TemplateBinding Subtitle}"
                            Style="{StaticResource CaptionStyle}"
                            MaxLines="2"
                            LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>

</ContentView>
