<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:Class="PsychologyApp.Presentation.Widgets.TodayPracticeRow.TodayPracticeRowView"
             x:Name="Root">

    <ContentView.Behaviors>
        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
    </ContentView.Behaviors>

    <ContentView.ControlTemplate>
        <ControlTemplate>
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label
                        Grid.Column="0"
                        Text="{TemplateBinding CaptionText}"
                        Style="{StaticResource HeroCaptionStyle}" />
                    <Label
                        Grid.Column="1"
                        IsVisible="{TemplateBinding HasStreak}"
                        Text="{TemplateBinding StreakText}"
                        Style="{StaticResource CaptionStyle}"
                        HorizontalTextAlignment="End" />
                </Grid>
                <Border Style="{StaticResource HeroCardStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{TemplateBinding TapCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                        <Border
                            Grid.Column="0"
                            Style="{StaticResource HeroAccentBarStyle}" />
                        <Border
                            Grid.Column="1"
                            WidthRequest="52"
                            HeightRequest="52"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <ui:MaterialIconView
                                WidthRequest="28"
                                HeightRequest="28"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                IconName="{TemplateBinding IconName}" />
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="2"
                            Spacing="4"
                            VerticalOptions="Center">
                            <Label
                                Text="{TemplateBinding Title}"
                                Style="{StaticResource ListRowTitleStyle}"
                                MaxLines="1"
                                LineBreakMode="TailTruncation" />
                            <Label
                                Text="{TemplateBinding Subtitle}"
                                Style="{StaticResource CaptionStyle}"
                                MaxLines="2"
                                LineBreakMode="TailTruncation" />
                            <Label
                                Text="{TemplateBinding ReasonText}"
                                Style="{StaticResource CaptionStyle}"
                                TextColor="{DynamicResource Primary}"
                                MaxLines="2"
                                LineBreakMode="TailTruncation" />
                            <Border
                                IsVisible="{TemplateBinding HasMeta}"
                                Style="{StaticResource MetaPillStyle}"
                                HorizontalOptions="Start"
                                Padding="8,4">
                                <Label
                                    Text="{TemplateBinding MetaText}"
                                    Style="{StaticResource CaptionStyle}"
                                    TextColor="{DynamicResource Primary}"
                                    FontFamily="{StaticResource SemiBoldFontFamily}"
                                    MaxLines="1"
                                    LineBreakMode="TailTruncation" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout
                            Grid.Column="3"
                            Spacing="2"
                            VerticalOptions="Center"
                            HorizontalOptions="End">
                            <Label
                                Text="{TemplateBinding ActionText}"
                                Style="{StaticResource CaptionStyle}"
                                TextColor="{DynamicResource Primary}"
                                HorizontalTextAlignment="End"
                                MaxLines="1"
                                LineBreakMode="TailTruncation" />
                            <Label
                                HorizontalOptions="End"
                                TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                Text="{mi:Material Icon=KeyboardArrowRight}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ControlTemplate>
    </ContentView.ControlTemplate>

</ContentView>
