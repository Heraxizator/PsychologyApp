<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:Class="PsychologyApp.Presentation.Widgets.TodayPracticeRow.TodayPracticeRowView"
             x:Name="Root">

    <ContentView.Behaviors>
        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
    </ContentView.Behaviors>

    <!--
        Same body as a regular practice card (icon tile, title, subtitle, chevron): this row is the catalog's first
        item, not a second hero competing with the chat invite above it. A caption and a streak count are what set it
        apart, not a different shape, background or shadow.
    -->
    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Border Style="{StaticResource TechniqueListCardStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{TemplateBinding TapCommand}" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{TemplateBinding CaptionText}"
                            Style="{StaticResource HeroCaptionStyle}"
                            FontFamily="{StaticResource SemiBoldFontFamily}"
                            MaxLines="1"
                            LineBreakMode="TailTruncation" />
                        <Label
                            Grid.Column="1"
                            IsVisible="{TemplateBinding HasStreak}"
                            Text="{TemplateBinding StreakText}"
                            Style="{StaticResource CaptionStyle}"
                            HorizontalTextAlignment="End" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border
                            Grid.Column="0"
                            WidthRequest="52"
                            HeightRequest="52"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <ui:MaterialIconView
                                WidthRequest="28"
                                HeightRequest="28"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                IconName="{TemplateBinding IconName}" />
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="4"
                            VerticalOptions="Center">
                            <Label
                                Text="{TemplateBinding Title}"
                                Style="{StaticResource ListRowTitleStyle}"
                                MaxLines="1"
                                LineBreakMode="TailTruncation" />
                            <Label
                                Text="{TemplateBinding Subtitle}"
                                Style="{StaticResource CaptionStyle}"
                                MaxLines="2"
                                LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Label
                            Grid.Column="2"
                            VerticalOptions="Center"
                            TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextSecondaryDark}}"
                            Text="{mi:Material Icon=KeyboardArrowRight}" />
                    </Grid>

                    <Label
                        Grid.Row="2"
                        IsVisible="{TemplateBinding HasNudge}"
                        Text="{TemplateBinding NudgeText}"
                        Style="{StaticResource CaptionStyle}"
                        TextColor="{DynamicResource Primary}"
                        FontFamily="{StaticResource SemiBoldFontFamily}"
                        MaxLines="1"
                        LineBreakMode="TailTruncation" />
                    <Label
                        Grid.Row="2"
                        IsVisible="{TemplateBinding HasReasonOnly}"
                        Text="{TemplateBinding ReasonText}"
                        Style="{StaticResource CaptionStyle}"
                        TextColor="{DynamicResource Primary}"
                        MaxLines="1"
                        LineBreakMode="TailTruncation" />

                    <Border
                        Grid.Row="3"
                        IsVisible="{TemplateBinding HasMeta}"
                        Style="{StaticResource MetaPillStyle}"
                        HorizontalOptions="Start"
                        Padding="8,4">
                        <Label
                            Text="{TemplateBinding MetaText}"
                            Style="{StaticResource CaptionStyle}"
                            TextColor="{DynamicResource Primary}"
                            FontFamily="{StaticResource SemiBoldFontFamily}"
                            MaxLines="1"
                            LineBreakMode="TailTruncation" />
                    </Border>
                </Grid>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>

</ContentView>
