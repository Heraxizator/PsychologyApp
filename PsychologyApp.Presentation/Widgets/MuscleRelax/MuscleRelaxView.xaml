<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             x:Class="PsychologyApp.Presentation.Widgets.MuscleRelax.MuscleRelaxView">
    <Border Style="{StaticResource BrandCardStyle}" Margin="{StaticResource CardBottomMargin}">
        <VerticalStackLayout Spacing="12">
            <Label x:Name="PhaseLabel" Style="{StaticResource SectionTitleStyle}" HorizontalTextAlignment="Center" IsVisible="False" />
            <Label x:Name="CountLabel" Style="{StaticResource SectionTitleStyle}" FontSize="34" HorizontalTextAlignment="Center" IsVisible="False" />
            <!-- Room for three lines, so the card does not jump between tensing and letting go. -->
            <Label x:Name="InstructionLabel" Style="{StaticResource EmphasisBodyStyle}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" MinimumHeightRequest="84" />
            <Label x:Name="StepLabel" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
            <ui:ButtonView x:Name="ToggleButton" />
        </VerticalStackLayout>
    </Border>
</ContentView>
