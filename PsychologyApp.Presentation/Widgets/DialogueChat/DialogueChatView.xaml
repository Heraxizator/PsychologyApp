<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Widgets.DialogueChat.DialogueChatView"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:chat="clr-namespace:PsychologyApp.Presentation.Widgets.DialogueChat"
             x:DataType="chat:ChatViewModelBase">

    <Grid RowDefinitions="*,Auto" RowSpacing="12">

        <CollectionView
            x:Name="MessageList"
            Grid.Row="0"
            ItemsSource="{Binding Messages}"
            SelectionMode="None"
            VerticalScrollBarVisibility="Never">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="chat:DialogueMessage">
                    <Border
                        HorizontalOptions="{Binding Alignment}"
                        MaximumWidthRequest="320"
                        Padding="14,10"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsUser}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Text}" Style="{StaticResource BodyStyle}" LineBreakMode="WordWrap" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <Label
                    Text="{Binding TypingText}"
                    IsVisible="{Binding IsTyping}"
                    Style="{StaticResource CaptionStyle}"
                    Margin="6,10,0,0" />
            </CollectionView.Footer>
        </CollectionView>

        <VerticalStackLayout Grid.Row="1" Spacing="10">

            <!-- Free text answer -->
            <Grid IsVisible="{Binding IsTextInput}" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource InputBorderStyle}">
                    <Editor
                        Text="{Binding DraftText, Mode=TwoWay}"
                        Placeholder="{Binding InputPlaceholder}"
                        AutoSize="TextChanges"
                        MaxLength="1000"
                        MaximumHeightRequest="120"
                        BackgroundColor="Transparent" />
                </Border>
                <ui:ButtonView
                    Grid.Column="1"
                    VerticalOptions="End"
                    BodyText="{Binding SendText}"
                    TapCommand="{Binding SendCommand}" />
            </Grid>

            <!-- Choice chips -->
            <FlexLayout
                IsVisible="{Binding IsChoiceInput}"
                Wrap="Wrap"
                JustifyContent="Start"
                BindableLayout.ItemsSource="{Binding Choices}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="chat:DialogueChoiceItem">
                        <Border Style="{StaticResource FilterChipStyle}" Margin="0,0,8,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Command}" CommandParameter="{Binding Index}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Label}" Style="{StaticResource FilterChipLabelStyle}" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- 0..10 rating chips -->
            <VerticalStackLayout IsVisible="{Binding IsRatingInput}" Spacing="6">
                <Label Text="{Binding RatingScaleText}" Style="{StaticResource CaptionStyle}" />
                <FlexLayout
                    Wrap="Wrap"
                    JustifyContent="Start"
                    BindableLayout.ItemsSource="{Binding RatingItems}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="chat:DialogueRatingItem">
                            <Border Style="{StaticResource FilterChipStyle}" Margin="0,0,8,8" MinimumWidthRequest="44">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Command}" CommandParameter="{Binding Value}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Value}" Style="{StaticResource FilterChipLabelStyle}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <!-- End of conversation -->
            <ui:ButtonView
                IsVisible="{Binding IsFinished}"
                BodyText="{Binding FinishText}"
                TapCommand="{Binding FinishCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
