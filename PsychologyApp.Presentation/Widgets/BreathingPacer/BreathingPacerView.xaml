<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             x:Class="PsychologyApp.Presentation.Widgets.BreathingPacer.BreathingPacerView">
    <Border Style="{StaticResource BrandCardStyle}" Margin="{StaticResource CardBottomMargin}">
        <VerticalStackLayout Spacing="12">
            <Grid x:Name="CircleHost" HeightRequest="260" WidthRequest="260" HorizontalOptions="Center">
                <Border x:Name="Halo" WidthRequest="220" HeightRequest="220" StrokeThickness="0"
                        HorizontalOptions="Center" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="110" />
                    </Border.StrokeShape>
                </Border>
                <Border x:Name="Circle" WidthRequest="200" HeightRequest="200" StrokeThickness="0"
                        HorizontalOptions="Center" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="100" />
                    </Border.StrokeShape>
                </Border>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label x:Name="PhaseLabel" Style="{StaticResource SectionTitleStyle}" HorizontalTextAlignment="Center" />
                    <Label x:Name="CountLabel" Style="{StaticResource SectionTitleStyle}" FontSize="34" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
            <Label x:Name="CycleLabel" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
            <ui:ButtonView x:Name="ToggleButton" />
        </VerticalStackLayout>
    </Border>
</ContentView>
