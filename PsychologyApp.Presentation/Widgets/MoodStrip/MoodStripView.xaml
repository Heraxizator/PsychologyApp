<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:Class="PsychologyApp.Presentation.Widgets.MoodStrip.MoodStripView"
             x:Name="Root">

    <ContentView.Behaviors>
        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
    </ContentView.Behaviors>

    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Border x:Name="StripBorder" Style="{StaticResource MoodStripStyle}">
                <Border.Triggers>
                    <DataTrigger
                        TargetType="Border"
                        Binding="{Binding UsePlainLayout, Source={RelativeSource Mode=TemplatedParent}}"
                        Value="True">
                        <Setter Property="BackgroundColor" Value="Transparent" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="StrokeThickness" Value="0" />
                        <Setter Property="Shadow" Value="{x:Null}" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{TemplateBinding QuestionText}"
                        Style="{StaticResource CaptionStyle}"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <HorizontalStackLayout
                        x:Name="MoodRow"
                        HorizontalOptions="Center"
                        Spacing="8">
                        <HorizontalStackLayout.Triggers>
                            <DataTrigger
                                TargetType="HorizontalStackLayout"
                                Binding="{Binding UsePlainLayout, Source={RelativeSource Mode=TemplatedParent}}"
                                Value="True">
                                <Setter Property="Spacing" Value="12" />
                            </DataTrigger>
                        </HorizontalStackLayout.Triggers>
                        <Border x:Name="MoodChip1" Style="{StaticResource MoodChipStyle}">
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{TemplateBinding SelectedMoodLevel}"
                                    TargetType="Border"
                                    Value="1">
                                    <Setter Property="Style" Value="{StaticResource MoodChipSelectedStyle}" />
                                </DataTrigger>
                                <DataTrigger
                                    TargetType="Border"
                                    Binding="{Binding UsePlainLayout, Source={RelativeSource Mode=TemplatedParent}}"
                                    Value="True">
                                    <Setter Property="WidthRequest" Value="56" />
                                    <Setter Property="HeightRequest" Value="56" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding RecordMoodCommand}" CommandParameter="1" />
                            </Border.GestureRecognizers>
                            <Label Text="😞" Style="{StaticResource MoodChipEmojiStyle}" FontSize="28" />
                        </Border>
                        <Border x:Name="MoodChip2" Style="{StaticResource MoodChipStyle}">
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{TemplateBinding SelectedMoodLevel}"
                                    TargetType="Border"
                                    Value="2">
                                    <Setter Property="Style" Value="{StaticResource MoodChipSelectedStyle}" />
                                </DataTrigger>
                                <DataTrigger
                                    TargetType="Border"
                                    Binding="{Binding UsePlainLayout, Source={RelativeSource Mode=TemplatedParent}}"
                                    Value="True">
                                    <Setter Property="WidthRequest" Value="56" />
                                    <Setter Property="HeightRequest" Value="56" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding RecordMoodCommand}" CommandParameter="2" />
                            </Border.GestureRecognizers>
                            <Label Text="😕" Style="{StaticResource MoodChipEmojiStyle}" FontSize="28" />
                        </Border>
                        <Border x:Name="MoodChip3" Style="{StaticResource MoodChipStyle}">
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{TemplateBinding SelectedMoodLevel}"
                                    TargetType="Border"
                                    Value="3">
                                    <Setter Property="Style" Value="{StaticResource MoodChipSelectedStyle}" />
                                </DataTrigger>
                                <DataTrigger
                                    TargetType="Border"
                                    Binding="{Binding UsePlainLayout, Source={RelativeSource Mode=TemplatedParent}}"
                                    Value="True">
                                    <Setter Property="WidthRequest" Value="56" />
                                    <Setter Property="HeightRequest" Value="56" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding RecordMoodCommand}" CommandParameter="3" />
                            </Border.GestureRecognizers>
                            <Label Text="😐" Style="{StaticResource MoodChipEmojiStyle}" FontSize="28" />
                        </Border>
                        <Border x:Name="MoodChip4" Style="{StaticResource MoodChipStyle}">
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{TemplateBinding SelectedMoodLevel}"
                                    TargetType="Border"
                                    Value="4">
                                    <Setter Property="Style" Value="{StaticResource MoodChipSelectedStyle}" />
                                </DataTrigger>
                                <DataTrigger
                                    TargetType="Border"
                                    Binding="{Binding UsePlainLayout, Source={RelativeSource Mode=TemplatedParent}}"
                                    Value="True">
                                    <Setter Property="WidthRequest" Value="56" />
                                    <Setter Property="HeightRequest" Value="56" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding RecordMoodCommand}" CommandParameter="4" />
                            </Border.GestureRecognizers>
                            <Label Text="🙂" Style="{StaticResource MoodChipEmojiStyle}" FontSize="28" />
                        </Border>
                        <Border x:Name="MoodChip5" Style="{StaticResource MoodChipStyle}">
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{TemplateBinding SelectedMoodLevel}"
                                    TargetType="Border"
                                    Value="5">
                                    <Setter Property="Style" Value="{StaticResource MoodChipSelectedStyle}" />
                                </DataTrigger>
                                <DataTrigger
                                    TargetType="Border"
                                    Binding="{Binding UsePlainLayout, Source={RelativeSource Mode=TemplatedParent}}"
                                    Value="True">
                                    <Setter Property="WidthRequest" Value="56" />
                                    <Setter Property="HeightRequest" Value="56" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{TemplateBinding RecordMoodCommand}" CommandParameter="5" />
                            </Border.GestureRecognizers>
                            <Label Text="😊" Style="{StaticResource MoodChipEmojiStyle}" FontSize="28" />
                        </Border>
                    </HorizontalStackLayout>
                    <Label
                        IsVisible="{TemplateBinding HasTodayMood}"
                        Text="{TemplateBinding TodayMoodDisplay}"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource EmphasisBodyStyle}"
                        TextColor="{DynamicResource Primary}"
                        FontFamily="{StaticResource SemiBoldFontFamily}" />
                    <Label
                        IsVisible="{TemplateBinding HasMoodHistorySummary}"
                        Text="{TemplateBinding MoodHistorySummary}"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource CaptionStyle}"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                        MaxLines="2"
                        LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>

</ContentView>
