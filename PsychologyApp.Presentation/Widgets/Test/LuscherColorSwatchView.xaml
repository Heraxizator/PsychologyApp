<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsychologyApp.Presentation.Widgets.Test.LuscherColorSwatchView"
             x:Name="Root">

    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
        <Border
            WidthRequest="{Binding SwatchSize, Source={x:Reference Root}}"
            HeightRequest="{Binding SwatchSize, Source={x:Reference Root}}"
            HorizontalOptions="Center"
            Stroke="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}"
            StrokeThickness="2"
            BackgroundColor="{Binding SwatchColor, Source={x:Reference Root}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="999" />
            </Border.StrokeShape>
        </Border>
        <Label
            IsVisible="{Binding ShowName, Source={x:Reference Root}}"
            Text="{Binding ColorName, Source={x:Reference Root}}"
            Style="{StaticResource CaptionStyle}"
            HorizontalTextAlignment="Center"
            MaxLines="2"
            LineBreakMode="TailTruncation" />
    </VerticalStackLayout>

</ContentView>
