<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="PsychologyApp.Presentation.Widgets.Test.TestFlowMetaStripView"
             x:Name="Root">

    <HorizontalStackLayout
        Spacing="8"
        IsVisible="{Binding HasMeta, Source={x:Reference Root}}">
        <Border
            IsVisible="{Binding HasDuration, Source={x:Reference Root}}"
            Style="{StaticResource MetaPillStyle}">
            <HorizontalStackLayout Spacing="6">
                <Label
                    Text="{mi:Material Icon=Schedule}"
                    Style="{StaticResource MetaIconStyle}" />
                <Label
                    Text="{Binding DurationText, Source={x:Reference Root}}"
                    Style="{StaticResource CaptionStyle}"
                    TextColor="{DynamicResource Primary}"
                    FontFamily="{StaticResource MediumFontFamily}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <Border
            IsVisible="{Binding HasQuestionCount, Source={x:Reference Root}}"
            Style="{StaticResource MetaPillStyle}">
            <HorizontalStackLayout Spacing="6">
                <Label
                    Text="{mi:Material Icon=Quiz}"
                    Style="{StaticResource MetaIconStyle}" />
                <Label
                    Text="{Binding QuestionCountText, Source={x:Reference Root}}"
                    Style="{StaticResource CaptionStyle}"
                    TextColor="{DynamicResource Primary}"
                    FontFamily="{StaticResource MediumFontFamily}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>
    </HorizontalStackLayout>

</ContentView>
