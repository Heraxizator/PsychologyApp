<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:testUi="clr-namespace:PsychologyApp.Presentation.Widgets.Test"
             x:Class="PsychologyApp.Presentation.Widgets.Test.LuscherColorResultView"
             x:Name="Root">

    <Border Style="{StaticResource TestFlatCardStyle}" Margin="0">
        <Border.Behaviors>
            <behaviors:ListItemRevealBehavior />
        </Border.Behaviors>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border
                Grid.Column="0"
                Style="{StaticResource HeroAccentBarStyle}"
                BackgroundColor="{Binding Color, Source={x:Reference Root}}" />

            <VerticalStackLayout Grid.Column="1" Spacing="4">
                <Label
                    Text="{Binding RoleLabel, Source={x:Reference Root}}"
                    Style="{StaticResource CaptionStyle}"
                    TextColor="{DynamicResource Primary}" />
                <Label
                    Text="{Binding ColorName, Source={x:Reference Root}}"
                    Style="{StaticResource SectionTitleStyle}" />
                <Label
                    Text="{Binding ResultText, Source={x:Reference Root}}"
                    Style="{StaticResource BodyStyle}"
                    HorizontalTextAlignment="Justify"
                    LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <testUi:LuscherColorSwatchView
                Grid.Column="2"
                SwatchColor="{Binding Color, Source={x:Reference Root}}"
                ColorName="{Binding ColorName, Source={x:Reference Root}}"
                SwatchSize="{StaticResource LuscherSwatchSizeSmall}"
                ShowName="False"
                VerticalOptions="Center" />
        </Grid>
    </Border>

</ContentView>
