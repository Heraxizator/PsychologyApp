<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             x:Class="PsychologyApp.Presentation.Widgets.Test.LuscherColorPassRowView"
             x:Name="Root">

    <VerticalStackLayout Spacing="{StaticResource CompactSpacing}">
        <VerticalStackLayout.Behaviors>
            <behaviors:ListItemRevealBehavior />
        </VerticalStackLayout.Behaviors>
        <Label
            Text="{Binding PassTitle, Source={x:Reference Root}}"
            Style="{StaticResource CaptionStyle}"
            TextColor="{DynamicResource Primary}" />
        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout
                x:Name="PassRow"
                Spacing="6"
                VerticalOptions="Center" />
        </ScrollView>
    </VerticalStackLayout>

</ContentView>
