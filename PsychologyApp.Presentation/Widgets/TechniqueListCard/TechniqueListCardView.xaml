<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:self="clr-namespace:PsychologyApp.Presentation.Widgets.TechniqueListCard"
             x:Class="PsychologyApp.Presentation.Widgets.TechniqueListCard.TechniqueListCardView">

    <ContentView.Behaviors>
        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
    </ContentView.Behaviors>

    <ContentView.ControlTemplate>
        <ControlTemplate x:DataType="self:TechniqueListCardView">
            <Border
                Style="{StaticResource TechniqueListCardStyle}"
                IsVisible="{TemplateBinding Active}"
                SemanticProperties.Description="{TemplateBinding Title}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{TemplateBinding TapCommand}" />
                </Border.GestureRecognizers>
                <!-- Same layout as the Android card (TechniqueCardHandler): every line of text in one column with one left edge. -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border
                        Grid.Column="0"
                        VerticalOptions="Start"
                        Style="{StaticResource LargeIconTileStyle}"
                        BackgroundColor="{TemplateBinding TileColor}">
                        <Grid x:Name="IconHost">
                            <ui:MaterialIconView
                                IsVisible="{TemplateBinding HasIcon}"
                                WidthRequest="28"
                                HeightRequest="28"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                IconName="{TemplateBinding IconName}"
                                IconColor="{TemplateBinding IconTint}" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            Text="{TemplateBinding Title}"
                            Style="{StaticResource ListRowTitleStyle}"
                            MaxLines="2"
                            LineBreakMode="TailTruncation" />
                        <Label
                            Text="{TemplateBinding Subtitle}"
                            Style="{StaticResource CaptionStyle}"
                            MaxLines="1"
                            LineBreakMode="TailTruncation" />
                        <Label
                            Margin="0,2,0,0"
                            Text="{TemplateBinding MetaText}"
                            Style="{StaticResource CaptionStyle}"
                            MaxLines="1"
                            LineBreakMode="TailTruncation" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label
                                Grid.Column="0"
                                Text="{TemplateBinding Date}"
                                Style="{StaticResource CaptionStyle}"
                                MaxLines="1"
                                LineBreakMode="TailTruncation" />
                            <Label
                                Grid.Column="1"
                                IsVisible="{TemplateBinding HasAuthor}"
                                Text="{TemplateBinding Author}"
                                Style="{StaticResource CaptionStyle}"
                                HorizontalTextAlignment="End"
                                MaxLines="1"
                                LineBreakMode="TailTruncation" />
                        </Grid>
                    </VerticalStackLayout>
                    <Label
                        Grid.Column="2"
                        VerticalOptions="Center"
                        TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextSecondaryDark}}"
                        Text="{mi:Material Icon=KeyboardArrowRight}" />
                </Grid>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>

</ContentView>
