<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:self="clr-namespace:PsychologyApp.Presentation.Widgets.TechniqueListCard"
             x:Class="PsychologyApp.Presentation.Widgets.TechniqueListCard.TechniqueListCardView">

    <ContentView.Behaviors>
        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
    </ContentView.Behaviors>

    <ContentView.ControlTemplate>
        <ControlTemplate x:DataType="self:TechniqueListCardView">
            <Border
                Style="{StaticResource TechniqueListCardStyle}"
                IsVisible="{TemplateBinding Active}"
                SemanticProperties.Description="{TemplateBinding Title}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{TemplateBinding TapCommand}" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border
                            Grid.Column="0"
                            Style="{StaticResource LargeIconTileStyle}"
                            BackgroundColor="{TemplateBinding TileColor}">
                            <Grid x:Name="IconHost">
                                <ui:MaterialIconView
                                    IsVisible="{TemplateBinding HasIcon}"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    IconName="{TemplateBinding IconName}"
                                    IconColor="{TemplateBinding IconTint}" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="6"
                            VerticalOptions="Center">
                            <Label
                                Text="{TemplateBinding Title}"
                                Style="{StaticResource ListRowTitleStyle}"
                                MaxLines="2"
                                LineBreakMode="TailTruncation" />
                            <Label
                                Text="{TemplateBinding Subtitle}"
                                Style="{StaticResource CaptionStyle}"
                                MaxLines="2"
                                LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Label
                            Grid.Column="2"
                            VerticalOptions="Center"
                            TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextSecondaryDark}}"
                            Text="{mi:Material Icon=KeyboardArrowRight}" />
                    </Grid>
                    <!-- The group and the length on a line of their own (they used to share it with the date and were cut off), the date and the author under them. -->
                    <Label
                        Grid.Row="1"
                        Text="{TemplateBinding MetaText}"
                        Style="{StaticResource CaptionStyle}"
                        FontFamily="{StaticResource SemiBoldFontFamily}"
                        TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}"
                        MaxLines="1"
                        LineBreakMode="TailTruncation" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label
                            Grid.Column="0"
                            Text="{TemplateBinding Date}"
                            Style="{StaticResource CaptionStyle}"
                            MaxLines="1"
                            LineBreakMode="TailTruncation" />
                        <Label
                            Grid.Column="1"
                            IsVisible="{TemplateBinding HasAuthor}"
                            Text="{TemplateBinding Author}"
                            Style="{StaticResource CaptionStyle}"
                            HorizontalTextAlignment="End"
                            MaxLines="1"
                            LineBreakMode="TailTruncation" />
                    </Grid>
                </Grid>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>

</ContentView>
