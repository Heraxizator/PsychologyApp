<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:self="clr-namespace:PsychologyApp.Presentation.Widgets.MusicListCard"
             x:DataType="self:MusicListCardView"
             x:Class="PsychologyApp.Presentation.Widgets.MusicListCard.MusicListCardView"
             x:Name="Root">

    <ContentView.Behaviors>
        <behaviors:PressFeedbackBehavior AttachToAllTapTargets="True" />
    </ContentView.Behaviors>

    <Border x:Name="CardBorder" Style="{StaticResource MusicListRowStyle}">
        <Border.Triggers>
            <DataTrigger
                Binding="{Binding IsActive, Source={x:Reference Root}}"
                TargetType="Border"
                Value="True">
                <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}" />
            </DataTrigger>
        </Border.Triggers>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding TapCommand, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <!-- A round play button on the tint, as a player shows one; the square white tile read as an empty box. -->
            <Border
                Grid.Column="0"
                WidthRequest="44"
                HeightRequest="44"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Border.Triggers>
                    <DataTrigger
                        Binding="{Binding IsActive, Source={x:Reference Root}}"
                        TargetType="Border"
                        Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid>
                    <ui:MaterialIconView
                        IconName="PlayArrow"
                        IconSize="24"
                        IconColor="{DynamicResource Primary}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <ui:MaterialIconView.Triggers>
                            <DataTrigger
                                Binding="{Binding IsActive, Source={x:Reference Root}}"
                                TargetType="ui:MaterialIconView"
                                Value="True">
                                <Setter Property="IconColor" Value="White" />
                            </DataTrigger>
                            <MultiTrigger TargetType="ui:MaterialIconView">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding IsActive, Source={x:Reference Root}}" Value="True" />
                                    <BindingCondition Binding="{Binding IsPlayingThis, Source={x:Reference Root}}" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="IsVisible" Value="False" />
                            </MultiTrigger>
                        </ui:MaterialIconView.Triggers>
                    </ui:MaterialIconView>
                    <ui:MaterialIconView
                        IconName="Pause"
                        IconSize="24"
                        IconColor="White"
                        IsVisible="False"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <ui:MaterialIconView.Triggers>
                            <MultiTrigger TargetType="ui:MaterialIconView">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding IsActive, Source={x:Reference Root}}" Value="True" />
                                    <BindingCondition Binding="{Binding IsPlayingThis, Source={x:Reference Root}}" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="IsVisible" Value="True" />
                            </MultiTrigger>
                        </ui:MaterialIconView.Triggers>
                    </ui:MaterialIconView>
                </Grid>
            </Border>
            <VerticalStackLayout
                Grid.Column="1"
                Spacing="4"
                VerticalOptions="Center">
                <Label
                    Text="{Binding Title, Source={x:Reference Root}}"
                    Style="{StaticResource ListRowTitleStyle}"
                    MaxLines="2"
                    LineBreakMode="TailTruncation" />
                <Label
                    Text="{Binding Subtitle, Source={x:Reference Root}}"
                    Style="{StaticResource CaptionStyle}"
                    MaxLines="1"
                    LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <!-- Only a prayer not on the phone yet is marked, in words: a grey tick on every row ("saved for offline") said nothing
                 without a label, and the exception is the one worth knowing before going offline. -->
            <Border
                Grid.Column="2"
                IsVisible="{Binding NeedsInternet, Source={x:Reference Root}}"
                Padding="8,4"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{AppThemeBinding Light={DynamicResource PrimaryTint}, Dark={DynamicResource PrimaryTintDark}}"
                VerticalOptions="Center">
                <Label
                    Text="{Binding NeedsInternetText, Source={x:Reference Root}}"
                    Style="{StaticResource CaptionStyle}"
                    TextColor="{AppThemeBinding Light={DynamicResource PrimaryTextLight}, Dark={DynamicResource PrimaryTextDark}}" />
            </Border>
        </Grid>
    </Border>
</ContentView>
