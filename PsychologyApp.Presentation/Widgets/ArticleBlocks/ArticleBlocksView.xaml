<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:PsychologyApp.Presentation.Shared.UI.Components"
             xmlns:behaviors="clr-namespace:PsychologyApp.Presentation.Shared.Common.Behaviors"
             xmlns:breath="clr-namespace:PsychologyApp.Presentation.Widgets.BreathingPacer"
             xmlns:common="clr-namespace:PsychologyApp.Presentation.Common;assembly=PsychologyApp.Presentation.Core"
             xmlns:local="clr-namespace:PsychologyApp.Presentation.Widgets.ArticleBlocks"
             x:Class="PsychologyApp.Presentation.Widgets.ArticleBlocks.ArticleBlocksView"
             x:Name="Root">

    <ContentView.Resources>
        <!-- The base look sits in the style: a local value would win over the triggers that mark a ticked or answered option. -->
        <Style x:Key="ChoiceBorderStyle" TargetType="Border" x:DataType="local:ArticleChoiceItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" />
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsChecked}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}" />
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding IsWrong}" Value="True">
                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DangerSurface}, Dark={StaticResource DangerSurfaceDark}}" />
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding IsRight}" Value="True">
                    <Setter Property="StrokeThickness" Value="2" />
                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ParagraphTemplate" x:DataType="local:ArticleBlockItem">
            <Label Text="{Binding Text}" Style="{StaticResource BodyStyle}" LineHeight="1.25" />
        </DataTemplate>
        <DataTemplate x:Key="HeadingTemplate" x:DataType="local:ArticleBlockItem">
            <Label Text="{Binding Text}" Style="{StaticResource SectionTitleStyle}" Margin="0,10,0,0" />
        </DataTemplate>
        <DataTemplate x:Key="BulletsTemplate" x:DataType="local:ArticleBlockItem">
            <Label Text="{Binding BulletsText}" Style="{StaticResource BodyStyle}" LineHeight="1.3" />
        </DataTemplate>
        <DataTemplate x:Key="WarningTemplate" x:DataType="local:ArticleBlockItem">
            <!-- "When to see a doctor" must not blend in with the rest. -->
            <Border Margin="0,12,0,0" Padding="14,12" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                    BackgroundColor="{AppThemeBinding Light={StaticResource DangerSurface}, Dark={StaticResource DangerSurfaceDark}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <ui:MaterialIconView IconName="LocalHospital" IconSize="22" VerticalOptions="Center"
                                         IconColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                    <Label Grid.Column="1" Text="{Binding Text}" Style="{StaticResource SectionTitleStyle}" VerticalOptions="Center" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="LinkTemplate" x:DataType="local:ArticleBlockItem">
            <Border Style="{StaticResource BrandCardStyle}" Margin="0" Padding="14,10"
                    SemanticProperties.Description="{Binding Text}">
                <Border.Behaviors>
                    <behaviors:PressFeedbackBehavior />
                </Border.Behaviors>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LinkCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <ui:MaterialIconView IconName="{Binding LinkIcon}" IconSize="24" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                        <Label Text="{Binding LinkCaption}" Style="{StaticResource CaptionStyle}" />
                        <Label Text="{Binding Text}" Style="{StaticResource BodyStyle}" FontFamily="{StaticResource MediumFontFamily}" />
                    </VerticalStackLayout>
                    <ui:MaterialIconView Grid.Column="2" IconName="ChevronRight" IconSize="22" VerticalOptions="Center" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ChecklistTemplate" x:DataType="local:ArticleBlockItem">
            <!-- "Do I recognise this?": tick statements, the verdict follows the count. -->
            <Border Style="{StaticResource BrandCardStyle}" Margin="0,6,0,0" Padding="14,12">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <ui:MaterialIconView IconName="Checklist" IconSize="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Text}" Style="{StaticResource SectionTitleStyle}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{x:Static common:AppStrings.ArticleChecklistHint}" Style="{StaticResource CaptionStyle}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Choices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ArticleChoiceItem">
                                <Border Style="{StaticResource ChoiceBorderStyle}" SemanticProperties.Description="{Binding Text}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TapCommand}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <ui:MaterialIconView IconName="{Binding Icon}" IconSize="22" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Text}" Style="{StaticResource BodyStyle}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding Feedback}" IsVisible="{Binding HasFeedback}" Style="{StaticResource BodyStyle}"
                           FontFamily="{StaticResource MediumFontFamily}" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="QuizTemplate" x:DataType="local:ArticleBlockItem">
            <!-- A question about what was just read: one answer, then the right one and why. -->
            <Border Style="{StaticResource BrandCardStyle}" Margin="0,6,0,0" Padding="14,12">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <ui:MaterialIconView IconName="Quiz" IconSize="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{x:Static common:AppStrings.ArticleQuizCaption}" Style="{StaticResource CaptionStyle}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding Text}" Style="{StaticResource SectionTitleStyle}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Choices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ArticleChoiceItem">
                                <Border Style="{StaticResource ChoiceBorderStyle}" SemanticProperties.Description="{Binding Text}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TapCommand}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <ui:MaterialIconView IconName="{Binding Icon}" IconSize="22" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Text}" Style="{StaticResource BodyStyle}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding Feedback}" IsVisible="{Binding HasFeedback}" Style="{StaticResource BodyStyle}" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CycleTemplate" x:DataType="local:ArticleBlockItem">
            <!-- A vicious circle: the steps in order, then back to the first. Written out, so large text and screen readers work. -->
            <Border Style="{StaticResource BrandCardStyle}" Margin="0,6,0,0" Padding="14,12"
                    SemanticProperties.Description="{Binding CycleDescription}">
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,6">
                        <ui:MaterialIconView IconName="Loop" IconSize="22" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Text}" Style="{StaticResource SectionTitleStyle}" VerticalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Choices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ArticleChoiceItem">
                                <VerticalStackLayout Spacing="2">
                                    <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                                        <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 14" VerticalOptions="Center"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}">
                                            <Label Text="{Binding Index}" Style="{StaticResource CaptionStyle}" FontFamily="{StaticResource SemiBoldFontFamily}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding Text}" Style="{StaticResource BodyStyle}" VerticalOptions="Center" />
                                    </Grid>
                                    <ui:MaterialIconView IconName="ArrowDownward" IconSize="16" HorizontalOptions="Start" Margin="6,0,0,0" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                        <ui:MaterialIconView IconName="Autorenew" IconSize="22" HorizontalOptions="Center" />
                        <Label Grid.Column="1" Text="{x:Static common:AppStrings.ArticleCycleLoop}" Style="{StaticResource CaptionStyle}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="BreatheTemplate" x:DataType="local:ArticleBlockItem">
            <!-- Trying the breath right in the text, without leaving for another screen. -->
            <VerticalStackLayout Spacing="6" Margin="0,6,0,0">
                <Label Text="{Binding Text}" Style="{StaticResource SectionTitleStyle}" />
                <breath:BreathingPacerView IsCalm="True" />
            </VerticalStackLayout>
        </DataTemplate>
        <DataTemplate x:Key="TaskTemplate" x:DataType="local:ArticleBlockItem">
            <!-- A course day's task stands apart from the reading. -->
            <Border Style="{StaticResource BrandCardStyle}" Margin="0,6,0,0" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <ui:MaterialIconView IconName="TaskAlt" IconSize="24" VerticalOptions="Start" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{x:Static common:AppStrings.ArticleTaskCaption}" Style="{StaticResource CaptionStyle}" />
                        <Label Text="{Binding Text}" Style="{StaticResource BodyStyle}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>
        <local:ArticleBlockTemplateSelector x:Key="BlockSelector" Paragraph="{StaticResource ParagraphTemplate}" Heading="{StaticResource HeadingTemplate}" Bullets="{StaticResource BulletsTemplate}" Warning="{StaticResource WarningTemplate}" Link="{StaticResource LinkTemplate}" Checklist="{StaticResource ChecklistTemplate}" Quiz="{StaticResource QuizTemplate}" Cycle="{StaticResource CycleTemplate}" Breathe="{StaticResource BreatheTemplate}" Task="{StaticResource TaskTemplate}" />
    </ContentView.Resources>

    <!-- An article is a run of blocks; each kind has its own template, so a hidden pacer or checklist is never built for a paragraph. -->
    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Blocks, Source={x:Reference Root}}" BindableLayout.ItemTemplateSelector="{StaticResource BlockSelector}" />
</ContentView>
