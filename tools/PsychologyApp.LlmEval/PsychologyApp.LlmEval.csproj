<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PsychologyApp.LlmEval</RootNamespace>
    <!-- Run manually; deliberately not part of PsychologyApp.sln so CI does not restore the native ONNX runtimes. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PsychologyApp.Application\PsychologyApp.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="prompts.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
